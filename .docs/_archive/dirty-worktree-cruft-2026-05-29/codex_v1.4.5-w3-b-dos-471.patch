+            Self::Serialize {
+                signal_type,
+                message,
+            } => write!(
+                f,
+                "workspace signal {signal_type} payload serialization failed: {message}"
+            ),
+            Self::Emit {
+                signal_type,
+                message,
+            } => write!(
