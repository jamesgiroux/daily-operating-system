   301	impl<'tx> TxCtx<'tx> {
   302	    /// Mutation gate inside a transaction. Returns the same
   303	    /// `WriteBlockedByMode` error as `ServiceContext::check_mutation_allowed`
   304	    /// when the parent context was non-Live.
   305	    pub fn check_mutation_allowed(&self) -> Result<(), ServiceError> {
   306	        if self.mode.permits_writes() {
   307	            Ok(())
   308	        } else {
   309	            Err(ServiceError::WriteBlockedByMode(self.mode))
   310	        }
   311	    }
   312	}
