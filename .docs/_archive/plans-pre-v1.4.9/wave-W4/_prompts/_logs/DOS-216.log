    19	#[test]
    20	fn provider_selection_is_single_source_for_tier() {
    21	    // Each provider type, asked for the same tier twice, returns identical
    22	    // model/kind. This is the "single source" invariant — selection is a
    23	    // pure function of (provider, tier), not stateful or randomized.
    24	    let pty = PtyClaudeCode::new(
    25	        Arc::new(AiModelConfig::default()),
    26	        std::env::temp_dir(),
    27	        AiUsageContext::new("test", "selection_invariant"),
    28	    );
    29	    assert_eq!(
    30	        pty.current_model(ModelTier::Synthesis),
    31	        pty.current_model(ModelTier::Synthesis),
    32	    );
    33	    assert_eq!(pty.provider_kind(), ProviderKind::ClaudeCode);
    34	
    35	    let glean = GleanIntelligenceProvider::new("https://example.invalid/glean");
    36	    assert_eq!(
    37	        glean.current_model(ModelTier::Synthesis),
    38	        glean.current_model(ModelTier::Synthesis),
    39	    );
    40	    assert_eq!(glean.provider_kind(), ProviderKind::Other("glean"));
    41	
    42	    let replay = ReplayProvider::new(std::collections::HashMap::new());
    43	    assert_eq!(
    44	        replay.current_model(ModelTier::Synthesis),
    45	        replay.current_model(ModelTier::Synthesis),
    46	    );
    47	    assert_eq!(replay.provider_kind(), ProviderKind::Other("replay"));
    48	}
