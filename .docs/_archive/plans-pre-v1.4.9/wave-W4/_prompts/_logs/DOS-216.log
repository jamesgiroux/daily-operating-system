   286	/// Transaction-scoped context exposed to `with_transaction_*` closures.
   287	///
   288	/// Same `mode`/`clock`/`rng` as the parent `ServiceContext` plus a
   289	/// transaction-bound DB cursor (lands in the DB-plumbing phase).
   290	/// **Has no `external` clients and no `IntelligenceProvider`** per
   291	/// ADR-0104's ban on external/LLM calls inside transactions.
   292	pub struct TxCtx<'tx> {
   293	    pub mode: ExecutionMode,
   294	    pub clock: &'tx dyn Clock,
   295	    pub rng: &'tx dyn SeededRng,
   296	    /// Signal emissions made inside the transaction stage here and
   297	    /// flush after commit; rollback discards.
   298	    pub(in crate::services) staged_signals: Mutex<Vec<StagedSignal>>,
   299	}
