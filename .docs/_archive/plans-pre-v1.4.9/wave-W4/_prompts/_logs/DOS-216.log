     1	//! DOS-259 (W2-B) integration test: provider selection is single-source per tier.
     2	//!
     3	//! Asserts the structural invariant that a tier resolves to exactly one
     4	//! production provider implementation when configured. This guards against
     5	//! drift where multiple call sites construct different provider instances
     6	//! for the same tier and end up using divergent timeouts/usage contexts.
     7	
     8	use std::sync::Arc;
     9	
    10	use dailyos_lib::intelligence::glean_provider::GleanIntelligenceProvider;
    11	use dailyos_lib::intelligence::provider::{
    12	    Completion, FingerprintMetadata, IntelligenceProvider, ModelName, ModelTier, ProviderKind,
    13	    ReplayProvider,
    14	};
    15	use dailyos_lib::intelligence::pty_provider::PtyClaudeCode;
    16	use dailyos_lib::pty::AiUsageContext;
    17	use dailyos_lib::types::AiModelConfig;
