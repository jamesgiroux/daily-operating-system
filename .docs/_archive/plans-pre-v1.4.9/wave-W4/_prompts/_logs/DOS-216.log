   259	/// Per-call service execution context.
   260	///
   261	/// `mode`, `clock`, `rng`, `external` are public read capabilities
   262	/// (ability code may read them). `tx` is `pub(in crate::services)` —
   263	/// service implementation code reads it; ability-facing code does not.
   264	///
   265	/// **Phase contract:** this initial substrate ships the mode/clock/rng
   266	/// seams + `check_mutation_allowed()` gate. The DB / signals / intel-queue
   267	/// handles + `with_transaction_async` primitive land in subsequent phases
   268	/// alongside the per-service mutator migration. Until then, services
   269	/// continue to take their existing `&ActionDb` arguments and pass a
   270	/// `&ServiceContext` as the new first parameter for the gate + clock/rng.
   271	pub struct ServiceContext<'a> {
   272	    pub mode: ExecutionMode,
   273	    pub clock: &'a dyn Clock,
   274	    pub rng: &'a dyn SeededRng,
   275	    pub external: &'a ExternalClients,
   276	    pub(in crate::services) tx: Option<TxHandle>,
