   352	                            .map_err(|e| e.to_string())
   353	                    })
   354	                    .await;
   355	                match result {
   356	                    Ok(n) if n > 0 => log::info!(
   357	                        "reclassify_meeting_types_from_attendees: re-labelled {n} meetings"
   358	                    ),
   359	                    Ok(_) => {}
   360	                    Err(e) => log::warn!("reclassify_meeting_types_from_attendees failed: {e}"),

 succeeded in 0ms:
