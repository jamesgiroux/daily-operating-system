   620	// Main
   621	// =============================================================================
   622	
   623	/// Temporarily redirect stdout (fd 1) to stderr for the duration of `f`.
   624	///
   625	/// The MCP server communicates over stdio. Any writes to stdout before rmcp
   626	/// takes over the channel corrupt the JSON-RPC stream. Native libraries
   627	/// (ONNX Runtime, fastembed) may write to stdout during initialisation, so
   628	/// we redirect stdout → stderr for that window only.
   629	fn with_stdout_suppressed<F: FnOnce() -> R, R>(f: F) -> R {
   630	    unsafe {
   631	        let saved = libc::dup(libc::STDOUT_FILENO);
   632	        libc::dup2(libc::STDERR_FILENO, libc::STDOUT_FILENO);
   633	        let result = f();
   634	        libc::dup2(saved, libc::STDOUT_FILENO);
   635	        libc::close(saved);
   636	        result
   637	    }
   638	}
   639	
   640	#[tokio::main]
   641	async fn main() -> anyhow::Result<()> {
   642	    let config =
   643	        load_config().map_err(|e| anyhow::anyhow!("Failed to load DailyOS config: {e}"))?;
   644	
   645	    let db =
   646	        ActionDb::open_readonly().map_err(|e| anyhow::anyhow!("Failed to open database: {e}"))?;
   647	
   648	    // Initialize embedding model synchronously — MCP server starts before any
   649	    // tool calls so this won't block user interaction.
   650	    // stdout is redirected to stderr during init to prevent native library
   651	    // output (ONNX Runtime, fastembed) from corrupting the MCP JSON-RPC stream.
   652	    let embedding_model = Arc::new(EmbeddingModel::new());
   653	    with_stdout_suppressed(|| {
   654	        let models_dir = dirs::home_dir()
   655	            .unwrap_or_default()
   656	            .join(".dailyos")
   657	            .join("models");
   658	        if let Err(e) = embedding_model.initialize(models_dir) {
   659	            eprintln!("Embedding model unavailable: {e}");
   660	        }
   661	    });
   662	
   663	    let server = DailyOsMcp::new(db, config, embedding_model);
   664	
   665	    let service = server.serve(rmcp::transport::io::stdio()).await?;
   666	    service.waiting().await?;
   667	
   668	    Ok(())
   669	}

