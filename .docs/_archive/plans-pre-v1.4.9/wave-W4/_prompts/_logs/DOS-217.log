   575	#[allow(clippy::too_many_arguments)]
   576	fn build_entity_result(
   577	    id: &str,
   578	    name: &str,
   579	    entity_type: &str,
   580	    health: Option<&str>,
   581	    status: Option<&str>,
   582	    lifecycle: Option<&str>,
   583	    intelligence_summary: Option<&str>,
   584	    actions: &[dailyos_lib::db::DbAction],
   585	    meetings: &[dailyos_lib::db::DbMeeting],
   586	) -> EntityResult {
   587	    EntityResult {
   588	        id: id.to_string(),
   589	        name: name.to_string(),
   590	        entity_type: entity_type.to_string(),
   591	        health: health.map(str::to_string),
   592	        status: status.map(str::to_string),
   593	        lifecycle: lifecycle.map(str::to_string),
   594	        intelligence_summary: intelligence_summary.map(str::to_string),
   595	        open_actions: actions
   596	            .iter()
   597	            .filter(|a| matches!(a.status.as_str(), "backlog" | "unstarted" | "started"))
   598	            .take(10)
   599	            .map(|a| ActionSummary {
   600	                id: a.id.clone(),
   601	                title: a.title.clone(),
   602	                priority: a.priority.to_string(),
   603	                due_date: a.due_date.clone(),
   604	            })
   605	            .collect(),
   606	        upcoming_meetings: meetings
   607	            .iter()
   608	            .take(5)
   609	            .map(|m| MeetingSummary {
   610	                id: m.id.clone(),
   611	                title: m.title.clone(),
   612	                start_time: m.start_time.clone(),
   613	                meeting_type: m.meeting_type.clone(),
   614	            })
   615	            .collect(),
   616	    }
   617	}
