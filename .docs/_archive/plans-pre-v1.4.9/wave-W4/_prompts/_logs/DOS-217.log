   490	                            false // Already locked
   491	                        } else {
   492	                            ls.last_activity.elapsed()
   493	                                >= std::time::Duration::from_secs(u64::from(timeout_mins) * 60)
   494	                        }
   495	                    };
   496	
   497	                    if should_lock {
   498	                        {
   499	                            let mut ls = lock_state_timer.lock_state.lock();
   500	                            ls.is_locked = true;
   501	                        }
   502	                        let _ = lock_handle_timer.emit("app-locked", ());
   503	                        log::info!("App locked after {} minutes idle", timeout_mins);
   504	                    }
   505	                }
   506	            });
