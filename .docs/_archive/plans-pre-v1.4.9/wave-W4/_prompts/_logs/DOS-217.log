   841	/// Attempt to unlock the app via system authentication (Touch ID / password).
   842	#[tauri::command]
   843	pub async fn unlock_app(
   844	    state: State<'_, Arc<AppState>>,
   845	    app: tauri::AppHandle,
   846	) -> Result<(), String> {
   847	    // I610: All lock state operations go through a single mutex acquisition.
   848	    // Check cooldown: 30s after 3 consecutive failures
   849	    {
   850	        let mut ls = state.lock_state.lock();
   851	        if ls.failed_unlock_count >= 3 {
   852	            if let Some(last) = ls.last_failed_unlock {
   853	                if last.elapsed().as_secs() < 30 {
   854	                    let remaining = 30 - last.elapsed().as_secs();
   855	                    return Err(format!(
   856	                        "Too many failed attempts. Try again in {} seconds.",
   857	                        remaining
   858	                    ));
   859	                }
   860	            }
   861	            // Cooldown expired, reset counter
   862	            ls.failed_unlock_count = 0;
   863	        }
   864	    }
   865	
   866	    // Attempt system authentication (Touch ID / password)
   867	    match attempt_system_auth().await {
   868	        Ok(true) => {
   869	            {
   870	                let mut ls = state.lock_state.lock();
   871	                ls.is_locked = false;
   872	                ls.failed_unlock_count = 0;
   873	                ls.last_activity = std::time::Instant::now();
   874	            }
   875	            {
   876	                let mut audit = state.audit_log.lock();
   877	                let _ = audit.append("security", "app_unlock_succeeded", serde_json::json!({}));
   878	            }
   879	            let _ = app.emit("app-unlocked", ());
   880	            Ok(())
   881	        }
   882	        Ok(false) => {
   883	            let new_count;
   884	            {
   885	                let mut ls = state.lock_state.lock();
   886	                ls.failed_unlock_count += 1;
   887	                new_count = ls.failed_unlock_count;
   888	                ls.last_failed_unlock = Some(std::time::Instant::now());
   889	            }
   890	            {
   891	                let mut audit = state.audit_log.lock();
   892	                let _ = audit.append(
   893	                    "security",
   894	                    "app_unlock_failed",
   895	                    serde_json::json!({"consecutive_failures": new_count}),
   896	                );
   897	            }
   898	            if new_count >= 3 {
   899	                Err(
   900	                    "Authentication failed. Too many attempts — please wait 30 seconds."
   901	                        .to_string(),
   902	                )
   903	            } else {
   904	                Err("Authentication failed.".to_string())
   905	            }
   906	        }
   907	        Err(e) => Err(format!("Authentication error: {}", e)),
   908	    }
   909	}
