     2	set -euo pipefail
     3	
     4	ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
     5	
     6	HOTSPOT_FILES=(
     7	  "src-tauri/src/commands.rs"
     8	  "src-tauri/src/intel_queue.rs"
     9	  "src-tauri/src/processor/transcript.rs"
    10	  "src-tauri/src/workflow/deliver.rs"
    11	  "src-tauri/src/workflow/reconcile.rs"
    12	  "src-tauri/src/hygiene/mod.rs"
    13	)
    14	
    15	while IFS= read -r command_file; do
    16	  HOTSPOT_FILES+=("${command_file#$ROOT_DIR/}")
    17	done < <(find "$ROOT_DIR/src-tauri/src/commands" -maxdepth 1 -name '*.rs' | sort)
    18	
    19	METHOD_PATTERN='(db|tx)\.(upsert|insert|update|delete|remove|reset|create|append|bump|link|unlink|merge|archive|record|mark|clear|copy|set_)[A-Za-z0-9_]*'
    20	RAW_SQL_PATTERN='conn_ref\(\)\.execute'
    21	
    22	violations=0
    23	
    24	for rel_path in "${HOTSPOT_FILES[@]}"; do
    25	  file_path="$ROOT_DIR/$rel_path"
    26	  if [[ ! -f "$file_path" ]]; then
    27	    echo "Missing hotspot file: $rel_path"
    28	    violations=1
    29	    continue
    30	  fi
    31	
    32	  cutoff_line="$(grep -n '#\[cfg(test)\]' "$file_path" | head -n1 | cut -d: -f1 || true)"
    33	  if [[ -z "$cutoff_line" ]]; then
    34	    cutoff_line=999999
    35	  fi
    36	
    37	  awk \
    38	    -v cutoff="$cutoff_line" \
    39	    -v method="$METHOD_PATTERN" \
    40	    -v raw="$RAW_SQL_PATTERN" \
    41	    -v rel="$rel_path" '
    42	      NR >= cutoff { exit }
    43	      {
    44	        line = $0
    45	        trimmed = line
    46	        sub(/^[[:space:]]+/, "", trimmed)
    47	
    48	        if (index(line, "DIRECT_DB_ALLOWED:") > 0) {
    49	          allow_next = 1
    50	          next
    51	        }
    52	
    53	        if (trimmed ~ /^\/\//) {
    54	          next
    55	        }
    56	
    57	        if (allow_next) {
    58	          if (trimmed != "") {
    59	            allow_next = 0
    60	          }
    61	          next
    62	        }
    63	
    64	        if (line ~ method) {
    65	          printf("Service-layer boundary violation: %s:%d\n", rel, NR)
    66	          print "  direct mutation method call detected"
    67	          violations = 1
    68	          next
    69	        }
    70	
    71	        if (line ~ raw) {
    72	          printf("Service-layer boundary violation: %s:%d\n", rel, NR)
    73	          print "  raw SQL write via conn_ref().execute(...) detected"
    74	          violations = 1
    75	        }
    76	      }
    77	      END {
    78	        if (violations) {
    79	          exit 10
    80	        }
    81	      }
    82	    ' "$file_path"
    83	  status=$?
    84	  if [[ "$status" -eq 10 ]]; then
    85	    violations=1
    86	    continue
    87	  fi
    88	  if [[ "$status" -ne 0 ]]; then
    89	    exit "$status"
    90	  fi
    91	done
    92	
