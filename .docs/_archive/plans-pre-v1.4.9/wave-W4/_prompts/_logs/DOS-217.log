    44	impl Default for HygieneBudget {
    45	    fn default() -> Self {
    46	        Self::unlimited()
    47	    }
    48	}
    49	
    50	impl HygieneBudget {
    51	    pub fn new(limit: u32) -> Self {
    52	        Self {
    53	            daily_ai_calls: AtomicU32::new(0),
    54	            daily_limit: limit,
    55	            last_reset: Mutex::new(chrono::Local::now().format("%Y-%m-%d").to_string()),
    56	        }
    57	    }
    58	
    59	    /// Create an effectively unlimited hygiene budget.
    60	    ///
    61	    /// DOS-279: The call-count hygiene budget is replaced by the token budget
    62	    /// enforced at PTY call time. Hygiene uses `unlimited()` so it can enqueue
    63	    /// freely; the PTY gate handles actual enforcement.
    64	    pub fn unlimited() -> Self {
    65	        Self::new(u32::MAX)
    66	    }
    67	
    68	    /// Check if budget allows another AI call, resetting counter if day changed.
    69	    pub fn try_consume(&self) -> bool {
    70	        let today = chrono::Local::now().format("%Y-%m-%d").to_string();
    71	        {
    72	            let mut last = self.last_reset.lock();
    73	            if *last != today {
    74	                self.daily_ai_calls
    75	                    .store(0, std::sync::atomic::Ordering::Relaxed);
    76	                *last = today;
    77	            }
    78	        }
    79	
    80	        let current = self
    81	            .daily_ai_calls
    82	            .fetch_add(1, std::sync::atomic::Ordering::Relaxed);
    83	        if current < self.daily_limit {
    84	            true
    85	        } else {
    86	            // Undo the increment
    87	            self.daily_ai_calls
    88	                .fetch_sub(1, std::sync::atomic::Ordering::Relaxed);
    89	            false
    90	        }
    91	    }
    92	
    93	    /// Current count of AI calls used today.
    94	    pub fn used_today(&self) -> u32 {
    95	        self.daily_ai_calls
    96	            .load(std::sync::atomic::Ordering::Relaxed)
    97	    }
    98	}
