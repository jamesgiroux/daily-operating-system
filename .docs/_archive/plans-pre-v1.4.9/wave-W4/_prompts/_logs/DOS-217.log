   139	    hidden_attendees: Vec<String>,
   140	}
   141	
   142	fn parse_user_agenda_layer(value: Option<&str>) -> UserAgendaLayer {
   143	    let Some(json) = value else {
   144	        return UserAgendaLayer::default();
   145	    };
   146	    // Try rich format first
   147	    if let Ok(layer) = serde_json::from_str::<UserAgendaLayer>(json) {
   148	        return layer;
   149	    }
   150	    // Fall back to legacy Vec<String>
   151	    if let Ok(items) = serde_json::from_str::<Vec<String>>(json) {
   152	        return UserAgendaLayer {
   153	            items,
   154	            ..Default::default()
   155	        };
   156	    }
   157	    UserAgendaLayer::default()
   158	}
