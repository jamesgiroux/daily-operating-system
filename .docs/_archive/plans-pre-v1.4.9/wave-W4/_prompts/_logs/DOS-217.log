   522	
   523	/// Resolve a user-provided entity identifier (name or ID) to an entity ID.
   524	/// Tries exact ID match first, then fuzzy name match across accounts, projects, people.
   525	fn resolve_entity_id(db: &ActionDb, query: &str) -> Option<String> {
   526	    let query_lower = query.to_lowercase();
   527	
   528	    // Check accounts
   529	    if let Ok(accounts) = db.get_all_accounts() {
   530	        for acct in &accounts {
   531	            if acct.id == query {
   532	                return Some(acct.id.clone());
   533	            }
   534	            if acct.name.to_lowercase().contains(&query_lower) {
   535	                return Some(acct.id.clone());
   536	            }
   537	        }
   538	    }
   539	
   540	    // Check projects
   541	    if let Ok(projects) = db.get_all_projects() {
   542	        for proj in &projects {
   543	            if proj.id == query {
   544	                return Some(proj.id.clone());
   545	            }
   546	            if proj.name.to_lowercase().contains(&query_lower) {
   547	                return Some(proj.id.clone());
   548	            }
   549	        }
   550	    }
   551	
   552	    // Check people
   553	    if let Ok(people) = db.get_people(None) {
   554	        for person in &people {
   555	            if person.id == query {
   556	                return Some(person.id.clone());
   557	            }
   558	            if person.name.to_lowercase().contains(&query_lower)
   559	                || person.email.to_lowercase().contains(&query_lower)
   560	            {
   561	                return Some(person.id.clone());
   562	            }
   563	        }
   564	    }
   565	
   566	    None
   567	}
