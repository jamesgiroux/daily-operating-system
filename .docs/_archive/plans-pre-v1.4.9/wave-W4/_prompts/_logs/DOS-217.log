    47	        input_json,
    48	        InvocationContext {
    49	            actor: Actor::User,
    50	            mode: ExecutionMode::Live,
    51	            dry_run: dry_run.unwrap_or(false),
    52	            confirmation,
    53	        },
    54	    ).await
    55	}
