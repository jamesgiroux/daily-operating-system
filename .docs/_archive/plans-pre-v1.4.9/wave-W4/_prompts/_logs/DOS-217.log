   944	/// Attempt system-level authentication using macOS LocalAuthentication framework.
   945	/// Calls LAContext.evaluatePolicy directly via objc2 FFI so the Touch ID dialog
   946	/// shows "DailyOS" as the requesting app (not "osascript").
   947	#[cfg(target_os = "macos")]
   948	async fn attempt_system_auth() -> Result<bool, String> {
   949	    let (tx, rx) = tokio::sync::oneshot::channel::<Result<bool, String>>();
   950	
   951	    std::thread::spawn(move || {
   952	        use block2::RcBlock;
   953	        use objc2::runtime::Bool;
   954	        use objc2_foundation::{NSComparisonResult, NSDate, NSRunLoop, NSString};
   955	        use objc2_local_authentication::{LAContext, LAPolicy};
   956	
   957	        let done = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
   958	
   959	        unsafe {
   960	            let context = LAContext::new();
   961	            let policy = LAPolicy(1); // deviceOwnerAuthentication (biometrics + passcode fallback)
   962	
