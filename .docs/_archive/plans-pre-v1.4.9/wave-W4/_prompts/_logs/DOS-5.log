     1	//! Temporal decay for signal weighting (pure math, no DB).
     2	
     3	use chrono::{DateTime, Utc};
     4	
     5	/// Compute the decayed weight of a signal using exponential half-life decay.
     6	///
     7	/// `base * 2^(-age_days / half_life_days)`
     8	pub fn decayed_weight(base_weight: f64, age_days: f64, half_life_days: f64) -> f64 {
     9	    if half_life_days <= 0.0 || age_days < 0.0 {
    10	        return base_weight;
    11	    }
    12	    base_weight * (2.0_f64).powf(-age_days / half_life_days)
    13	}
    14	
    15	/// Parse an RFC3339/ISO-8601 timestamp and compute fractional days since now.
    16	pub fn age_days_from_now(created_at_iso: &str) -> f64 {
    17	    let parsed = match DateTime::parse_from_rfc3339(created_at_iso) {
    18	        Ok(dt) => dt.with_timezone(&Utc),
    19	        Err(_) => {
