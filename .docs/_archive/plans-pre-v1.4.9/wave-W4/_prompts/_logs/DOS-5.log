     1	//! Weighted Bayesian signal fusion (ADR-0080).
     2	//!
     3	//! Computes per-signal weights using source tier + temporal decay + learned
     4	//! reliability, then fuses using weighted log-odds combination.
     5	
     6	use crate::db::ActionDb;
     7	
     8	use super::bus::{self, SignalEvent};
     9	use super::decay;
    10	
    11	/// Compute the effective weight for a signal event.
    12	///
    13	/// `weight = decayed_weight(tier_weight, age, half_life) * learned_reliability`
    14	pub fn compute_signal_weight(db: &ActionDb, event: &SignalEvent) -> f64 {
    15	    let tier_weight = bus::source_base_weight(&event.source);
    16	    let age_days = decay::age_days_from_now(&event.created_at);
    17	    let decayed = decay::decayed_weight(tier_weight, age_days, event.decay_half_life_days as f64);
    18	    let reliability =
    19	        bus::get_learned_reliability(db, &event.source, &event.entity_type, &event.signal_type);
    20	    decayed * reliability
    21	}
    22	
    23	/// Fuse multiple (confidence, weight) pairs using weighted log-odds combination.
    24	///
    25	/// For each signal:
    26	///   log_odds_contribution = weight * ln(confidence / (1 - confidence))
    27	/// Sum all contributions, then convert back:
    28	///   combined = 1 / (1 + exp(-sum))
    29	///
    30	/// This replaces the unweighted version in entity_resolver for weighted fusion.
    31	pub fn fuse_confidence(signals: &[(f64, f64)]) -> f64 {
    32	    if signals.is_empty() {
    33	        return 0.5;
    34	    }
    35	
    36	    if signals.len() == 1 {
    37	        return signals[0].0;
    38	    }
    39	
    40	    let mut weighted_log_odds_sum: f64 = 0.0;
    41	
    42	    for &(confidence, weight) in signals {
    43	        let p = confidence.clamp(0.01, 0.99);
    44	        let log_odds = (p / (1.0 - p)).ln();
    45	        weighted_log_odds_sum += weight * log_odds;
    46	    }
    47	
    48	    let combined = 1.0 / (1.0 + (-weighted_log_odds_sum).exp());
    49	    combined.clamp(0.0, 0.999)
    50	}
    51	
