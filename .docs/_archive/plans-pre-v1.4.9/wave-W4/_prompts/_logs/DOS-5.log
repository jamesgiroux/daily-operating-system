    42	    pub decay_half_life_days: i32,
    43	    pub created_at: String,
    44	    pub superseded_by: Option<String>,
    45	    /// Context tag for the signal source (e.g. "inbound_email", "outbound_email").
    46	    #[serde(skip_serializing_if = "Option::is_none")]
    47	    pub source_context: Option<String>,
