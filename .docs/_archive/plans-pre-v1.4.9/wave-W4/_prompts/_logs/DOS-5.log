   805	    /// DOS-204: Peer-cohort renewal benchmark via a dedicated Glean chat pass.
   806	    ///
   807	    /// Builds the validated peer-benchmark prompt from `account_name`,
   808	    /// `industry_descriptor`, and `size_descriptor`, calls Glean with citation
   809	    /// metadata (so the cell can render the "Drawn from N source(s)" footer),
   810	    /// and parses the response into a `PeerBenchmark`.
   811	    ///
   812	    /// The parser is a lowercase prefix match against the response text:
   813	    /// - `above peers` → `PeerBenchmarkBand::Above`
   814	    /// - `in line peers` / `in-line peers` → `PeerBenchmarkBand::At`
   815	    /// - `below peers` → `PeerBenchmarkBand::Below`
   816	    /// - `no comparable` (or anything else) → `PeerBenchmarkBand::Unknown`,
   817	    ///   which the frontend cell renders as `null` (collapses the column).
   818	    ///
   819	    /// On unknown band, returns `Err` so the caller can skip the write
   820	    /// (no point persisting a record the UI will hide). On chat failure
   821	    /// or timeout, also returns `Err` — the caller swallows it as a
   822	    /// silent fallback (parity with `enrich_leading_signals_*`).
   823	    pub async fn enrich_peer_benchmark(
   824	        &self,
   825	        account_name: &str,
   826	    ) -> Result<super::io::PeerBenchmark, String> {
   827	        let prompt = format!(
   828	            "For the customer **{account_name}**, what is a reasonable peer benchmark for \
   829	their renewal trajectory and account health on WordPress VIP? Use whatever you know about \
   830	their tier, ARR, package, industry, and size to identify comparable peer customers.\n\n\
   831	Consider:\n\n\
   832	1. Renewal rates and retention norms for VIP customers at similar tier and ACV\n\
   833	2. Typical engagement indicators (meeting cadence, ticket volume, expansion patterns) \
   834	for healthy renewals at this tier\n\
   835	3. Whether there are recent or historical signals from comparable {account_name}-like \
   836	accounts that suggest typical health patterns\n\n\
   837	Return a short assessment in the form: \"**[Above / In line / Below] peers**\" followed \
   838	by **one sentence** explaining the comparison with specific numbers where possible. \
   839	Cite sources."
   840	        );
   841	
   842	        let client = GleanMcpClient::new(&self.endpoint);
   843	
   844	        let response = tokio::time::timeout(
   845	            Duration::from_secs(240),
   846	            client.chat_with_citations(&prompt, None),
   847	        )
   848	        .await
   849	        .map_err(|_| format!("Glean peer-benchmark chat timed out for {}", account_name))?
   850	        .map_err(|e| format!("Glean peer-benchmark chat failed for {}: {}", account_name, e))?;
   851	
   852	        log::info!(
   853	            "[DOS-204] Glean peer-benchmark response for {} — {} chars, {} sources",
   854	            account_name,
   855	            response.text.len(),
   856	            response.source_count
   857	        );
   858	
   859	        let (band, narrative) = parse_peer_benchmark_response(&response.text)?;
   860	
   861	        Ok(super::io::PeerBenchmark {
   862	            band,
   863	            narrative,
   864	            source_count: response.source_count,
   865	        })
   866	    }
   867	}
   868	
   869	/// DOS-259 (W2-B): `IntelligenceProvider` trait impl over `GleanIntelligenceProvider`.
   870	///

