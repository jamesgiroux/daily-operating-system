     1	//! DOS-287: Cross-entity contamination validator.
     2	//!
     3	//! Second-line defense against Glean/PTY enrichment writing content about a
     4	//! different customer into the target account's intelligence record. Runs
     5	//! immediately before persistence: if the generated narrative mentions
     6	//! another account's domain, WP-VIP host, or company name (and the target's
     7	//! own name is not also present), the write is rejected and a signal is
     8	//! emitted so the frontend can toast.
     9	//!
    10	//! Heuristics (evaluated in order; first hit wins per unique token):
    11	//!   1. Foreign domain match — any `account_domains.domain` for a non-target
    12	//!      non-archived account, whole-word.
    13	//!   2. Foreign vip-*.com host — matches `vip[0-9]*-[a-z]+\.com` and
    14	//!      `vip[0-9]+\.[a-z]+\.com`. If the host is not in the target's known
    15	//!      domains, it's foreign.
    16	//!   3. Foreign company name — any `accounts.name` for a non-target
    17	//!      non-archived account, normalized, whole-word, ≥4 chars, excluding
    18	//!      `STOPLIST` terms. Suppressed when the target's own name also appears
    19	//!      in the text (legitimate comparison).
    20	//!
    21	//! Matching is case-insensitive; bounded by non-alphanumeric characters.
    22	//!
    23	//! TODO(DOS-282): Regression fixtures for vip2-msd.com / Merck cross-bleed
    24	//! should live with that ticket.
    25	
    26	use crate::db::ActionDb;
    27	
    28	/// A single cross-entity contamination finding.
    29	#[derive(Debug, Clone, PartialEq, Eq, serde::Serialize)]
    30	#[serde(rename_all = "camelCase")]
    31	pub struct ContaminationHit {
    32	    /// The foreign token we matched, verbatim (lowercased).
    33	    pub foreign_token: String,
    34	    /// What kind of token it is.
    35	    pub kind: ContaminationKind,
    36	    /// The account this token belongs to, if we can identify one. `None`
    37	    /// means we detected the pattern (e.g. a WP-VIP host) but the host
    38	    /// itself isn't registered under any known account.
    39	    pub source_account_id: Option<String>,
    40	}
    41	
    42	#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize)]
    43	#[serde(rename_all = "snake_case")]
    44	pub enum ContaminationKind {
    45	    Domain,
    46	    InfrastructureId,
    47	    CompanyName,
    48	}
    49	
    50	/// Stopwords that overlap with common account names but are not meaningful
    51	/// for linking — intentionally a superset of
    52	/// `services::entity_linking::rules::p5_title_evidence::STOPLIST`. Kept local
    53	/// so this module has no circular-dependency risk and can be unit-tested in
    54	/// isolation.
    55	const STOPLIST: &[&str] = &[
    56	    "open", "pilot", "plan", "monday", "notion", "mercury", "ramp",
    57	    "handshake", "bridge", "flow", "base", "peak", "note", "space",
    58	    "link", "next", "sync", "ready", "clear", "front", "core", "post",
    59	    "meet", "call", "talk", "chat", "dash", "pulse", "track", "task",
    60	    "work", "team", "loop", "zoom", "slack", "linear", "email",
    61	    "meeting", "customer", "account", "company", "product", "group",
    62	];
    63	
    64	/// Scan `text` for references to accounts OTHER than `target_account_id`.
    65	/// Returns every foreign token found. Empty Vec means clean.
    66	///
    67	/// Caller decides whether to reject the write based on the result.
    68	pub fn detect_cross_entity_contamination(
    69	    text: &str,
    70	    target_account_id: &str,
    71	    target_domains: &[String],
    72	    _target_stakeholder_emails: &[String],
    73	    db: &ActionDb,
    74	) -> Vec<ContaminationHit> {
    75	    if text.trim().is_empty() {
    76	        return Vec::new();
    77	    }
    78	
    79	    let text_lower = text.to_lowercase();
    80	    let target_domains_lower: Vec<String> =
    81	        target_domains.iter().map(|d| d.to_lowercase()).collect();
    82	
    83	    // Fetch non-archived accounts with their domains. On DB error, fail open
    84	    // (return no hits) rather than block writes on a read failure.
    85	    let accounts = match db.get_all_accounts_with_domains(false) {
    86	        Ok(a) => a,
    87	        Err(e) => {
    88	            log::warn!(
    89	                "[DOS-287] contamination scan: failed to load accounts: {e}; failing open"
    90	            );
    91	            return Vec::new();
    92	        }
    93	    };
    94	
    95	    // Target name (for legitimate-comparison suppression on CompanyName hits).
    96	    let target_name_lower = accounts
