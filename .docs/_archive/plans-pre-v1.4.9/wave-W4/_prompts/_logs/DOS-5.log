    58	        // Two strong signals (0.8 conf, 1.0 weight) and (0.9 conf, 0.9 weight)
    59	        let result = fuse_confidence(&[(0.8, 1.0), (0.9, 0.9)]);
    60	        assert!(
    61	            result > 0.95,
    62	            "weighted compounding should exceed 0.95, got {}",
