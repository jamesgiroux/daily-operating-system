    49	
    50	// ---------------------------------------------------------------------------
    51	// Source tier weights (ADR-0080)
    52	// ---------------------------------------------------------------------------
    53	
    54	/// Base reliability weight for a signal source.
    55	///
    56	/// Tier 1 (highest): user corrections, transcript evidence
    57	/// Tier 2: attendee patterns, email threads
    58	/// Tier 3: third-party enrichment (Clay, Gravatar)
    59	/// Tier 4 (lowest): keyword heuristics, AI inference
    60	pub fn source_base_weight(source: &str) -> f64 {
    61	    match source {
    62	        "user_correction" | "user_feedback" | "explicit" => 1.0,
    63	        "user_curation" => 0.9, // I530: curation signals — no weight penalty but high trust
    64	        "transcript" | "notes" => 0.9,
    65	        "attendee" | "attendee_vote" | "email_thread" | "junction" => 0.8,
    66	        "group_pattern" => 0.75,
    67	        "proactive" => 0.7,
    68	        // I535/ADR-0100: Tiered Glean source confidence
    69	        "glean_crm" | "glean_salesforce" => 0.9, // Salesforce — system of record
    70	        "glean_zendesk" | "glean_support" => 0.85, // Zendesk — ticket data is factual
    71	        "glean_gong" => 0.8,                     // Gong — recorded calls, AI summaries synthesized
    72	        "glean" | "glean_search" | "glean_org" => 0.7,
    73	        "glean_chat" | "glean_synthesis" => 0.7, // Glean AI synthesis — same tier as PTY
    74	        "glean_slack" => 0.5,                    // Slack — context signal, noisy
    75	        "clay" | "gravatar" => 0.6,
    76	        "keyword" | "keyword_fuzzy" | "heuristic" | "embedding" => 0.4,
    77	        _ => 0.5,
    78	    }
    79	}
    80	
    81	/// Default half-life in days for a signal source.
    82	pub fn default_half_life(source: &str) -> i32 {
    83	    match source {
    84	        "user_correction" | "user_feedback" | "explicit" => 365,
    85	        "user_curation" => 180, // I530: curation decays faster than corrections
    86	        "transcript" | "notes" => 60,
    87	        "attendee" | "attendee_vote" | "junction" => 30,
    88	        "group_pattern" => 60,
    89	        "proactive" => 3,
    90	        // I535/ADR-0100: Tiered Glean half-lives
    91	        "glean_crm" | "glean_salesforce" => 90, // CRM data refreshes on enrichment cycle
    92	        "glean_zendesk" | "glean_support" => 30, // Support health is dynamic
    93	        "glean_gong" => 60,                     // Call patterns are stable-ish
    94	        "glean" | "glean_search" | "glean_org" => 60,
    95	        "glean_chat" | "glean_synthesis" => 60, // AI synthesis stable
    96	        "glean_slack" => 14,                    // Slack context decays fast
    97	        "clay" | "gravatar" => 90,
    98	        "keyword" | "keyword_fuzzy" | "heuristic" | "embedding" => 7,
    99	        _ => 30,
   100	    }
   101	}
