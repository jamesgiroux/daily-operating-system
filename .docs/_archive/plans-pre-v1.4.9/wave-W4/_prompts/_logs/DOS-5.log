   346	/// Extract all WordPress VIP host patterns from `text` (assumed lowercase).
   347	/// Matches `vip-foo.com`, `vip2-msd.com`, and `vip5.something.com` — the host
   348	/// naming used by WordPress VIP's customer infrastructure.
   349	fn extract_vip_hosts(text: &str) -> Vec<String> {
   350	    let mut out: Vec<String> = Vec::new();
   351	    let bytes = text.as_bytes();
   352	    let mut i = 0;
   353	    while i + 4 <= bytes.len() {
   354	        if &bytes[i..i + 3] == b"vip" {
   355	            // Require word boundary on the left.
   356	            if i > 0 && bytes[i - 1].is_ascii_alphanumeric() {
   357	                i += 1;
   358	                continue;
   359	            }
   360	            // Walk forward consuming [a-z0-9.\-] until we hit ".com" or a
   361	            // non-host character. We want the full token including dots.
   362	            let mut j = i + 3;
   363	            while j < bytes.len() {
   364	                let c = bytes[j];
   365	                if c.is_ascii_alphanumeric() || c == b'-' || c == b'.' {
   366	                    j += 1;
   367	                } else {
   368	                    break;
   369	                }
   370	            }
   371	            let candidate = &text[i..j];
   372	            // Accept only if it actually ends in a TLD-shaped suffix like
   373	            // ".com" — we don't want to match bare "vip5" tokens.
   374	            if candidate.ends_with(".com") && candidate.len() > 4 && candidate.contains('-')
   375	                || candidate.ends_with(".com") && candidate.matches('.').count() >= 2
   376	            {
   377	                // Strip any trailing dot just in case.
   378	                let s = candidate.trim_end_matches('.').to_string();
   379	                out.push(s);
   380	            }

