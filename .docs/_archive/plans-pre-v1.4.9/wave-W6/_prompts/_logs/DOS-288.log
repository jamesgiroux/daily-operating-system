  1557	
  1558	        let mut fields_with_hits: Vec<FieldContamination> = Vec::new();
  1559	        for (field, text) in &field_inputs {
  1560	            let hits = crate::intelligence::contamination::detect_cross_entity_contamination(
  1561	                text,
  1562	                &acct.id,
  1563	                &target_domains,
  1564	                &[],
  1565	                db,
  1566	            );
  1567	            if !hits.is_empty() {
