  1537	            })
  1538	            .unwrap_or_default();
  1539	
  1540	        // Collect the (field_name, text) tuples for this account.
  1541	        let mut field_inputs: Vec<(&'static str, String)> = Vec::new();
  1542	
  1543	        if let Ok(Some(intel)) = db.get_entity_intelligence(&acct.id) {
  1544	            if let Some(ref ea) = intel.executive_assessment {
  1545	                field_inputs.push(("executive_assessment", ea.clone()));
  1546	            }
  1547	        }
  1548	        if let Some(ref co) = acct.company_overview {
  1549	            field_inputs.push(("company_overview", co.clone()));
  1550	        }
  1551	        if let Some(ref sp) = acct.strategic_programs {
  1552	            field_inputs.push(("strategic_programs", sp.clone()));
  1553	        }
  1554	        if let Some(ref notes) = acct.notes {
  1555	            field_inputs.push(("notes", notes.clone()));
