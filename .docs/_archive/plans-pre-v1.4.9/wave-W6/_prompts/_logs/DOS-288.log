  1569	                    field: (*field).to_string(),
  1570	                    hits,
  1571	                });
  1572	            }
  1573	        }
  1574	
  1575	        if !fields_with_hits.is_empty() {
  1576	            report.accounts_with_hits += 1;
  1577	
  1578	            // Pull enriched_at from entity_assessment (best-effort).
  1579	            let enriched_at: Option<String> = db
  1580	                .conn_ref()
  1581	                .query_row(
  1582	                    "SELECT enriched_at FROM entity_assessment WHERE entity_id = ?1",
  1583	                    rusqlite::params![&acct.id],
  1584	                    |row| row.get::<_, Option<String>>(0),
  1585	                )
  1586	                .ok()
  1587	                .flatten();
  1588	
  1589	            log::warn!(
  1590	                "[DOS-287 audit] {} ({}) — {} field(s) with contamination: {}",
  1591	                acct.name,
  1592	                acct.id,
  1593	                fields_with_hits.len(),
  1594	                fields_with_hits
  1595	                    .iter()
  1596	                    .map(|f| format!(
  1597	                        "{}={}",
  1598	                        f.field,
