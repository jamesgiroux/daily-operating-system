  1600	                            .iter()
  1601	                            .map(|h| h.foreign_token.as_str())
  1602	                            .collect::<Vec<_>>()
  1603	                            .join(",")
  1604	                    ))
  1605	                    .collect::<Vec<_>>()
  1606	                    .join("; ")
  1607	            );
  1608	
  1609	            report.hits.push(AccountContaminationSummary {
  1610	                account_id: acct.id.clone(),
  1611	                account_name: acct.name.clone(),
  1612	                enriched_at,
  1613	                fields_with_hits,
  1614	            });
  1615	        }
