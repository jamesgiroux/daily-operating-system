    83	    /// reversed orderings produce deterministic update sequences.
    84	    ///
    85	    /// `Multi` and `Global` panic if compared via this method — they are
    86	    /// resolved at a higher level (`bump_for_subject` dispatches).
    87	    fn entity_type_order(&self) -> u8 {
    88	        match self {
    89	            Self::Account { .. } => 0,
    90	            Self::Meeting { .. } => 1,
    91	            Self::Person { .. } => 2,
    92	            Self::Project { .. } => 3,
