  1627	/// DOS-287 Tier 4: Sweep every non-archived account and flag any whose
  1628	/// stored narrative mentions another customer's identifiers.
  1629	///
  1630	/// Scans:
  1631	///   - `entity_assessment.executive_assessment`
  1632	///   - `accounts.company_overview`
  1633	///   - `accounts.strategic_programs`
  1634	///   - `accounts.notes`
  1635	///
  1636	/// Invoke from the devtools console — no UI is wired up intentionally. A
  1637	/// structured log summary is emitted on completion so results are easy to
  1638	/// scan in the terminal.
  1639	#[tauri::command]
  1640	pub async fn devtools_audit_cross_contamination(
  1641	    state: State<'_, Arc<AppState>>,
  1642	) -> Result<CrossContaminationAuditReport, String> {
  1643	    if !cfg!(debug_assertions) {
  1644	        return Err("Dev tools not available in release builds".into());
  1645	    }
  1646	
  1647	    state.db_read(run_cross_contamination_audit).await
  1648	}
