     1	//! DOS-311 W1 close-out: tombstone-resurrection reconcile fixtures.
     2	//!
     3	//! The 3 named fixtures from the live DOS-311 ticket:
     4	//!   - tombstoned-correctly-hidden     → 0 findings (clean)
     5	//!   - tombstoned-with-new-evidence    → 0 findings (newer evidence wins)
     6	//!   - tombstoned-resurrected          → 2 findings (1 dedup_key match + 1 item_hash fallback match)
     7	//!
     8	//! Each test seeds the fixture into an in-memory SQLite DB (test-only
     9	//! scaffolding schema in `dos311_fixtures/schema.sql`) and runs the
    10	//! reconcile SQL from `scripts/reconcile_ghost_resurrection.sql`. The
    11	//! production `intelligence_claims` table + `legacy_projection_state`
    12	//! view ship with DOS-7 (W3); these fixtures use the W1-time scaffolding
    13	//! that mirrors the live ticket's column shapes.
    14	//!
    15	//! When DOS-7 lands the production schema, this test should re-run
    16	//! against that schema (the fixture SQL might need column-name updates;
    17	//! the reconcile SQL is shared).
    18	
    19	use rusqlite::Connection;
    20	use std::path::PathBuf;
    21	
    22	fn project_root() -> PathBuf {
    23	    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("..")
    24	}
    25	
    26	fn fresh_db() -> Connection {
    27	    let conn = Connection::open_in_memory().expect("open in-memory db");
    28	    let schema = std::fs::read_to_string(
    29	        project_root().join("src-tauri/tests/dos311_fixtures/schema.sql"),
    30	    )
    31	    .expect("read schema.sql");
    32	    conn.execute_batch(&schema).expect("apply schema");
    33	    conn
    34	}
    35	
    36	fn load_fixture(conn: &Connection, name: &str) {
    37	    let path = project_root()
    38	        .join("src-tauri/tests/dos311_fixtures")
    39	        .join(format!("{name}.sql"));
    40	    let sql = std::fs::read_to_string(&path)
    41	        .unwrap_or_else(|e| panic!("read fixture {}: {e}", path.display()));
    42	    conn.execute_batch(&sql)
    43	        .unwrap_or_else(|e| panic!("apply fixture {name}: {e}"));
    44	}
    45	
    46	fn run_reconcile(conn: &Connection) -> usize {
    47	    let sql = std::fs::read_to_string(
    48	        project_root().join("scripts/reconcile_ghost_resurrection.sql"),
    49	    )
    50	    .expect("read reconcile_ghost_resurrection.sql");
    51	    let mut stmt = conn.prepare(&sql).expect("prepare reconcile SQL");
    52	    let count = stmt
    53	        .query_map([], |_row| Ok(()))
    54	        .expect("execute reconcile")
    55	        .count();
    56	    count
    57	}
    58	
    59	#[test]
    60	fn dos311_fixture_a_tombstoned_correctly_hidden_zero_findings() {
    61	    let conn = fresh_db();
    62	    load_fixture(&conn, "tombstoned_correctly_hidden");
    63	    let findings = run_reconcile(&conn);
    64	    assert_eq!(
    65	        findings, 0,
    66	        "tombstoned-correctly-hidden must produce 0 reconcile findings"
    67	    );
    68	}
    69	
    70	#[test]
    71	fn dos311_fixture_b_tombstoned_with_new_evidence_zero_findings() {
    72	    let conn = fresh_db();
    73	    load_fixture(&conn, "tombstoned_with_new_evidence");
    74	    let findings = run_reconcile(&conn);
    75	    assert_eq!(
    76	        findings, 0,
    77	        "tombstoned-with-new-evidence must produce 0 reconcile findings \
    78	         (newer sourced_at overrides tombstone.dismissed_at)"
    79	    );
    80	}
    81	
    82	#[test]
    83	fn dos311_fixture_c_tombstoned_resurrected_two_findings() {
    84	    let conn = fresh_db();
    85	    load_fixture(&conn, "tombstoned_resurrected");
    86	    let findings = run_reconcile(&conn);
    87	    // Two findings:
    88	    //   1. claim-3 / dedup-stale-renewal — matched via dedup_key
    89	    //   2. claim-4 / hash-shared-content — matched via item_hash fallback
    90	    //      (the dedup_key shifted; only item_hash still aligns)
    91	    assert_eq!(
    92	        findings, 2,
    93	        "tombstoned-resurrected must produce 2 reconcile findings (1 dedup_key + 1 item_hash fallback)"
    94	    );
    95	}
    96	
    97	#[test]
    98	fn dos311_reconcile_match_path_distinguishes_dedup_vs_hash() {
    99	    // Verify the `match_path` column produced by reconcile correctly
   100	    // distinguishes which match path fired. Operators rely on this for
   101	    // diagnosing data drift.
   102	    let conn = fresh_db();
   103	    load_fixture(&conn, "tombstoned_resurrected");
   104	    let sql = std::fs::read_to_string(
   105	        project_root().join("scripts/reconcile_ghost_resurrection.sql"),
   106	    )
   107	    .expect("read reconcile SQL");
   108	    let mut stmt = conn.prepare(&sql).expect("prepare");
   109	    let mut paths: Vec<String> = stmt
   110	        .query_map([], |row| row.get::<_, String>("match_path"))
   111	        .expect("query")
   112	        .collect::<Result<Vec<_>, _>>()
   113	        .expect("collect");
   114	    paths.sort();
   115	    assert_eq!(
   116	        paths,
   117	        vec!["dedup_key".to_string(), "item_hash".to_string()],
   118	        "match_path column must distinguish dedup_key vs item_hash matches"
   119	    );
   120	}

