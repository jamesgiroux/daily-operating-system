    28	/// A single cross-entity contamination finding.
    29	#[derive(Debug, Clone, PartialEq, Eq, serde::Serialize)]
    30	#[serde(rename_all = "camelCase")]
    31	pub struct ContaminationHit {
    32	    /// The foreign token we matched, verbatim (lowercased).
    33	    pub foreign_token: String,
    34	    /// What kind of token it is.
    35	    pub kind: ContaminationKind,
    36	    /// The account this token belongs to, if we can identify one. `None`
    37	    /// means we detected the pattern (e.g. a WP-VIP host) but the host
    38	    /// itself isn't registered under any known account.
    39	    pub source_account_id: Option<String>,
    40	}
