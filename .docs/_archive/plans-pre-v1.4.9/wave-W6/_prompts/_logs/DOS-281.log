   256	/// Runtime policy for the cross-entity contamination validator.
   257	///
   258	/// Default: `ShadowMode` — detect, log, emit signals, surface a toast,
   259	/// but write the data anyway. The contamination signal is *evidence*
   260	/// for the user (and for downstream trust scoring landing in v1.4.0),
   261	/// not a hard gate that blocks the write. With local-only sources the
   262	/// AI has less context and produces more shapes that look like foreign
   263	/// tokens; gating writes on the detector would silently strand fresh
   264	/// accounts at empty state.
   265	///
   266	/// Operators in paranoid environments can opt into hard rejection by
   267	/// setting `DAILYOS_CONTAMINATION_VALIDATION=strict` (or
   268	/// `=reject`/`=reject-on-hit`). Setting it to `off` disables the scan
   269	/// entirely so no signals fire.
   270	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
   271	pub enum ContaminationValidation {
   272	    /// Run the scan; on hit, emit signals/events and REJECT the write.
   273	    RejectOnHit,
   274	    /// Run the scan; on hit, emit signals/events but ALLOW the write.
   275	    ShadowMode,
   276	    /// Do not run the scan.
   277	    Off,
   278	}
   279	
   280	impl ContaminationValidation {
   281	    /// Read the policy from the `DAILYOS_CONTAMINATION_VALIDATION` env var.
   282	    /// Unknown / unset values produce the default (`ShadowMode`).
   283	    pub fn from_env() -> Self {
   284	        Self::from_env_value(std::env::var("DAILYOS_CONTAMINATION_VALIDATION").ok().as_deref())
   285	    }
   286	
   287	    /// Pure decoder — parses a raw string (or absent) into a policy.
   288	    /// Split out for test purposes so we don't race on process-global env vars.
   289	    pub fn from_env_value(raw: Option<&str>) -> Self {
   290	        match raw.map(|s| s.trim().to_ascii_lowercase()).as_deref() {
   291	            Some("off" | "disabled" | "false" | "0") => Self::Off,
   292	            Some("strict" | "reject" | "reject-on-hit" | "reject_on_hit") => Self::RejectOnHit,
   293	            // Default + explicit shadow values land in ShadowMode.
   294	            _ => Self::ShadowMode,
   295	        }
   296	    }
   297	
   298	    pub fn is_enabled(&self) -> bool {
   299	        !matches!(self, Self::Off)
   300	    }
   301	
   302	    pub fn rejects(&self) -> bool {
   303	        matches!(self, Self::RejectOnHit)
   304	    }
   305	}
   306	
   307	/// Returns true when `token` is exactly one of the target's domains OR a
   308	/// subdomain of one of them. Both inputs expected lowercase already.
   309	///
   310	/// Used by the contamination heuristics so a target's own subdomains
   311	/// (`vip.target.com`, `privacy.target.com`, `www.target.com`) don't get
   312	/// flagged as foreign tokens. DOS-319.
   313	fn is_target_owned(token: &str, target_domains: &[String]) -> bool {
   314	    target_domains.iter().any(|td| {
   315	        if td.is_empty() {
   316	            return false;
   317	        }
   318	        token == td || token.ends_with(&format!(".{td}"))
   319	    })
   320	}
   321	
   322	/// Whole-word substring check — `needle` must be bounded by either
   323	/// string boundaries or non-alphanumeric characters on both sides.
   324	/// Both inputs are expected lowercase already.
   325	fn whole_word_contains(haystack: &str, needle: &str) -> bool {
   326	    if needle.is_empty() || needle.len() > haystack.len() {
   327	        return false;
   328	    }
   329	    let h = haystack.as_bytes();
   330	    let n = needle.as_bytes();
   331	    let mut i = 0;
   332	    while i + n.len() <= h.len() {
   333	        if &h[i..i + n.len()] == n {
   334	            let left_ok = i == 0 || !h[i - 1].is_ascii_alphanumeric();
   335	            let right_idx = i + n.len();
   336	            let right_ok = right_idx == h.len() || !h[right_idx].is_ascii_alphanumeric();
   337	            if left_ok && right_ok {
   338	                return true;
   339	            }
   340	        }

