   227	/// In-memory replay provider for tests + `Evaluate` mode.
   228	///
   229	/// Stores `(hash, completion)` pairs supplied at construction. On
   230	/// `complete()`, hashes the incoming `PromptInput.text` and looks it up;
   231	/// returns `ProviderError::ReplayFixtureMissing` if absent — never falls
   232	/// through to a live path.
   233	pub struct ReplayProvider {
   234	    fixtures: std::collections::HashMap<String, Completion>,
   235	    provider_kind: ProviderKind,
   236	    model_for_tier: std::collections::HashMap<ModelTier, ModelName>,
   237	}
   238	
   239	impl ReplayProvider {
   240	    /// Build a replay provider from a `(hash → completion)` map.
   241	    pub fn new(fixtures: std::collections::HashMap<String, Completion>) -> Self {
   242	        Self {
   243	            fixtures,
   244	            provider_kind: ProviderKind::Other("replay"),
   245	            model_for_tier: std::collections::HashMap::new(),
   246	        }
   247	    }
   248	
   249	    /// Convenience: build a replay provider from `(prompt_text → text)` pairs,
   250	    /// hashing each prompt with `prompt_replay_hash`.
   251	    pub fn from_prompt_pairs<I, P, T>(pairs: I) -> Self
   252	    where
   253	        I: IntoIterator<Item = (P, T)>,
   254	        P: Into<String>,
   255	        T: Into<String>,
   256	    {
   257	        let mut fixtures = std::collections::HashMap::new();
   258	        for (prompt_text, completion_text) in pairs {
   259	            let p = PromptInput::new(prompt_text);
   260	            let key = prompt_replay_hash(&p);
   261	            fixtures.insert(
   262	                key,
   263	                Completion {
   264	                    text: completion_text.into(),
   265	                    fingerprint_metadata: FingerprintMetadata::default(),
   266	                },
   267	            );
   268	        }
   269	        Self::new(fixtures)
   270	    }
   271	
   272	    pub fn with_provider_kind(mut self, kind: ProviderKind) -> Self {
   273	        self.provider_kind = kind;
   274	        self
   275	    }
   276	
   277	    pub fn with_model_for_tier(mut self, tier: ModelTier, model: ModelName) -> Self {
   278	        self.model_for_tier.insert(tier, model);
   279	        self
   280	    }
   281	}
   282	
   283	#[async_trait]
   284	impl IntelligenceProvider for ReplayProvider {
   285	    async fn complete(
   286	        &self,
   287	        prompt: PromptInput,
   288	        _tier: ModelTier,
   289	    ) -> Result<Completion, ProviderError> {
   290	        let key = prompt_replay_hash(&prompt);
   291	        self.fixtures
   292	            .get(&key)
   293	            .cloned()
   294	            .ok_or(ProviderError::ReplayFixtureMissing(key))
   295	    }
   296	
   297	    fn provider_kind(&self) -> ProviderKind {
   298	        self.provider_kind.clone()
   299	    }
   300	
   301	    fn current_model(&self, tier: ModelTier) -> ModelName {
   302	        self.model_for_tier
   303	            .get(&tier)
   304	            .cloned()
   305	            .unwrap_or_else(|| ModelName::new("replay"))
   306	    }
   307	}
