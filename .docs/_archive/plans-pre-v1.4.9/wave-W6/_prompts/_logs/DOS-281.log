    64	/// Scan `text` for references to accounts OTHER than `target_account_id`.
    65	/// Returns every foreign token found. Empty Vec means clean.
    66	///
    67	/// Caller decides whether to reject the write based on the result.
    68	pub fn detect_cross_entity_contamination(
    69	    text: &str,
    70	    target_account_id: &str,
    71	    target_domains: &[String],
    72	    _target_stakeholder_emails: &[String],
    73	    db: &ActionDb,
    74	) -> Vec<ContaminationHit> {
    75	    if text.trim().is_empty() {
    76	        return Vec::new();
    77	    }
    78	
    79	    let text_lower = text.to_lowercase();
    80	    let target_domains_lower: Vec<String> =
    81	        target_domains.iter().map(|d| d.to_lowercase()).collect();
    82	
    83	    // Fetch non-archived accounts with their domains. On DB error, fail open
    84	    // (return no hits) rather than block writes on a read failure.
    85	    let accounts = match db.get_all_accounts_with_domains(false) {
    86	        Ok(a) => a,
    87	        Err(e) => {
    88	            log::warn!(
    89	                "[DOS-287] contamination scan: failed to load accounts: {e}; failing open"
    90	            );
    91	            return Vec::new();
    92	        }
    93	    };
    94	
    95	    // Target name (for legitimate-comparison suppression on CompanyName hits).
    96	    let target_name_lower = accounts
    97	        .iter()
    98	        .find(|(a, _)| a.id == target_account_id)
    99	        .map(|(a, _)| a.name.to_lowercase());
   100	
   101	    let target_name_in_text = target_name_lower
   102	        .as_deref()
   103	        .map(|n| whole_word_contains(&text_lower, n))
   104	        .unwrap_or(false);
   105	
   106	    let mut hits: Vec<ContaminationHit> = Vec::new();
   107	    let mut seen_tokens: std::collections::HashSet<String> = std::collections::HashSet::new();
   108	
   109	    // Heuristic 1 — foreign domain match.
   110	    for (acct, domains) in &accounts {
   111	        if acct.id == target_account_id {
   112	            continue;
   113	        }
   114	        for d in domains {
   115	            let d_lower = d.to_lowercase();
   116	            if d_lower.is_empty() {
   117	                continue;
   118	            }
   119	            if is_target_owned(&d_lower, &target_domains_lower) {
   120	                continue;
   121	            }
   122	            if !seen_tokens.insert(d_lower.clone()) {
   123	                continue;
   124	            }
   125	            if whole_word_contains(&text_lower, &d_lower) {
   126	                hits.push(ContaminationHit {
   127	                    foreign_token: d_lower,
   128	                    kind: ContaminationKind::Domain,
   129	                    source_account_id: Some(acct.id.clone()),
   130	                });
   131	            }
   132	        }
   133	    }
   134	
   135	    // Heuristic 2 — foreign WordPress VIP host pattern.
   136	    // Detect both `vip-*.com` and `vip<digits>-<name>.com` / `vip<digits>.<name>.com`.
   137	    for cap in extract_vip_hosts(&text_lower) {
   138	        if is_target_owned(&cap, &target_domains_lower) {
   139	            continue;
   140	        }
   141	        if !seen_tokens.insert(cap.clone()) {
   142	            continue;
   143	        }
   144	        // Try to attribute to an account if it matches another account's domain.
   145	        let source = accounts
   146	            .iter()
   147	            .find(|(a, ds)| a.id != target_account_id && ds.iter().any(|d| d.to_lowercase() == cap))
   148	            .map(|(a, _)| a.id.clone());
   149	        hits.push(ContaminationHit {
   150	            foreign_token: cap,
   151	            kind: ContaminationKind::InfrastructureId,
   152	            source_account_id: source,
   153	        });
   154	    }
   155	
   156	    // Heuristic 3 — foreign company name.
   157	    // Suppressed when target name also appears (legitimate comparison case).
   158	    if !target_name_in_text {
   159	        for (acct, _domains) in &accounts {
   160	            if acct.id == target_account_id {
   161	                continue;
   162	            }
   163	            let name_lower = acct.name.to_lowercase();
   164	            if name_lower.len() < 4 {
   165	                continue;
   166	            }
   167	            // Skip multi-word names where the significant tokens are all stop
   168	            // words or too short — the whole-name match still needs to pass.
   169	            if STOPLIST.contains(&name_lower.as_str()) {
   170	                continue;
   171	            }
   172	            if !seen_tokens.insert(name_lower.clone()) {
   173	                continue;
   174	            }
   175	            if whole_word_contains(&text_lower, &name_lower) {
   176	                hits.push(ContaminationHit {
   177	                    foreign_token: name_lower,
   178	                    kind: ContaminationKind::CompanyName,
   179	                    source_account_id: Some(acct.id.clone()),
   180	                });
   181	            }
   182	        }
   183	    }
   184	
   185	    hits
   186	}
