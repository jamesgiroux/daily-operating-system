   188	/// Concatenate all narrative prose fields from an `IntelligenceJson` so the
   189	/// contamination scanner has a single text block to examine.
   190	///
   191	/// Includes: `executive_assessment`, `pull_quote`, `current_state` prose,
   192	/// risk/win text, stakeholder assessments, company context description,
   193	/// strategic priority rationale, value delivered statements, commitment
   194	/// descriptions, blocker descriptions, expansion opportunity text.
   195	pub fn collect_narrative_text(intel: &super::io::IntelligenceJson) -> String {
   196	    let mut parts: Vec<String> = Vec::new();
   197	
   198	    if let Some(ref s) = intel.executive_assessment {
   199	        parts.push(s.clone());
   200	    }
   201	    if let Some(ref s) = intel.pull_quote {
   202	        parts.push(s.clone());
   203	    }
   204	    if let Some(ref cs) = intel.current_state {
   205	        parts.extend(cs.working.iter().cloned());
   206	        parts.extend(cs.not_working.iter().cloned());
   207	        parts.extend(cs.unknowns.iter().cloned());
   208	    }
   209	    for r in &intel.risks {
   210	        parts.push(r.text.clone());
   211	    }
   212	    for w in &intel.recent_wins {
   213	        parts.push(w.text.clone());
   214	    }
   215	    for s in &intel.stakeholder_insights {
   216	        if let Some(ref a) = s.assessment {
   217	            parts.push(a.clone());
   218	        }
   219	    }
   220	    if let Some(ref cc) = intel.company_context {
   221	        if let Some(ref d) = cc.description {
   222	            parts.push(d.clone());
   223	        }
   224	        if let Some(ref ac) = cc.additional_context {
   225	            parts.push(ac.clone());
   226	        }
   227	    }
   228	    for p in &intel.strategic_priorities {
   229	        parts.push(p.priority.clone());
   230	        if let Some(ref c) = p.context {
   231	            parts.push(c.clone());
   232	        }
   233	    }
   234	    for v in &intel.value_delivered {
   235	        parts.push(v.statement.clone());
   236	    }
   237	    if let Some(ref commits) = intel.open_commitments {
   238	        for c in commits {
   239	            parts.push(c.description.clone());
   240	        }
   241	    }
   242	    for b in &intel.blockers {
   243	        parts.push(b.description.clone());
   244	    }
   245	    for e in &intel.expansion_signals {
   246	        parts.push(e.opportunity.clone());
   247	    }
   248	    for m in &intel.market_context {
   249	        parts.push(m.title.clone());
   250	        parts.push(m.body.clone());
   251	    }
   252	
   253	    parts.join("\n")
   254	}
