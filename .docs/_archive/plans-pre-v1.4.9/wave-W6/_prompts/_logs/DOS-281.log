    42	impl ActionDb {
    43	    /// Borrow the underlying connection for ad-hoc queries.
    44	    pub fn conn_ref(&self) -> &Connection {
    45	        &self.conn
    46	    }
    47	
    48	    /// Borrow a `Connection` owned elsewhere as an `ActionDb` view.
    49	    ///
    50	    /// `ActionDb` is `repr(transparent)` over `rusqlite::Connection`, so this
    51	    /// view has the same layout and a lifetime tied to the input borrow. The
    52	    /// borrowed view cannot outlive `conn` or be moved into a `'static`
    53	    /// closure, which keeps pooled `.call()` usage type-system bounded.
    54	    pub fn from_conn(conn: &Connection) -> &Self {
    55	        // SAFETY: `ActionDb` is `repr(transparent)` and its only field is
    56	        // `Connection`, so `&Connection` and `&ActionDb` have identical layout.
    57	        unsafe { &*(conn as *const Connection as *const Self) }
    58	    }
    59	
    60	    /// Execute a closure within a SQLite transaction.
    61	    /// Commits on Ok, rolls back on Err.
    62	    pub fn with_transaction<F, T>(&self, f: F) -> Result<T, String>
    63	    where
    64	        F: FnOnce(&Self) -> Result<T, String>,
    65	    {
    66	        // Nested transaction support: if we're already inside a transaction on this
    67	        // connection, execute the closure directly so all writes stay in the
    68	        // caller's transaction boundary.
    69	        if !self.conn.is_autocommit() {
    70	            return f(self);
    71	        }
    72	
    73	        self.conn
    74	            .execute_batch("BEGIN IMMEDIATE")
    75	            .map_err(|e| format!("Failed to begin transaction: {e}"))?;
    76	        match f(self) {
    77	            Ok(val) => {
    78	                self.conn
    79	                    .execute_batch("COMMIT")
    80	                    .map_err(|e| format!("Failed to commit transaction: {e}"))?;
    81	                Ok(val)
    82	            }
    83	            Err(e) => {
    84	                let _ = self.conn.execute_batch("ROLLBACK");
    85	                Err(e)
    86	            }
    87	        }
    88	    }
