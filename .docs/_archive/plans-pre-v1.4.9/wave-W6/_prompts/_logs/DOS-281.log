    92	    let base = db_path.file_name()?.to_str()?;
    93	    let name = backup_path.file_name()?.to_str()?;
    94	    if name == format!("{base}{MANUAL_BACKUP_SUFFIX}") {
    95	        return Some("manual");
    96	    }
    97	    if name.starts_with(&format!("{base}{PRE_MIGRATION_MARKER}")) && name.ends_with(".bak") {
    98	        return Some("pre-migration");
    99	    }
   100	    if name.starts_with(&format!("{base}{PRE_RESTORE_MARKER}")) && name.ends_with(".bak") {
   101	        return Some("restore-point");
   102	    }
   103	    None
   104	}
   105	
   106	fn parse_timestamp_from_name(file_name: &str, marker: &str) -> Option<String> {
   107	    let (_, rest) = file_name.split_once(marker)?;
   108	    let stamp = rest.strip_suffix(".bak")?;
   109	    let ts = chrono::NaiveDateTime::parse_from_str(stamp, "%Y%m%d-%H%M%S").ok()?;
   110	    Some(ts.and_utc().to_rfc3339())
   111	}
   112	
   113	fn backup_created_at(path: &Path, metadata: &fs::Metadata) -> String {
   114	    let name = path
   115	        .file_name()
   116	        .and_then(|f| f.to_str())
   117	        .unwrap_or_default();
   118	    if let Some(ts) = parse_timestamp_from_name(name, PRE_MIGRATION_MARKER) {
   119	        return ts;
   120	    }

