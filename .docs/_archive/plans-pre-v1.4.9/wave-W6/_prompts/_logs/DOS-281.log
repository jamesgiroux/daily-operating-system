    42	#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize)]
    43	#[serde(rename_all = "snake_case")]
    44	pub enum ContaminationKind {
    45	    Domain,
    46	    InfrastructureId,
    47	    CompanyName,
    48	}
    49	
    50	/// Stopwords that overlap with common account names but are not meaningful
    51	/// for linking — intentionally a superset of
    52	/// `services::entity_linking::rules::p5_title_evidence::STOPLIST`. Kept local
    53	/// so this module has no circular-dependency risk and can be unit-tested in
    54	/// isolation.
    55	const STOPLIST: &[&str] = &[
    56	    "open", "pilot", "plan", "monday", "notion", "mercury", "ramp",
    57	    "handshake", "bridge", "flow", "base", "peak", "note", "space",
    58	    "link", "next", "sync", "ready", "clear", "front", "core", "post",
    59	    "meet", "call", "talk", "chat", "dash", "pulse", "track", "task",
    60	    "work", "team", "loop", "zoom", "slack", "linear", "email",
    61	    "meeting", "customer", "account", "company", "product", "group",
    62	];
