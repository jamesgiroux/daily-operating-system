     1	-- DOS: stakeholder-role soft-delete (dismissal tombstone)
     2	--
     3	-- Before this column, the remove-role UX (× on a role pill) ran a hard
     4	-- DELETE on account_stakeholder_roles. With no record of the removal,
     5	-- the next enrichment cycle's intel_queue would re-INSERT the role
     6	-- with data_source='ai' because its existence check returned no row.
     7	-- User intent "I do not want this role on this person" was lost every
     8	-- time AI re-surfaced the role.
     9	--
    10	-- Soft-delete fix: when a user removes a role, we UPDATE
    11	-- data_source='user' AND dismissed_at=now instead of deleting. The
    12	-- row stays in the table as a tombstone; reads filter dismissed_at
    13	-- IS NULL so the UI doesn't see it; the intel_queue existence check
    14	-- returns data_source='user' and skips the re-insert. If the same
    15	-- user later re-adds the role, add_stakeholder_role's ON CONFLICT
    16	-- clause clears dismissed_at and reactivates the row.
    17	
    18	ALTER TABLE account_stakeholder_roles ADD COLUMN dismissed_at TEXT;

