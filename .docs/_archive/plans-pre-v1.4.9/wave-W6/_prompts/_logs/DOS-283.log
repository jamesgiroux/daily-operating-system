     1	-- DOS-311 fixture schema for tombstone-resurrection reconcile tests.
     2	--
     3	-- TEST-ONLY scaffolding. The production `intelligence_claims` table ships
     4	-- with DOS-7 (W3); this file mirrors enough of that schema for the W1
     5	-- reconcile-pass tests to exercise the SQL in `scripts/reconcile_ghost_resurrection.sql`.
     6	--
     7	-- DOS-7 may migrate this schema during W3 (e.g., adding columns,
     8	-- renaming fields). The fixtures are designed to be regenerable from
     9	-- the canonical DOS-7 schema once it lands; until then they encode the
    10	-- shape promised by the live DOS-7 ticket text.
    11	--
    12	-- Columns mirrored from DOS-7 ticket text + ADR-0113:
    13	--   subject_ref       — the claim's subject (stored as JSON string in
    14	--                       fixtures; production may use a different shape)
    15	--   claim_type        — claim type registry key
    16	--   field_path        — the claim's projected field path
    17	--   dedup_key         — canonical dedup key
    18	--   item_hash         — content fingerprint (DOS-311 reconcile fallback)
    19	--   source_asof       — when the source evidence was observed
    20	--   created_at        — claim row creation (also used as tombstone's
    21	--                       dismissed_at for tombstoned-state rows)
    22	--   claim_state       — 'active' | 'tombstoned' | 'superseded'
    23	--   superseded_at     — if non-null, the row is superseded
    24	--
    25	-- The companion `legacy_projection_state` view materializes the legacy
    26	-- pre-DOS-7 projection shape (entity_intelligence JSON, intelligence.json
    27	-- file content, accounts.* narrative columns). For test purposes we
    28	-- fixture it as a simple table.
    29	
    30	CREATE TABLE IF NOT EXISTS intelligence_claims (
    31	    claim_id      TEXT PRIMARY KEY,
    32	    subject_ref   TEXT NOT NULL,
    33	    claim_type    TEXT NOT NULL,
    34	    field_path    TEXT NOT NULL,
    35	    dedup_key     TEXT,
    36	    item_hash     TEXT,
    37	    source_asof   TEXT,
    38	    created_at    TEXT NOT NULL,
    39	    claim_state   TEXT NOT NULL CHECK (claim_state IN ('active', 'tombstoned', 'superseded')),
    40	    superseded_at TEXT
    41	);
    42	
