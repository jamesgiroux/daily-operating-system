 succeeded in 437ms:
     1	-- DOS-321: Collapse duplicate commitment-typed actions and rewire bridge rows.
     2	--
     3	-- Background: the AI emits the same commitment text under different
     4	-- commitment_id values (one per source — Gong call, meeting transcript,
     5	-- Glean enrichment, CRM update, etc.). The bridge dedupes on
     6	-- commitment_id, so each source produced a fresh action row. Real
     7	-- production data on Globex showed 109 commitment rows collapsing
     8	-- to 52 unique titles (52% duplication, growing every refresh).
     9	--
    10	-- This migration runs once at startup. It is safe to run on any DB:
    11	-- if no duplicates exist, all statements are no-ops.
    12	--
    13	-- Strategy:
    14	--   1. Pick a canonical action per (entity, normalized_title) group:
    15	--      prefer user-accepted rows (status='unstarted' or 'started')
    16	--      over backlog rows; tie-break by oldest created_at.
    17	--   2. Rewire any ai_commitment_bridge rows pointing at a non-canonical
    18	--      duplicate to the canonical action_id.
    19	--   3. Delete the non-canonical action rows.
    20	--
    21	-- Forward-going dedup is enforced at the application layer in
    22	-- `services::commitment_bridge::sync_ai_commitments` via
    23	-- `find_existing_open_commitment_by_title`.
    24	
    25	BEGIN;
    26	
    27	-- Build the canonical-id table for each duplicate group. The CTE picks
    28	-- the row with the highest "user-state weight" first (started > unstarted >
    29	-- backlog) so accepted commitments are never replaced by backlog dupes.
    30	CREATE TEMP TABLE _dos321_canonical AS
    31	SELECT
    32	    canonical_id,
    33	    coalesce(account_id, project_id) AS entity_id,
    34	    norm_title
    35	FROM (
    36	    SELECT
    37	        a.id AS canonical_id,
    38	        a.account_id,
    39	        a.project_id,
    40	        lower(trim(a.title)) AS norm_title,
    41	        ROW_NUMBER() OVER (
    42	            PARTITION BY
    43	                coalesce(a.account_id, a.project_id),
    44	                lower(trim(a.title))
    45	            ORDER BY
    46	                CASE a.status
    47	                    WHEN 'started'   THEN 0
    48	                    WHEN 'unstarted' THEN 1
    49	                    WHEN 'backlog'   THEN 2
    50	                    ELSE 3
    51	                END ASC,
    52	                a.created_at ASC
    53	        ) AS rn
    54	    FROM actions a
    55	    WHERE a.action_kind = 'commitment'
    56	      AND a.status NOT IN ('completed', 'cancelled', 'rejected', 'archived')
    57	      AND coalesce(a.account_id, a.project_id) IS NOT NULL
    58	)
    59	WHERE rn = 1;
    60	
    61	-- Index the temp table so the rewire/delete joins are fast.
    62	CREATE INDEX _dos321_idx ON _dos321_canonical (entity_id, norm_title);
    63	
    64	-- Rewire bridge rows: any bridge row whose action_id is a non-canonical
    65	-- duplicate gets redirected to the canonical action_id. Bridge rows on
    66	-- the canonical action are unchanged.
    67	UPDATE ai_commitment_bridge
    68	SET action_id = (
    69	    SELECT c.canonical_id
    70	    FROM actions a
    71	    JOIN _dos321_canonical c
    72	      ON c.entity_id = coalesce(a.account_id, a.project_id)
    73	     AND c.norm_title = lower(trim(a.title))
    74	    WHERE a.id = ai_commitment_bridge.action_id
    75	    LIMIT 1
    76	)
    77	WHERE action_id IN (
    78	    SELECT a.id
    79	    FROM actions a
    80	    JOIN _dos321_canonical c
    81	      ON c.entity_id = coalesce(a.account_id, a.project_id)
    82	     AND c.norm_title = lower(trim(a.title))
    83	    WHERE a.action_kind = 'commitment'
    84	      AND a.id != c.canonical_id
    85	);
    86	
    87	-- Delete duplicate action rows (everything that isn't a canonical row in
    88	-- its (entity, normalized_title) group). The bridge rows that pointed at
    89	-- these are already redirected by the UPDATE above.
    90	DELETE FROM actions
    91	WHERE id IN (
    92	    SELECT a.id
    93	    FROM actions a
    94	    JOIN _dos321_canonical c
    95	      ON c.entity_id = coalesce(a.account_id, a.project_id)
    96	     AND c.norm_title = lower(trim(a.title))
    97	    WHERE a.action_kind = 'commitment'
    98	      AND a.status NOT IN ('completed', 'cancelled', 'rejected', 'archived')
    99	      AND a.id != c.canonical_id
   100	);
   101	
   102	DROP INDEX _dos321_idx;
   103	DROP TABLE _dos321_canonical;
   104	
   105	COMMIT;

