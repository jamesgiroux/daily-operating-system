     6	-- Captures old roles into account_stakeholder_roles before dropping the role column.
     7	
     8	PRAGMA foreign_keys = OFF;
     9	BEGIN IMMEDIATE;
    10	
    11	-- =============================================================================
    12	-- Step 1: Capture existing roles before we rebuild account_stakeholders
    13	-- =============================================================================
    14	CREATE TEMP TABLE _old_stakeholder_data AS
    15	SELECT account_id, person_id, role, data_source, last_seen_in_glean, created_at
    16	FROM account_stakeholders;
    17	
    18	-- =============================================================================
    19	-- Step 2: Rebuild account_stakeholders with FK to people + new columns
    20	--         The `role` column is removed — roles now live in account_stakeholder_roles.
    21	-- =============================================================================
    22	DROP TABLE IF EXISTS account_stakeholders;
    23	CREATE TABLE account_stakeholders (
    24	    account_id             TEXT NOT NULL REFERENCES accounts(id) ON DELETE CASCADE,
    25	    person_id              TEXT NOT NULL REFERENCES people(id)   ON DELETE CASCADE,
    26	    engagement             TEXT,          -- strong_advocate | engaged | neutral | disengaged | unknown
    27	    data_source_engagement TEXT NOT NULL DEFAULT 'ai',
    28	    assessment             TEXT,          -- free-text assessment of the person's stance
    29	    data_source_assessment TEXT NOT NULL DEFAULT 'ai',
    30	    data_source            TEXT NOT NULL DEFAULT 'user',       -- row-level provenance (preserved)
    31	    last_seen_in_glean     TEXT,                                -- staleness tracking (preserved)
    32	    created_at             TEXT NOT NULL DEFAULT (datetime('now')),
    33	    PRIMARY KEY (account_id, person_id)
    34	);
    35	
    36	-- Migrate only rows whose person_id actually exists in people (FK enforcement)
    37	INSERT OR IGNORE INTO account_stakeholders (
    38	    account_id, person_id, data_source, last_seen_in_glean, created_at
    39	)
    40	SELECT account_id, person_id, data_source, last_seen_in_glean, created_at
    41	FROM _old_stakeholder_data
    42	WHERE person_id IN (SELECT id FROM people);
