     1	-- DOS-258 Lane A: linked_entities_raw + linked_entities view.
     2	--
     3	-- Raw table is the single write surface for all entity linking. The view is
     4	-- the sole public read surface — production queries must never read `_raw`
     5	-- directly. Direct reads are blocked via a pre-commit grep hook + code review
     6	-- (clippy cannot enforce module-level visibility across crate boundaries).
     7	--
     8	-- Design decisions encoded here:
     9	-- * owner_type CHECK ensures the three recognized surfaces are the only
    10	--   values that can appear; a typo like 'meetings' fails at insert time.
    11	-- * role CHECK prevents silent promotion to 'primary' or 'auto_suggested'
    12	--   via raw SQL that would bypass the engine.
    13	-- * idx_one_primary partial unique index enforces at most one primary link
    14	--   per (owner_type, owner_id) pair. Any rule that tries to insert a second
    15	--   primary without first deleting the old one will get a UNIQUE constraint
    16	--   violation, making double-primary bugs loud instead of silent.
    17	-- * The view filters source != 'user_dismissed' so that dismissed entities
    18	--   are recorded (for dismissal-persistence logic) but invisible to all
    19	--   UI/intelligence reads that go through the view.
    20	
    21	CREATE TABLE IF NOT EXISTS linked_entities_raw (
    22	    owner_type    TEXT NOT NULL CHECK (owner_type IN ('meeting', 'email', 'email_thread')),
    23	    owner_id      TEXT NOT NULL,
    24	    entity_id     TEXT NOT NULL,
    25	    entity_type   TEXT NOT NULL,
    26	    role          TEXT NOT NULL CHECK (role IN ('primary', 'related', 'auto_suggested')),
    27	    source        TEXT NOT NULL,  -- 'rule:<id>' | 'user' | 'inherited_from_thread' | 'inherited_from_series' | 'legacy'
    28	    rule_id       TEXT,
    29	    confidence    REAL,
    30	    evidence_json TEXT,
    31	    graph_version INTEGER NOT NULL,
    32	    created_at    TEXT NOT NULL,
    33	    PRIMARY KEY (owner_type, owner_id, entity_id, entity_type)
    34	);
    35	
    36	-- At most one primary link per owner. Partial index; does not constrain
    37	-- 'related' or 'auto_suggested' rows.
    38	CREATE UNIQUE INDEX IF NOT EXISTS idx_one_primary
    39	    ON linked_entities_raw (owner_type, owner_id)
    40	    WHERE role = 'primary';
    41	
    42	-- Supporting index for owner lookups (e.g. "give me all links for this email")
    43	CREATE INDEX IF NOT EXISTS idx_linked_entities_raw_owner
    44	    ON linked_entities_raw (owner_type, owner_id);
    45	
    46	-- View is the public read surface. source='user_dismissed' rows are stored
    47	-- in the raw table so dismissal-persistence checks can find them, but are
    48	-- excluded from all UI / intelligence reads.
    49	CREATE VIEW IF NOT EXISTS linked_entities AS
    50	    SELECT * FROM linked_entities_raw
    51	    WHERE source != 'user_dismissed';

