     5	-- singleton counter; bumping it on every claim write thrashes unrelated
     6	-- entity-linking evaluations. This migration introduces per-entity
     7	-- claim_version columns + a shared migration_state(global_claim_epoch) row.
     8	--
     9	-- Architecture (Option A, picked per Codex round 2 finding 6):
    10	--   - Per-entity claim_version: sync transactional, matches single-source-of-truth
    11	--     posture. Readers check entity.claim_version off the row they already loaded.
    12	--   - global_claim_epoch (in migration_state): for SubjectRef::Global claims.
    13	--     Spine restriction: no claim_type registers canonical_subject_types
    14	--     containing Global; the row is structurally available for v1.4.1+.
    15	--   - SubjectRef::Multi: deterministic lock ordering (Account < Meeting < Person
    16	--     < Project) prevents deadlocks under concurrent commits.
    17	--
    18	-- The Rust helpers in src-tauri/src/db/claim_invalidation.rs are the SOLE
    19	-- writers of these counters. CI lint enforces.
    20	
    21	ALTER TABLE accounts         ADD COLUMN claim_version INTEGER NOT NULL DEFAULT 0;
    22	ALTER TABLE projects         ADD COLUMN claim_version INTEGER NOT NULL DEFAULT 0;
    23	ALTER TABLE people           ADD COLUMN claim_version INTEGER NOT NULL DEFAULT 0;
