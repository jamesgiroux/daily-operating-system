   989	/// Run all pending migrations.
   990	///
   991	/// Returns the number of migrations applied (0 if already up-to-date).
   992	///
   993	/// Forward-compat guard: if the database has a higher version than the highest
   994	/// known migration, returns an error telling the user to update DailyOS.
   995	pub fn run_migrations(conn: &Connection) -> Result<usize, String> {
   996	    ensure_schema_version_table(conn)?;
   997	    bootstrap_existing_db(conn)?;
   998	
   999	    let current = current_version(conn)?;
  1000	    let max_known = MIGRATIONS.last().map(|m| m.version).unwrap_or(0);
  1001	
  1002	    // Forward-compat guard
  1003	    if current > max_known {
  1004	        return Err(format!(
  1005	            "Database schema version ({}) is newer than this version of DailyOS supports ({}). \
  1006	             Please update DailyOS to the latest version.",
  1007	            current, max_known
  1008	        ));
  1009	    }
  1010	
  1011	    // Collect pending migrations
  1012	    let pending: Vec<&Migration> = MIGRATIONS.iter().filter(|m| m.version > current).collect();
  1013	
  1014	    if pending.is_empty() {
  1015	        verify_required_schema(conn)?;
  1016	        return Ok(0);
  1017	    }
  1018	
  1019	    // Backup before applying any migrations
  1020	    let backup_path = backup_before_migration(conn)?;
  1021	    if backup_path.to_string_lossy() != ":memory:" {
  1022	        log::info!(
  1023	            "Migration safety backup ready at {}",
  1024	            backup_path.to_string_lossy()
  1025	        );
  1026	    }
  1027	
  1028	    // Apply each pending migration in order
  1029	    for migration in &pending {
  1030	        match conn.execute_batch(migration.sql) {
  1031	            Ok(()) => {}
  1032	            Err(e) => {
  1033	                let msg = e.to_string();
  1034	                // SQLite DDL statements like ALTER TABLE ADD COLUMN and RENAME COLUMN
  1035	                // are not idempotent (no IF NOT EXISTS / IF EXISTS variants).
  1036	                // Tolerate these specific benign errors ONLY for true single-statement
  1037	                // ALTER TABLE migrations:
  1038	                // - "duplicate column name": ADD COLUMN when column already exists
  1039	                // - "no such column": RENAME COLUMN when column was already renamed
  1040	                //
  1041	                // Detection: check that every non-empty, non-comment statement in
  1042	                // the migration is an ALTER TABLE. Checking `!contains("BEGIN")`
  1043	                // is insufficient — multi-statement non-transactional migrations
  1044	                // (e.g. 023 with CREATE/INSERT/DROP/ALTER) would pass that check,
  1045	                // silently swallowing real data-copy failures.
  1046	                let is_single_alter = migration
  1047	                    .sql
  1048	                    .split(';')
  1049	                    .map(|s| {
  1050	                        s.lines()
  1051	                            .filter(|l| !l.trim_start().starts_with("--"))
  1052	                            .collect::<Vec<_>>()
  1053	                            .join(" ")
  1054	                    })
  1055	                    .map(|s| s.trim().to_uppercase())
  1056	                    .filter(|s| !s.is_empty())
  1057	                    .all(|s| s.starts_with("ALTER"));
  1058	                // "duplicate column name" is always safe: can only come from
  1059	                // ALTER TABLE ADD COLUMN when the column already exists.
  1060	                // "no such column" is only safe for pure ALTER TABLE migrations
  1061	                // (PR #11: multi-statement migrations with CREATE/INSERT/DROP
  1062	                // must not silently swallow this error).
  1063	                let is_dup_column = msg.contains("duplicate column name");
  1064	                let is_benign_alter =
  1065	                    is_single_alter && msg.contains("no such column");
  1066	                if is_dup_column || is_benign_alter {
  1067	                    log::warn!(
  1068	                        "Migration v{}: benign schema conflict ({}), continuing",
  1069	                        migration.version,
  1070	                        msg.split('\n').next().unwrap_or(&msg)
  1071	                    );
  1072	                } else {
  1073	                    return Err(format!("Migration v{} failed: {}", migration.version, e));
  1074	                }
  1075	            }
  1076	        }
  1077	
  1078	        conn.execute(
  1079	            "INSERT INTO schema_version (version) VALUES (?1)",
  1080	            [migration.version],
  1081	        )
  1082	        .map_err(|e| format!("Failed to record migration v{}: {}", migration.version, e))?;
  1083	
  1084	        log::info!("Applied migration v{}", migration.version);
  1085	    }
  1086	
  1087	    verify_required_schema(conn)?;
  1088	    Ok(pending.len())

