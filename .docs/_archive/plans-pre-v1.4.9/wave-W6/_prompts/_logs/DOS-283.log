    48	-- a view over entity_intelligence + accounts.* narrative columns +
    49	-- intelligence.json content; the test fixture shape exposes only the
    50	-- columns the reconcile SQL joins on.
    51	CREATE TABLE IF NOT EXISTS legacy_projection_state (
    52	    subject_ref        TEXT NOT NULL,
