    54	    field_path         TEXT NOT NULL,
    55	    dedup_key          TEXT,
    56	    item_hash          TEXT,
    57	    sourced_at         TEXT,
    58	    projection_target  TEXT NOT NULL  -- 'entity_intelligence' | 'intelligence_json' | 'account_narrative'
    59	);
