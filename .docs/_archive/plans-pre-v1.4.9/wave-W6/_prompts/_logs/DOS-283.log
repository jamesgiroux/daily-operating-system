     1	//! Profile-agnostic tracked entity abstraction (ADR-0045).
     2	//!
     3	//! CS = Account, PM = Project, Manager = Person. The `entities` table
     4	//! provides a universal layer so core behaviors (last-contact tracking,
     5	//! capture association, action linking) work for any profile. CS-specific
     6	//! fields (lifecycle, ARR, health) remain in the `accounts` table.
     7	
     8	use serde::{Deserialize, Serialize};
     9	
    10	/// The kind of entity being tracked, driven by active profile.
    11	#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
    12	#[serde(rename_all = "snake_case")]
    13	pub enum EntityType {
    14	    Account, // CS profile
    15	    Project, // PM profile (future)
    16	    Person,  // Manager profile (future)
    17	    Other,
    18	}
    19	
    20	impl EntityType {
    21	    /// Return the default entity type for a given profile name.
    22	    pub fn default_for_profile(profile: &str) -> Self {
    23	        match profile {
    24	            "customer-success" => EntityType::Account,
    25	            "product-manager" => EntityType::Project,
    26	            "manager" => EntityType::Person,
    27	            _ => EntityType::Other,
    28	        }
    29	    }
    30	
    31	    /// String label for SQL storage.
    32	    pub fn as_str(&self) -> &'static str {
    33	        match self {
    34	            EntityType::Account => "account",
    35	            EntityType::Project => "project",
    36	            EntityType::Person => "person",
    37	            EntityType::Other => "other",
    38	        }
    39	    }
    40	
    41	    /// Parse from SQL string.
    42	    pub fn from_str_lossy(s: &str) -> Self {
    43	        match s {
    44	            "account" => EntityType::Account,
    45	            "project" => EntityType::Project,
    46	            "person" => EntityType::Person,
    47	            _ => EntityType::Other,
    48	        }
    49	    }
    50	}
    51	
    52	/// A row from the `entities` table.
    53	#[derive(Debug, Clone, Serialize)]
    54	#[serde(rename_all = "camelCase")]
    55	pub struct DbEntity {
    56	    pub id: String,
    57	    pub name: String,
    58	    pub entity_type: EntityType,
