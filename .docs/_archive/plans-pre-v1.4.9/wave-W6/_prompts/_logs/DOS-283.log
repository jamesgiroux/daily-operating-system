 succeeded in 434ms:
     1	-- DOS-258 follow-up: complete entity_graph_version trigger coverage.
     2	--
     3	-- Migration 113 added triggers for account_domains, account_stakeholders,
     4	-- and keyword column updates on accounts/projects. It was missing INSERT,
     5	-- DELETE, and name/archived changes on accounts and projects — all inputs
     6	-- that P5 (title evidence) and P4b/P4c (domain evidence) read.
     7	--
     8	-- Without these triggers, the following changes would NOT bump the graph
     9	-- version and evaluations running concurrently would use a stale snapshot:
    10	--   • A new account is created → P4/P5 candidates change immediately
    11	--   • An account is archived → P5 should stop matching it
    12	--   • An account is renamed → P5 name-match results change
    13	--   • A project is created/renamed/archived → same as above
    14	--
    15	-- All triggers follow the same pattern as migration 113:
    16	--   UPDATE entity_graph_version SET version = version + 1 WHERE id = 1
    17	
    18	-- accounts: new account or deleted account changes the P4/P5 candidate set
    19	CREATE TRIGGER IF NOT EXISTS bump_egv_accounts_i
    20	    AFTER INSERT ON accounts
    21	    BEGIN UPDATE entity_graph_version SET version = version + 1 WHERE id = 1; END;
    22	
    23	CREATE TRIGGER IF NOT EXISTS bump_egv_accounts_d
    24	    AFTER DELETE ON accounts
    25	    BEGIN UPDATE entity_graph_version SET version = version + 1 WHERE id = 1; END;
    26	
    27	-- accounts: name change affects P5 whole-word matching
    28	CREATE TRIGGER IF NOT EXISTS bump_egv_accounts_name
    29	    AFTER UPDATE OF name ON accounts
    30	    BEGIN UPDATE entity_graph_version SET version = version + 1 WHERE id = 1; END;
    31	
    32	-- accounts: archive/unarchive changes which accounts P5 considers
    33	CREATE TRIGGER IF NOT EXISTS bump_egv_accounts_archived
    34	    AFTER UPDATE OF archived ON accounts
    35	    BEGIN UPDATE entity_graph_version SET version = version + 1 WHERE id = 1; END;
    36	
    37	-- projects: new project or deleted project
    38	CREATE TRIGGER IF NOT EXISTS bump_egv_projects_i
    39	    AFTER INSERT ON projects
    40	    BEGIN UPDATE entity_graph_version SET version = version + 1 WHERE id = 1; END;
    41	
    42	CREATE TRIGGER IF NOT EXISTS bump_egv_projects_d
    43	    AFTER DELETE ON projects
    44	    BEGIN UPDATE entity_graph_version SET version = version + 1 WHERE id = 1; END;
    45	
    46	-- projects: name change affects P5 matching
    47	CREATE TRIGGER IF NOT EXISTS bump_egv_projects_name
    48	    AFTER UPDATE OF name ON projects
    49	    BEGIN UPDATE entity_graph_version SET version = version + 1 WHERE id = 1; END;
    50	
    51	-- projects: archive/unarchive
    52	CREATE TRIGGER IF NOT EXISTS bump_egv_projects_archived
    53	    AFTER UPDATE OF archived ON projects
    54	    BEGIN UPDATE entity_graph_version SET version = version + 1 WHERE id = 1; END;

