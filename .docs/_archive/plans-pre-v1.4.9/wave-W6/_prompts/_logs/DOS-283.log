    68	             AND pi.dedup_key = tc.dedup_key THEN 'dedup_key'
    69	        WHEN pi.item_hash IS NOT NULL
    70	             AND tc.item_hash IS NOT NULL
    71	             AND pi.item_hash = tc.item_hash THEN 'item_hash'
    72	        ELSE 'unknown'
    73	    END AS match_path
