     1	-- DOS-74: Add confidence + is_primary columns to meeting_entities.
     2	--
     3	-- Prior behavior: when two accounts (e.g. parent + subsidiary BU) shared a
     4	-- domain, the entity resolver auto-linked BOTH as equally-resolved entities.
     5	-- Meeting briefings then displayed every domain-matched account as an equal
     6	-- primary chip, cluttering the UI with duplicates.
     7	--
     8	-- This migration adds per-junction confidence and an is_primary flag so:
     9	--   - The highest-confidence link per meeting is marked primary.
    10	--   - Lower-confidence links (<0.60) can render as muted "suggestions"
    11	--     rather than co-equal primaries.
    12	--
    13	-- Defaults: existing rows get confidence = 0.95 (same as manual junction
    14	-- matches) and is_primary = 1 (treat prior auto-links as primary) so the
    15	-- migration is backward-compatible for already-linked meetings.
    16	
    17	ALTER TABLE meeting_entities ADD COLUMN confidence REAL NOT NULL DEFAULT 0.95;
