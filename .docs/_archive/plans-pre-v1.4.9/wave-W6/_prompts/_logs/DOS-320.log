     6	export function useEntityContextEntries(entityType: string, entityId: string | null) {
     7	  const [entries, setEntries] = useState<EntityContextEntry[]>([]);
     8	  const [loading, setLoading] = useState(false);
     9	
    10	  const fetchEntries = useCallback(async () => {
    11	    if (!entityId) return;
    12	    setLoading(true);
    13	    try {
    14	      const result = await invoke<EntityContextEntry[]>("get_entity_context_entries", {
    15	        entityType,
    16	        entityId,
    17	      });
    18	      setEntries(result);
    19	    } catch (e) {
    20	      console.error("Failed to fetch entity context entries:", e);
    21	      toast.error("Failed to load notes");
    22	    } finally {
    23	      setLoading(false);
    24	    }
    25	  }, [entityType, entityId]);
    26	
    27	  useEffect(() => {
    28	    fetchEntries();
    29	  }, [fetchEntries]);
    30	
    31	  const createEntry = useCallback(async (title: string, content: string) => {
    32	    if (!entityId) return;
    33	    try {
    34	      const entry = await invoke<EntityContextEntry>("create_entity_context_entry", {
    35	        entityType,
    36	        entityId,
    37	        title,
    38	        content,
    39	      });
    40	      setEntries((prev) => [entry, ...prev]);
    41	    } catch (e) {
    42	      console.error("Failed to create entity context entry:", e);
    43	      toast.error("Failed to save note");
    44	    }
    45	  }, [entityType, entityId]);
    46	
    47	  const updateEntry = useCallback(async (id: string, title: string, content: string) => {
    48	    try {
    49	      await invoke("update_entity_context_entry", { id, title, content });
    50	      setEntries((prev) =>
    51	        prev.map((e) =>
    52	          e.id === id ? { ...e, title, content, updatedAt: new Date().toISOString() } : e,
    53	        ),
    54	      );
    55	    } catch (e) {
    56	      console.error("Failed to update entity context entry:", e);
    57	      toast.error("Failed to save note");
    58	    }
    59	  }, []);
    60	
    61	  const deleteEntry = useCallback(async (id: string) => {
    62	    try {
    63	      await invoke("delete_entity_context_entry", { id });
    64	      setEntries((prev) => prev.filter((e) => e.id !== id));
    65	    } catch (e) {
    66	      console.error("Failed to delete entity context entry:", e);
    67	      toast.error("Failed to delete note");
    68	    }
    69	  }, []);
    70	
    71	  return { entries, loading, createEntry, updateEntry, deleteEntry };
    72	}

