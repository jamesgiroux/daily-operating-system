     5	 */
     6	import type { ItemSource } from "@/types";
     7	
     8	interface ProvenanceTagProps {
     9	  itemSource?: ItemSource;
    10	  discrepancy?: boolean;
    11	}
    12	
    13	function formatProvenance(source: ItemSource): string | null {
    14	  switch (source.source) {
    15	    case "transcript":
    16	      return source.reference ? `from meeting ${source.reference}` : "from meeting";
    17	    case "user_correction":
    18	      return "you edited this";
    19	    case "glean_crm":
    20	      return "from Salesforce";
    21	    case "glean_zendesk":
    22	      return "from Zendesk";
    23	    case "glean_gong":
    24	      return "from Gong";
