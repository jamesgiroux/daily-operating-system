    26	      return "from Glean";
    27	    case "email":
    28	      return "from email";
    29	    case "local_file":
    30	      return source.reference ? `from ${source.reference}` : "from file";
    31	    case "pty_synthesis":
    32	      return null; // Default source, no tag
    33	    default:
    34	      return null;
    35	  }
    36	}
    37	
