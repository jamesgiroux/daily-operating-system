    23	/**
    24	 * Translate internal source system names to user-friendly product vocabulary.
    25	 * See ADR-0083 for the canonical mapping.
    26	 */
    27	export function formatProvenanceSource(source?: string | null): string | null {
    28	  if (!source) return null;
    29	  const normalized = source.toLowerCase().trim();
    30	
    31	  // Exact matches first (ADR-0083 table)
    32	  if (normalized === "user_correction") return "you corrected";
    33	  if (normalized === "user" || normalized === "user_edit" || normalized === "user_noted") return "you noted";
    34	  if (normalized === "pty_synthesis" || normalized === "pty") return "AI";
    35	  if (normalized === "glean_chat") return "Glean";
    36	  if (normalized === "glean") return "Glean";
    37	  if (normalized === "salesforce") return "Salesforce";
    38	  if (normalized === "zendesk") return "Zendesk";
    39	  if (normalized === "gong") return "Gong";
    40	  if (normalized === "google") return "Google Calendar";
    41	  if (normalized === "clay") return "Clay";
    42	  if (normalized === "ai") return "AI";
    43	  if (normalized === "inference") return "AI synthesis";
    44	
    45	  // Substring matches for compound source names
    46	  if (normalized.includes("salesforce") || normalized.includes("glean_crm")) return "Salesforce";
    47	  if (normalized.includes("gong")) return "Gong";
    48	  if (normalized.includes("zendesk")) return "Zendesk";
    49	  if (normalized.includes("glean")) return "Glean";
    50	  if (normalized.includes("google")) return "Google Calendar";
    51	  if (normalized.includes("clay")) return "Clay";
    52	  if (normalized.includes("email")) return "email";
    53	  if (
    54	    normalized.includes("ai_inference")
    55	    || normalized.includes("pty_synthesis")
    56	    || normalized.includes("pty")
    57	    || normalized.includes("intelligence")
    58	    || normalized.includes("ai")
    59	  ) {
    60	    return "AI";
    61	  }
    62	
    63	  // Fallback: humanize underscores
