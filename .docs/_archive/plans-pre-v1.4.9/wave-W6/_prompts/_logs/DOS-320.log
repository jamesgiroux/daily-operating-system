   316	
   317	const PREP_IMPACT_TAIL_RE = /\s+[—-]\s*(high|medium|low)\s*$/i;
   318	
   319	export function parsePrepGridItem(raw: string): ParsedPrepGridItem {
   320	  const cleaned = stripMarkdown(raw).trim();
