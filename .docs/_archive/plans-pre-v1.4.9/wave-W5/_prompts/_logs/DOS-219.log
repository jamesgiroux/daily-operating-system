   633	fn generate_mechanical_prep(
   634	    state: &AppState,
   635	    meeting_id: &str,
   636	    overwrite_existing: bool,
   637	) -> Result<bool, String> {
   638	    let workspace = {
   639	        let config_guard = state.config_read_or_recover()?;
   640	        let config = config_guard.as_ref().ok_or("No config")?;
   641	        std::path::PathBuf::from(&config.workspace_path)
   642	    };
   643	    let active_preset = state.active_preset.read().clone();
   644	
   645	    generate_mechanical_prep_with_inputs(
   646	        workspace,
   647	        Arc::clone(&state.embedding_model),
   648	        active_preset,
   649	        meeting_id,
   650	        overwrite_existing,
   651	    )
   652	}
