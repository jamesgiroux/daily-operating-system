  3415	    state: &std::sync::Arc<AppState>,
  3416	    app_handle: tauri::AppHandle,
  3417	) -> Result<crate::types::TranscriptResult, String> {
  3418	    ctx.check_mutation_allowed().map_err(|e| e.to_string())?;
  3419	    // Look up the meeting and its transcript path
  3420	    let mid = meeting_id.to_string();
  3421	    let meeting_data = state
  3422	        .db_read(move |db| {
  3423	            let meeting = db
  3424	                .get_meeting_intelligence_row(&mid)
  3425	                .map_err(|e| e.to_string())?
