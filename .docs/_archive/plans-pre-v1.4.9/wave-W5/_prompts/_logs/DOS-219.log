   168	    pub provenance: Provenance,           // Canonical location — see ADR-0105
   169	    pub ability_version: AbilityVersion,  // Which version of the ability produced this
   170	    pub diagnostics: Diagnostics,         // Non-fatal warnings, missing sources, etc.
