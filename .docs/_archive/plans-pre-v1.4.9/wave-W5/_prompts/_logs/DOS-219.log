   331	    loop {
   332	        // Adaptive sleep: back off when queue is empty + user is active; wake instantly on enqueue
   333	        let interval = crate::activity::adaptive_poll_interval(
   334	            &state.activity,
   335	            state.meeting_prep_queue.is_empty(),
   336	        );
