   645	/// Generate a content-stable action ID (same logic as Python _make_id).
   646	fn make_action_id(title: &str, account: &str, due: &str) -> String {
   647	    use std::collections::hash_map::DefaultHasher;
   648	    use std::hash::{Hash, Hasher};
   649	    let key = format!(
   650	        "{}|{}|{}",
   651	        title.to_lowercase().trim(),
   652	        account.to_lowercase().trim(),
   653	        due.trim()
   654	    );
   655	    let mut hasher = DefaultHasher::new();
   656	    key.hash(&mut hasher);
   657	    format!("action-{:010x}", hasher.finish() & 0xFF_FFFF_FFFF)
   658	}
