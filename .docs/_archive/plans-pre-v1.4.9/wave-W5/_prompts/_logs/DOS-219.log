   140	/// Generate a stable meeting ID from a calendar event.
   141	/// Format: HHMM-type-slug (e.g. "0900-customer-acme-sync").
   142	pub fn make_meeting_id(summary: &str, start: &str, meeting_type: &str) -> String {
   143	    let slug_re = Regex::new(r"[^a-z0-9]+").unwrap();
   144	    let lower = summary.to_lowercase();
   145	    let slug = slug_re.replace_all(&lower, "-");
   146	    let slug = slug.trim_matches('-');
   147	    let slug = if slug.len() > 40 { &slug[..40] } else { slug };
   148	
   149	    let time_prefix = if start.contains('T') {
   150	        DateTime::parse_from_rfc3339(&start.replace('Z', "+00:00"))
   151	            .or_else(|_| DateTime::parse_from_rfc3339(start))
   152	            .map(|dt| dt.format("%H%M").to_string())
   153	            .unwrap_or_default()
   154	    } else {
   155	        String::new()
   156	    };
   157	
   158	    let time_prefix = if time_prefix.is_empty() {
   159	        use std::collections::hash_map::DefaultHasher;
   160	        use std::hash::{Hash, Hasher};
   161	        let mut hasher = DefaultHasher::new();
   162	        format!("{}-{}", start, summary).hash(&mut hasher);
   163	        format!("{:06x}", hasher.finish() & 0xFFFFFF)
   164	    } else {
   165	        time_prefix
   166	    };
   167	
   168	    format!("{}-{}-{}", time_prefix, meeting_type, slug)
   169	}
