  3427	            let transcript_path = meeting
  3428	                .transcript_path
  3429	                .clone()
  3430	                .ok_or_else(|| format!("No transcript attached to meeting {}", mid))?;
  3431	            Ok((meeting, transcript_path))
  3432	        })
  3433	        .await?;
  3434	
  3435	    let (meeting_row, transcript_path) = meeting_data;
  3436	
  3437	    // Clear all existing extraction data
  3438	    let clear_mid = meeting_id.to_string();
  3439	    let cleared = state
  3440	        .db_write(move |db| {
  3441	            db.clear_meeting_extraction_data(&clear_mid)
  3442	                .map_err(|e| e.to_string())
  3443	        })
  3444	        .await?;
  3445	    log::info!(
  3446	        "Reprocess: cleared {} extraction records for meeting {}",
  3447	        cleared,
  3448	        meeting_id
  3449	    );
  3450	
  3451	    // Remove the TOCTOU guard so attach_meeting_transcript doesn't reject
  3452	    {
  3453	        let mut guard = state.capture.transcript_processed.lock();
  3454	        guard.remove(meeting_id);
  3455	    }
  3456	
  3457	    // Build a CalendarEvent from the DB row for the pipeline
  3458	    let cal_event = crate::types::CalendarEvent {
  3459	        id: meeting_row.id.clone(),
  3460	        title: meeting_row.title.clone(),
  3461	        start: chrono::DateTime::parse_from_rfc3339(&meeting_row.start_time)
  3462	            .map(|dt| dt.with_timezone(&chrono::Utc))
  3463	            .unwrap_or_else(|_| ctx.clock.now()),
  3464	        end: meeting_row
  3465	            .end_time
  3466	            .as_deref()
  3467	            .and_then(|t| chrono::DateTime::parse_from_rfc3339(t).ok())
  3468	            .map(|dt| dt.with_timezone(&chrono::Utc))
  3469	            .unwrap_or_else(|| ctx.clock.now()),
  3470	        meeting_type: crate::parser::parse_meeting_type(&meeting_row.meeting_type),
  3471	        attendees: Vec::new(),
