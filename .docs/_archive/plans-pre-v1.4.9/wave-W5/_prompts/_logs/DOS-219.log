    65	/// Clear the cached briefing manifest when state changes (timezone, enrichment, etc).
    66	///
    67	/// Cache at `_today/data/schedule.json` can become stale if:
    68	/// - Timezone config changes
    69	/// - Events are cancelled in Google Calendar
    70	/// - Enrichment runs and updates intelligence
    71	///
    72	/// This invalidates the cache so the next refresh regenerates from live data.
    73	pub fn invalidate_briefing_cache(data_dir: &Path) {
    74	    let cache_path = data_dir.join("schedule.json");
    75	    if cache_path.exists() {
    76	        match fs::remove_file(&cache_path) {
    77	            Ok(_) => log::info!("Briefing cache invalidated: {}", cache_path.display()),
    78	            Err(e) => log::warn!("Failed to invalidate cache: {}", e),
    79	        }
    80	    }
    81	}
