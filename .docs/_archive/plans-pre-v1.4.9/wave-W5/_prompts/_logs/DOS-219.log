   721	/// PTY enrichment timeout for a single meeting (90 seconds).
   722	/// Raised from 30s to the v1.2.1 floor of 90s to avoid user-visible
   723	/// Claude-timeout errors on manual refresh paths.
   724	const ENRICHMENT_TIMEOUT_SECS: u64 = 90;
   725	
   726	/// Enrich a single meeting's prep via PTY-spawned Claude (async wrapper).
   727	///
   728	/// Reads the mechanical prep from DB, builds an AI enrichment prompt,
   729	/// parses structured output, and writes the enriched prep back.
   730	/// On any failure — PTY unavailable, budget exhausted, timeout,
   731	/// parse failure — the mechanical prep remains untouched.
   732	async fn enrich_prep_via_pty(state: &AppState, app: &AppHandle, meeting_id: &str) {
   733	    // Gate: is Claude CLI available?
   734	    if !crate::pty::PtyManager::is_claude_available() {
   735	        log::debug!(
   736	            "enrich_prep_via_pty: Claude CLI not available, skipping {}",
   737	            meeting_id
   738	        );
   739	        return;
   740	    }
   741	
   742	    // Gate: is background AI paused (budget / timeout guard)?
   743	    if crate::pty::background_ai_paused() {
   744	        log::debug!(
   745	            "enrich_prep_via_pty: background AI paused, skipping {}",
   746	            meeting_id
   747	        );
   748	        return;
   749	    }
   750	
   751	    // Resolve workspace path
   752	    let workspace = match state.config_read_or_recover() {
   753	        Ok(guard) => match guard.as_ref() {
   754	            Some(config) => std::path::PathBuf::from(&config.workspace_path),
   755	            None => {
   756	                log::warn!("enrich_prep_via_pty: no config, skipping {}", meeting_id);
   757	                return;
   758	            }
   759	        },
   760	        Err(e) => {
   761	            log::warn!("enrich_prep_via_pty: config error: {}, skipping {}", e, meeting_id);
   762	            return;
   763	        }
   764	    };
   765	
   766	    // Read AI model config for extraction tier
   767	    let ai_config = state
   768	        .config
   769	        .read()
   770	        .as_ref()
   771	        .map(|c| c.ai_models.clone())
   772	        .unwrap_or_default();
   773	
   774	    let pty = crate::pty::PtyManager::for_tier(crate::pty::ModelTier::Extraction, &ai_config)
   775	        .with_timeout(ENRICHMENT_TIMEOUT_SECS)
   776	        .with_nice_priority(15)
   777	        .with_usage_context(
   778	            crate::pty::AiUsageContext::new("meeting_prep", "agenda_enrichment")
   779	                .with_trigger("prep_queue")
   780	                .with_background(true)
   781	                .with_tier(crate::pty::ModelTier::Extraction),
   782	        );
   783	
   784	    // Acquire PTY semaphore to serialize AI calls
   785	    let _permit = match state.permits.pty.acquire().await {
   786	        Ok(p) => p,
   787	        Err(_) => {
   788	            log::warn!("enrich_prep_via_pty: PTY semaphore closed, skipping {}", meeting_id);
   789	            return;
   790	        }
   791	    };
   792	
   793	    // Read current prep from DB on a blocking thread
   794	    let mid = meeting_id.to_string();
   795	    let prep_json = match tokio::task::spawn_blocking(move || {
   796	        let db = crate::db::ActionDb::open().map_err(|e| format!("DB open: {}", e))?;
   797	        let meeting = db
   798	            .get_meeting_by_id(&mid)
   799	            .map_err(|e| e.to_string())?
   800	            .ok_or_else(|| format!("Meeting not found: {}", mid))?;
   801	        meeting
   802	            .prep_frozen_json
   803	            .ok_or_else(|| format!("No prep_frozen_json for {}", mid))
   804	    })
   805	    .await
   806	    {
   807	        Ok(Ok(json_str)) => json_str,
   808	        Ok(Err(e)) => {
   809	            log::warn!("enrich_prep_via_pty: {}", e);
   810	            return;
   811	        }
   812	        Err(e) => {
   813	            log::warn!("enrich_prep_via_pty: task panicked: {}", e);
   814	            return;
   815	        }
   816	    };
   817	
   818	    let prep: serde_json::Value = match serde_json::from_str(&prep_json) {
   819	        Ok(v) => v,
   820	        Err(e) => {
   821	            log::warn!("enrich_prep_via_pty: JSON parse error for {}: {}", meeting_id, e);
   822	            return;
   823	        }
   824	    };
   825	
   826	    // Run enrichment on a blocking thread (PTY is synchronous)
   827	    let ws = workspace.clone();
   828	    let prep_clone = prep.clone();
   829	    let enriched = match tokio::task::spawn_blocking(move || {
   830	        crate::workflow::deliver::enrich_single_prep(&prep_clone, &pty, &ws)
   831	    })
   832	    .await
   833	    {
   834	        Ok(v) => v,
   835	        Err(e) => {
   836	            log::warn!("enrich_prep_via_pty: enrichment task panicked for {}: {}", meeting_id, e);
   837	            return;
   838	        }
   839	    };
   840	
   841	    // Check if enrichment actually changed anything
   842	    if enriched == prep {
   843	        log::debug!("enrich_prep_via_pty: no changes for {}", meeting_id);
   844	        return;
   845	    }
   846	
   847	    // Write enriched prep back to DB
   848	    let enriched_str = match serde_json::to_string(&enriched) {
   849	        Ok(s) => s,
   850	        Err(e) => {
   851	            log::warn!("enrich_prep_via_pty: serialize error for {}: {}", meeting_id, e);
   852	            return;
   853	        }
   854	    };
   855	
   856	    let mid = meeting_id.to_string();
   857	    let write_result = state
   858	        .db_write(move |db| {
   859	            db.conn_ref()
   860	                .execute(
   861	                    "UPDATE meeting_prep SET prep_frozen_json = ?1 WHERE meeting_id = ?2",
   862	                    rusqlite::params![enriched_str, mid],
   863	                )
   864	                .map_err(|e| format!("DB write: {}", e))
   865	        })
   866	        .await;
   867	
   868	    match write_result {
   869	        Ok(_) => {
   870	            log::info!("enrich_prep_via_pty: enriched prep written for {}", meeting_id);
   871	            // Emit prep-ready again so the UI refreshes with the enriched version
   872	            let _ = app.emit(
   873	                "prep-ready",
   874	                PrepReadyPayload {
   875	                    meeting_id: meeting_id.to_string(),
   876	                },
   877	            );
   878	        }
   879	        Err(e) => {
   880	            log::warn!("enrich_prep_via_pty: DB write failed for {}: {}", meeting_id, e);
   881	        }
   882	    }
   883	}
