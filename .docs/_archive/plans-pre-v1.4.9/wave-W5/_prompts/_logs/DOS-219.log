    87	/// Normalise a meeting type string to a valid enum value.
    88	/// Defaults to "internal" for unrecognised values.
    89	pub fn normalise_meeting_type(raw: &str) -> &'static str {
    90	    let normalised = raw.to_lowercase().replace([' ', '-'], "_");
    91	    for &valid in VALID_MEETING_TYPES {
    92	        if normalised == valid {
    93	            return valid;
    94	        }
    95	    }
    96	    "internal"
    97	}
