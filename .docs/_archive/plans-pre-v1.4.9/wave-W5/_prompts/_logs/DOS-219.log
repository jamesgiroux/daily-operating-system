   116	/// Thread-safe meeting prep queue with deduplication and debounce.
   117	pub struct MeetingPrepQueue {
   118	    queue: Mutex<VecDeque<PrepRequest>>,
   119	    last_enqueued: Mutex<HashMap<String, Instant>>,
   120	}
   121	
   122	impl Default for MeetingPrepQueue {
   123	    fn default() -> Self {
   124	        Self::new()
   125	    }
   126	}
   127	
   128	impl MeetingPrepQueue {
   129	    pub fn new() -> Self {
   130	        Self {
   131	            queue: Mutex::new(VecDeque::new()),
   132	            last_enqueued: Mutex::new(HashMap::new()),
   133	        }
   134	    }
   135	
   136	    /// Enqueue a prep request.
   137	    ///
   138	    /// Deduplicates by meeting_id: if already queued, higher priority wins.
   139	    /// Debounces Background/PageLoad requests within `DEBOUNCE_SECS`.
   140	    pub fn enqueue(&self, request: PrepRequest) {
   141	        // Debounce low-priority triggers
   142	        if request.attempt == 0
   143	            && (request.priority == PrepPriority::Background
   144	                || request.priority == PrepPriority::PageLoad)
   145	        {
   146	            let last = self.last_enqueued.lock();
   147	            if let Some(last_time) = last.get(&request.meeting_id) {
   148	                if last_time.elapsed().as_secs() < DEBOUNCE_SECS {
   149	                    log::debug!(
   150	                        "MeetingPrepQueue: debounced {} ({}s since last)",
   151	                        request.meeting_id,
   152	                        last_time.elapsed().as_secs()
   153	                    );
   154	                    return;
   155	                }
   156	            }
   157	            drop(last);
   158	        }
   159	
   160	        let mut queue = self.queue.lock();
   161	
   162	        // Dedup: if meeting already in queue, keep higher priority
   163	        if let Some(existing) = queue
   164	            .iter_mut()
   165	            .find(|r| r.meeting_id == request.meeting_id)
   166	        {
   167	            if request.priority > existing.priority {
   168	                existing.priority = request.priority;
   169	                log::debug!(
   170	                    "MeetingPrepQueue: upgraded priority for {} to {:?}",
   171	                    request.meeting_id,
   172	                    request.priority
   173	                );
   174	            }
   175	            if request.attempt > existing.attempt {
   176	                existing.attempt = request.attempt;
   177	                existing.retry_after = request.retry_after;
   178	                existing.last_error = request.last_error.clone();
   179	            }
   180	            existing.overwrite_existing |= request.overwrite_existing;
   181	            return;
   182	        }
   183	
   184	        log::info!(
   185	            "MeetingPrepQueue: enqueued {} priority={:?}",
   186	            request.meeting_id,
   187	            request.priority
   188	        );
   189	
   190	        queue.push_back(request.clone());
   191	
   192	        // Update debounce tracker
   193	        {
   194	            let mut last = self.last_enqueued.lock();
   195	            last.insert(request.meeting_id, Instant::now());
   196	        }
   197	    }
   198	
   199	    /// Dequeue the highest-priority request.
   200	    pub fn dequeue(&self) -> Option<PrepRequest> {
   201	        let mut queue = self.queue.lock();
   202	        if queue.is_empty() {
   203	            return None;
   204	        }
   205	
   206	        let now = Instant::now();
   207	        let best_idx = queue
   208	            .iter()
   209	            .enumerate()
   210	            .filter(|(_, r)| match r.retry_after {
   211	                Some(retry_after) => retry_after <= now,
   212	                None => true,
   213	            })
   214	            .max_by_key(|(_, r)| r.priority)
   215	            .map(|(i, _)| i)?;
   216	
   217	        queue.remove(best_idx)
   218	    }
   219	
   220	    /// Current queue depth (for diagnostics).
   221	    pub fn len(&self) -> usize {
   222	        self.queue.lock().len()
   223	    }
   224	
   225	    /// Whether the queue is empty.
   226	    pub fn is_empty(&self) -> bool {
   227	        self.len() == 0
   228	    }
   229	
   230	    /// Remove stale entries from the debounce tracker.
   231	    pub fn prune_stale_entries(&self) {
   232	        let stale_threshold_secs = DEBOUNCE_SECS * 10;
   233	        let mut last = self.last_enqueued.lock();
   234	        let before = last.len();
   235	        last.retain(|_, instant| instant.elapsed().as_secs() < stale_threshold_secs);
   236	        let pruned = before - last.len();
   237	        if pruned > 0 {
   238	            log::debug!("MeetingPrepQueue: pruned {} stale debounce entries", pruned);
   239	        }
   240	    }

