   171	/// Derive the primary meeting ID from a calendar event (ADR-0061).
   172	///
   173	/// Prefers the Google Calendar event ID (stable across runs) with `@` sanitized
   174	/// for filesystem safety. Falls back to `make_meeting_id()` for non-calendar
   175	/// meetings or when the event ID is absent.
   176	pub fn meeting_primary_id(
   177	    calendar_event_id: Option<&str>,
   178	    summary: &str,
   179	    start: &str,
   180	    meeting_type: &str,
   181	) -> String {
   182	    if let Some(eid) = calendar_event_id {
   183	        if !eid.is_empty() {
   184	            return eid.replace('@', "_at_");
   185	        }
   186	    }
   187	    make_meeting_id(summary, start, meeting_type)
   188	}
   189	
   190	/// Look up the meeting type for a calendar event by matching its id
   191	/// against the classified meetings dict from the directive.
   192	pub fn classify_event(
   193	    event_id: &str,
   194	    meetings_by_type: &HashMap<String, Vec<DirectiveMeeting>>,
   195	) -> &'static str {
   196	    for (mtype, meeting_list) in meetings_by_type {
   197	        for m in meeting_list {
   198	            let mid = m.event_id.as_deref().or(m.id.as_deref()).unwrap_or("");
   199	            if mid == event_id {
   200	                return normalise_meeting_type(mtype);
   201	            }
   202	        }
   203	    }
   204	    "internal"
   205	}
   206	
   207	/// Find the directive meeting entry for a calendar event.
   208	fn find_meeting_entry<'a>(
   209	    event_id: &str,
   210	    meetings_by_type: &'a HashMap<String, Vec<DirectiveMeeting>>,
   211	) -> (Option<&'a DirectiveMeeting>, Option<String>) {
   212	    for meeting_list in meetings_by_type.values() {
   213	        for m in meeting_list {
   214	            let mid = m.event_id.as_deref().or(m.id.as_deref()).unwrap_or("");
   215	            if mid == event_id {
   216	                return (Some(m), m.account.clone());
   217	            }
   218	        }
   219	    }
   220	    (None, None)

