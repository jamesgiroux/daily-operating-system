  3473	        series_id: None,
  3474	        account: None, // Resolved by transcript pipeline from meeting_entities
  3475	        linked_entities: None,
  3476	        classified_entities: None,
  3477	        scored_classified_entities: None,
  3478	    };
  3479	
  3480	    // Re-run the full pipeline via the existing attach path
  3481	    attach_meeting_transcript(ctx, transcript_path, cal_event, state, app_handle).await
  3482	}
