   320	pub async fn run_meeting_prep_processor(state: Arc<AppState>, app: AppHandle) {
   321	    log::info!("MeetingPrepProcessor: started");
   322	
   323	    // Startup sweep: enqueue all future meetings that have linked entities but no prep.
   324	    // This ensures every meeting with entity intelligence gets a mechanical briefing
   325	    // before the user ever opens it. ADR-0086: meeting prep is a consumer of entity intel.
   326	    sweep_meetings_needing_prep(&state);
