    19	
    20	```rust
    21	pub struct PromptFingerprint {
    22	    pub provider: ProviderKind,            // Enum: ClaudeCode | Ollama | OpenAI | Other(&'static str)
    23	    pub model: ModelName,                  // Newtype over String; runtime-configurable
    24	    pub prompt_template_id: PromptTemplateId, // Stable ID of the prompt template
    25	    pub prompt_template_version: PromptVersion, // Semver per template
    26	    pub canonical_prompt_hash: Hash,       // SHA256 of canonicalized template + inputs
    27	    pub temperature: f32,
    28	    pub top_p: Option<f32>,
    29	    pub seed: Option<u64>,                 // Required in Evaluate mode
    30	    pub tokens_input: Option<u32>,
    31	    pub tokens_output: Option<u32>,
