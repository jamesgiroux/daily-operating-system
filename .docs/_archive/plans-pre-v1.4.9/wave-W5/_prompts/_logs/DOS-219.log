     1	//! Background meeting prep queue.
     2	//!
     3	//! Generates mechanical meeting briefings for future meetings using the
     4	//! existing `gather_meeting_context()` pipeline — the same code `prepare_today`
     5	//! uses. Produces `FullMeetingPrep`-compatible JSON from entity intelligence,
     6	//! account dashboards, open actions, and meeting history without any AI call.
     7	//!
     8	//! Modeled on `intel_queue.rs`: priority queue, dedup, sequential processing,
     9	//! split-lock DB access so the UI stays responsive.
    10	
    11	use std::collections::{HashMap, VecDeque};
    12	use parking_lot::Mutex;
    13	use std::time::{Duration, Instant};
    14	
    15	use std::sync::Arc;
    16	
    17	use serde_json::json;
    18	use tauri::{AppHandle, Emitter};
