  3410	/// Reprocess an already-attached transcript: clear all extraction data, remove
  3411	/// the TOCTOU guard, then re-run the full pipeline as a fresh extraction.
  3412	pub async fn reprocess_meeting_transcript(
  3413	    ctx: &ServiceContext<'_>,
