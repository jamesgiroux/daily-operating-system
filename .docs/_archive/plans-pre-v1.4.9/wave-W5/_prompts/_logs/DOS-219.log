   250	/// Background meeting prep processor.
   251	///
   252	/// Runs in a loop, checking the queue every `POLL_INTERVAL_SECS`.
   253	/// When a request is found:
   254	/// 1. Opens own DB connection (split-lock) to load meeting data
   255	/// 2. Checks if fresh prep already exists
   256	/// 3. Builds classified meeting JSON for `gather_meeting_context`
   257	/// 4. Calls `gather_meeting_context` (mechanical — no AI)
   258	/// 5. Converts context to `FullMeetingPrep` via `build_prep_json`
   259	/// 6. Writes result to `prep_frozen_json` in DB
   260	/// 7. Emits `prep-ready` event
   261	pub fn sweep_meetings_needing_prep(state: &AppState) {
   262	    let db = match crate::db::ActionDb::open() {
   263	        Ok(d) => d,
   264	        Err(e) => {
   265	            log::warn!("MeetingPrepSweep: DB open failed: {e}");
   266	            return;
   267	        }
   268	    };
   269	
   270	    // Find future meetings that have at least one linked entity but no prep
   271	    let sql = "SELECT DISTINCT m.id
   272	               FROM meetings m
   273	               INNER JOIN meeting_entities me ON m.id = me.meeting_id
   274	               LEFT JOIN meeting_prep mp ON mp.meeting_id = m.id
   275	               LEFT JOIN meeting_transcripts mt ON mt.meeting_id = m.id
   276	               WHERE julianday(m.start_time) > julianday('now')
   277	                 AND mp.prep_frozen_json IS NULL
   278	                 AND (mt.intelligence_state IS NULL OR mt.intelligence_state != 'archived')";
   279	
   280	    let meeting_ids: Vec<String> = {
   281	        let conn = db.conn_ref();
   282	        let mut stmt = match conn.prepare(sql) {
   283	            Ok(s) => s,
   284	            Err(e) => {
   285	                log::warn!("MeetingPrepSweep: query error: {}", e);
   286	                return;
   287	            }
   288	        };
   289	        stmt.query_map([], |row| row.get::<_, String>(0))
   290	            .ok()
   291	            .map(|rows| rows.filter_map(|r| r.ok()).collect())
   292	            .unwrap_or_default()
   293	    };
   294	
   295	    if meeting_ids.is_empty() {
   296	        log::info!("MeetingPrepSweep: all future meetings have prep");
   297	        return;
   298	    }
   299	
   300	    log::info!(
   301	        "MeetingPrepSweep: enqueuing {} meetings for mechanical prep",
   302	        meeting_ids.len()
   303	    );
   304	
   305	    // db connection dropped automatically when `db` goes out of scope
   306	    drop(db);
   307	
   308	    for mid in &meeting_ids {
   309	        state
   310	            .meeting_prep_queue
   311	            .enqueue(PrepRequest::new(mid.clone(), PrepPriority::Background));
   312	    }
   313	    if !meeting_ids.is_empty() {
   314	        state.integrations.prep_queue_wake.notify_one();
   315	    }
   316	
   317	    log::info!("MeetingPrepSweep: enqueued {} meetings", meeting_ids.len());
   318	}
