   105	    format_time_display_tz(iso, None)
   106	}
   107	
   108	/// Convert an ISO datetime string to human-readable time in the given timezone.
   109	///
   110	/// If `tz` is None, falls back to the system local offset embedded in the timestamp,
   111	/// or UTC if the timestamp has no offset.
   112	pub fn format_time_display_tz(iso: &str, tz: Option<Tz>) -> String {
   113	    if iso.is_empty() || !iso.contains('T') {
   114	        return "All day".to_string();
   115	    }
   116	    match DateTime::parse_from_rfc3339(&iso.replace('Z', "+00:00"))
   117	        .or_else(|_| DateTime::parse_from_rfc3339(iso))
   118	    {
   119	        Ok(dt) => {
   120	            let local = match tz {
   121	                Some(tz) => dt.with_timezone(&tz).format("%-I:%M %p").to_string(),
   122	                None => {
   123	                    // Use system local time
   124	                    let local_dt = dt.with_timezone(&chrono::Local);
   125	                    local_dt.format("%-I:%M %p").to_string()
   126	                }
   127	            };
   128	            local
   129	        }
   130	        Err(_) => {
   131	            if iso.len() >= 16 {
   132	                iso[11..16].to_string()
   133	            } else {
   134	                iso.to_string()
   135	            }
   136	        }
   137	    }
   138	}
