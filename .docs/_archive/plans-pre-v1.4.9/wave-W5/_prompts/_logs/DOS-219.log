   660	/// Write JSON to a file with pretty printing (I64: atomic write).
   661	pub fn write_json(path: &Path, data: &Value) -> Result<(), String> {
   662	    if let Some(parent) = path.parent() {
   663	        fs::create_dir_all(parent)
   664	            .map_err(|e| format!("Failed to create directory {}: {}", parent.display(), e))?;
   665	    }
   666	    let content = serde_json::to_string_pretty(data)
   667	        .map_err(|e| format!("Failed to serialize JSON: {}", e))?;
   668	    crate::util::atomic_write_str(path, &format!("{}\n", content))
   669	        .map_err(|e| format!("Failed to write {}: {}", path.display(), e))
   670	}
