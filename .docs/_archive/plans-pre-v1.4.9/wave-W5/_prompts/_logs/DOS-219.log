    20	use crate::state::AppState;
    21	
    22	/// How often the background processor checks for work.
    23	const POLL_INTERVAL_SECS: u64 = 5;
    24	
    25	/// Debounce window — skip re-queueing the same meeting within this window.
    26	const DEBOUNCE_SECS: u64 = 60;
    27	const MAX_RETRY_ATTEMPTS: u8 = 2;
    28	
    29	/// Priority levels for meeting prep generation.
    30	/// Higher numeric value = higher priority.
    31	#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
    32	pub enum PrepPriority {
    33	    /// Pre-generation from weekly workflow — lowest priority.
    34	    Background = 0,
    35	    /// User opened Week page, meeting has no prep.
    36	    PageLoad = 1,
    37	    /// User clicked Refresh on meeting detail — highest priority.
    38	    Manual = 2,
    39	}
    40	
    41	/// A request to generate prep for a meeting.
    42	#[derive(Debug, Clone)]
    43	pub struct PrepRequest {
    44	    pub meeting_id: String,
    45	    pub priority: PrepPriority,
    46	    pub requested_at: Instant,
    47	    pub attempt: u8,
    48	    pub retry_after: Option<Instant>,
    49	    pub last_error: Option<String>,
    50	    pub overwrite_existing: bool,
    51	}
    52	
    53	impl PrepRequest {
    54	    pub fn new(meeting_id: String, priority: PrepPriority) -> Self {
    55	        Self {
    56	            meeting_id,
    57	            priority,
    58	            requested_at: Instant::now(),
    59	            attempt: 0,
    60	            retry_after: None,
    61	            last_error: None,
    62	            overwrite_existing: false,
    63	        }
    64	    }
    65	
    66	    pub fn overwrite_existing(meeting_id: String, priority: PrepPriority) -> Self {
    67	        Self {
    68	            overwrite_existing: true,
    69	            ..Self::new(meeting_id, priority)
    70	        }
    71	    }
    72	
    73	    fn retry_from(request: &PrepRequest, error: String) -> Option<Self> {
    74	        if !is_retryable_prep_error(&error) || request.attempt >= MAX_RETRY_ATTEMPTS {
    75	            return None;
    76	        }
    77	
    78	        let attempt = request.attempt + 1;
    79	        Some(Self {
    80	            meeting_id: request.meeting_id.clone(),
    81	            priority: request.priority,
    82	            requested_at: Instant::now(),
    83	            attempt,
    84	            retry_after: Some(Instant::now() + Duration::from_secs(retry_delay_secs(attempt))),
    85	            last_error: Some(error),
    86	            overwrite_existing: request.overwrite_existing,
    87	        })
    88	    }
    89	}
    90	
    91	fn retry_delay_secs(attempt: u8) -> u64 {
    92	    match attempt {
    93	        1 => 1,
    94	        2 => 30,
    95	        _ => 900,
    96	    }
    97	}
    98	
    99	fn is_retryable_prep_error(error: &str) -> bool {
   100	    error.contains("Failed to open DB")
   101	        || error.contains("Failed to write prep")
   102	        || error.contains("Config lock poisoned")
   103	        || error.contains("No config")
   104	}
   105	
   106	fn classify_prep_error(error: &str) -> &'static str {
   107	    if error.contains("Failed to write prep") {
   108	        "db_write"
   109	    } else if error.contains("Failed to open DB") || error.contains("lock poisoned") {
   110	        "db_lock"
   111	    } else {
   112	        "context_gather"
   113	    }
   114	}
