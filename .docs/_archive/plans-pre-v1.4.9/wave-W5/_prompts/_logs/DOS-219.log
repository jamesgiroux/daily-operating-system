   732	/// Push a section if the Option is Some and non-empty.
   733	fn push_opt_section(prompt: &mut String, heading: &str, content: &Option<String>) {
   734	    if let Some(ref s) = content {
   735	        if !s.is_empty() {
   736	            prompt.push_str(heading);
   737	            prompt.push('\n');
   738	            prompt.push_str(s);
   739	            prompt.push_str("\n\n");
   740	        }
   741	    }
   742	}
