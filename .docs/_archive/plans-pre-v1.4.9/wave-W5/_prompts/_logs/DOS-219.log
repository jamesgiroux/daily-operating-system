   722	/// Push a section if its content is non-empty.
   723	fn push_section(prompt: &mut String, heading: &str, content: &str) {
   724	    if !content.is_empty() {
   725	        prompt.push_str(heading);
   726	        prompt.push('\n');
   727	        prompt.push_str(content);
   728	        prompt.push_str("\n\n");
   729	    }
   730	}
