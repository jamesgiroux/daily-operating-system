    67	/// Compute staleness from an optional `last_enriched_at` timestamp.
    68	fn compute_staleness(last_enriched_at: Option<&str>) -> Staleness {
    69	    match last_enriched_at {
    70	        None => Staleness::Stale,
    71	        Some(ts) => {
    72	            let enriched = chrono::DateTime::parse_from_rfc3339(ts)
    73	                .or_else(|_| {
    74	                    chrono::NaiveDateTime::parse_from_str(ts, "%Y-%m-%d %H:%M:%S")
    75	                        .map(|naive| naive.and_utc().fixed_offset())
    76	                })
    77	                .ok();
    78	            match enriched {
    79	                None => Staleness::Stale,
    80	                Some(dt) => {
    81	                    let hours = (Utc::now() - dt.with_timezone(&Utc)).num_hours();
    82	                    if hours < 12 {
    83	                        Staleness::Current
    84	                    } else if hours < 48 {
    85	                        Staleness::Aging
    86	                    } else {
    87	                        Staleness::Stale
    88	                    }
    89	                }
    90	            }
    91	        }
    92	    }
    93	}
