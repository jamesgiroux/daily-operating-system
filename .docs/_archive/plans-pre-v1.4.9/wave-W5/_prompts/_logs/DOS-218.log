    51	    Auth(String),
    52	    /// Generic provider error.
    53	    Other(String),
    54	}
    55	
    56	impl fmt::Display for ContextError {
    57	    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
    58	        match self {
