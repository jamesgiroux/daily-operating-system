    85	/// Get all entity context entries for injection into intelligence prompts.
    86	///
    87	/// Unlike user context entries (which use semantic search), entity-specific
    88	/// entries are always relevant to their entity, so we return all of them.
    89	pub fn get_entity_context_for_prompt(
    90	    db: &ActionDb,
    91	    entity_type: &str,
    92	    entity_id: &str,
    93	) -> Vec<(String, String)> {
    94	    match db.conn_ref().prepare(
    95	        "SELECT title, content FROM entity_context_entries
    96	         WHERE entity_type = ?1 AND entity_id = ?2
    97	         ORDER BY created_at DESC",
    98	    ) {
    99	        Ok(mut stmt) => stmt
   100	            .query_map(rusqlite::params![entity_type, entity_id], |row| {
   101	                Ok((row.get::<_, String>(0)?, row.get::<_, String>(1)?))
   102	            })
   103	            .ok()
   104	            .map(|iter| iter.filter_map(|r| r.ok()).collect())
   105	            .unwrap_or_default(),
   106	        Err(_) => Vec::new(),
   107	    }
   108	}
