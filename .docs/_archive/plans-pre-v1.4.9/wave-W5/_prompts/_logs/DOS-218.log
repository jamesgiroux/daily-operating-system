    60	            Self::Timeout(msg) => write!(f, "context timeout: {}", msg),
    61	            Self::Auth(msg) => write!(f, "context auth error: {}", msg),
    62	            Self::Other(msg) => write!(f, "context error: {}", msg),
    63	        }
    64	    }
    65	}
    66	
    67	impl std::error::Error for ContextError {}
