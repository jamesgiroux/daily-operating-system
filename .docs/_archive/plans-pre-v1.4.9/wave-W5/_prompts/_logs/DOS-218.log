   122	    pub user: &'a UserEntity,                   // ADR-0089
   123	    pub tracer: &'a AbilityTracer,              // Observability and audit capture
   124	    pub actor: Actor,                           // Who invoked this ability (User | Agent | System)
   125	    pub confirmation: Option<ConfirmationToken>, // Present when user/policy confirmed; required for Publish

