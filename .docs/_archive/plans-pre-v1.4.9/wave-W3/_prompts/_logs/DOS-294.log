   109	/// Injection seam for non-cryptographic randomness in services / abilities.
   110	///
   111	/// Replaces direct `rand::thread_rng()` / `rand::rng()` calls so Simulate
   112	/// + Evaluate modes can supply deterministic seeded RNGs.
   113	///
   114	/// The trait is dyn-compatible — only object-safe methods. Generic
   115	/// helpers (e.g., `shuffle_in_place<T>`) live as free functions taking
   116	/// `&dyn SeededRng` so the trait stays usable behind a vtable.
   117	pub trait SeededRng: Send + Sync {
   118	    /// Uniform u64.
   119	    fn random_u64(&self) -> u64;
   120	    /// Uniform f64 in [0, 1).
   121	    fn random_f64(&self) -> f64;
   122	}
   123	
   124	/// Shuffle a slice in place via a `&dyn SeededRng`. Fisher-Yates over
   125	/// `random_u64`. Lives outside the trait so the trait stays
   126	/// dyn-compatible (generic methods break vtable construction).
   127	pub fn shuffle_in_place<T>(rng: &dyn SeededRng, slice: &mut [T]) {
   128	    for i in (1..slice.len()).rev() {
   129	        let j = (rng.random_u64() % (i as u64 + 1)) as usize;
   130	        slice.swap(i, j);
   131	    }
   132	}
