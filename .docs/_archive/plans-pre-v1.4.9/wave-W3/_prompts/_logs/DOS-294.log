    34	
    35	/// Execution mode for ability + service workflows per ADR-0104.
    36	#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
    37	pub enum ExecutionMode {
    38	    /// Production runtime — DB writes, signal emissions, external side
    39	    /// effects all execute against live systems.
    40	    Live,
    41	    /// Developer simulation — replay fixtures stand in for external
    42	    /// services; DB writes blocked; signals route to in-memory ring buffer.
    43	    Simulate,
    44	    /// Evaluation harness (DOS-216 / ADR-0110) — fixture DB; live writes
    45	    /// + LLM calls structurally forbidden; replay-only providers.
    46	    Evaluate,
    47	}
    48	
    49	impl ExecutionMode {
    50	    pub fn as_str(self) -> &'static str {
    51	        match self {
    52	            ExecutionMode::Live => "live",
    53	            ExecutionMode::Simulate => "simulate",
    54	            ExecutionMode::Evaluate => "evaluate",
    55	        }
    56	    }
    57	
    58	    /// True iff this mode permits live mutations.
    59	    pub fn permits_writes(self) -> bool {
    60	        matches!(self, ExecutionMode::Live)
    61	    }
    62	}
