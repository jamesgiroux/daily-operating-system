     1	//! DOS-209 (W2-A): `ServiceContext` substrate per ADR-0104.
     2	//!
     3	//! ## What this module owns
     4	//!
     5	//! - `ExecutionMode { Live | Simulate | Evaluate }` — the mode-routing enum
     6	//!   every service mutation gates against via `ctx.check_mutation_allowed()?`.
     7	//! - `Clock` + `SeededRng` traits — injection seams replacing direct
     8	//!   `Utc::now()` / `rand::thread_rng()` in service + ability code.
     9	//! - `ServiceContext<'a>` — per-call carrier with public read capabilities
    10	//!   (`mode`, `clock`, `rng`, `external`) and `pub(in crate::services)`
    11	//!   service-internal fields.
    12	//! - `ExternalClients` — named wrapper struct for `glean` / `slack` /
    13	//!   `gmail` / `salesforce`; live in `Live`, replay/fixture in
    14	//!   `Simulate`/`Evaluate`.
    15	//! - `TxCtx<'tx>` — transaction-scoped context. Has no external clients
    16	//!   and no `IntelligenceProvider` per ADR-0104's ban on external/LLM
    17	//!   calls inside transactions.
    18	//! - `ServiceError` — service-layer error surface with
    19	//!   `WriteBlockedByMode(ExecutionMode)` + `NestedTransactionsForbidden`.
    20	//!
    21	//! ## What this module does NOT own
    22	//!
    23	//! - The 228-mutator catalogue (`src-tauri/tests/dos209_mutation_catalog.txt`)
    24	//!   ships alongside the per-mutator `check_mutation_allowed()?` migration.
    25	//! - The `IntelligenceProvider` seam — W2-B / DOS-259 owns that on
    26	//!   `AbilityContext`, not `ServiceContext`.
    27	//! - DB plumbing — `with_transaction_async` lands in a follow-up phase
    28	//!   once the mutator migration starts.
    29	
    30	use std::sync::Arc;
    31	
    32	use chrono::{DateTime, Utc};
    33	use parking_lot::Mutex;
    34	
    35	/// Execution mode for ability + service workflows per ADR-0104.
    36	#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
    37	pub enum ExecutionMode {
    38	    /// Production runtime — DB writes, signal emissions, external side
    39	    /// effects all execute against live systems.
    40	    Live,
    41	    /// Developer simulation — replay fixtures stand in for external
    42	    /// services; DB writes blocked; signals route to in-memory ring buffer.
    43	    Simulate,
    44	    /// Evaluation harness (DOS-216 / ADR-0110) — fixture DB; live writes
    45	    /// + LLM calls structurally forbidden; replay-only providers.
    46	    Evaluate,
    47	}
    48	
    49	impl ExecutionMode {
    50	    pub fn as_str(self) -> &'static str {
    51	        match self {
    52	            ExecutionMode::Live => "live",
    53	            ExecutionMode::Simulate => "simulate",
    54	            ExecutionMode::Evaluate => "evaluate",
    55	        }
    56	    }
    57	
    58	    /// True iff this mode permits live mutations.
    59	    pub fn permits_writes(self) -> bool {
    60	        matches!(self, ExecutionMode::Live)
    61	    }
    62	}
    63	
    64	/// Injection seam for wall-clock reads in services / abilities.
    65	///
    66	/// Replaces direct `Utc::now()` / `chrono::Utc::now()` calls so Simulate
    67	/// + Evaluate modes can supply deterministic clocks (per ADR-0104 §3.2).
    68	pub trait Clock: Send + Sync {
    69	    fn now(&self) -> DateTime<Utc>;
    70	}
    71	
    72	/// Default `Clock` reading the system wall clock. Used by `new_live`.
    73	#[derive(Debug, Clone, Copy, Default)]
    74	pub struct SystemClock;
    75	
    76	impl Clock for SystemClock {
    77	    fn now(&self) -> DateTime<Utc> {
    78	        // dos209-exempt: Live-mode SystemClock by definition reads wall clock.
    79	        Utc::now()
    80	    }
    81	}
    82	
    83	/// Fixed clock for tests + Simulate / Evaluate modes.
    84	pub struct FixedClock {
    85	    now: Mutex<DateTime<Utc>>,
    86	}
    87	
    88	impl FixedClock {
    89	    pub fn new(at: DateTime<Utc>) -> Self {
    90	        Self { now: Mutex::new(at) }
    91	    }
    92	
    93	    pub fn advance(&self, delta: chrono::Duration) {
    94	        let mut guard = self.now.lock();
    95	        *guard += delta;
    96	    }
    97	
    98	    pub fn set(&self, at: DateTime<Utc>) {
    99	        *self.now.lock() = at;
   100	    }
   101	}
   102	
   103	impl Clock for FixedClock {
   104	    fn now(&self) -> DateTime<Utc> {
   105	        *self.now.lock()
   106	    }
   107	}
   108	
   109	/// Injection seam for non-cryptographic randomness in services / abilities.
   110	///
   111	/// Replaces direct `rand::thread_rng()` / `rand::rng()` calls so Simulate
   112	/// + Evaluate modes can supply deterministic seeded RNGs.
   113	///
   114	/// The trait is dyn-compatible — only object-safe methods. Generic
   115	/// helpers (e.g., `shuffle_in_place<T>`) live as free functions taking
   116	/// `&dyn SeededRng` so the trait stays usable behind a vtable.
   117	pub trait SeededRng: Send + Sync {
   118	    /// Uniform u64.
   119	    fn random_u64(&self) -> u64;
   120	    /// Uniform f64 in [0, 1).
   121	    fn random_f64(&self) -> f64;
   122	}
   123	
   124	/// Shuffle a slice in place via a `&dyn SeededRng`. Fisher-Yates over
   125	/// `random_u64`. Lives outside the trait so the trait stays
   126	/// dyn-compatible (generic methods break vtable construction).
   127	pub fn shuffle_in_place<T>(rng: &dyn SeededRng, slice: &mut [T]) {
   128	    for i in (1..slice.len()).rev() {
   129	        let j = (rng.random_u64() % (i as u64 + 1)) as usize;
   130	        slice.swap(i, j);
   131	    }
   132	}
   133	
   134	/// System-RNG implementation for `Live` mode. Wraps `rand::random` so
   135	/// production behavior is unchanged.
   136	#[derive(Debug, Default)]
   137	pub struct SystemRng;
   138	
   139	impl SeededRng for SystemRng {
   140	    fn random_u64(&self) -> u64 {
   141	        // dos209-exempt: Live-mode SystemRng wraps the system RNG by definition.
   142	        rand::random::<u64>()
   143	    }
   144	
   145	    fn random_f64(&self) -> f64 {
   146	        // dos209-exempt: Live-mode SystemRng wraps the system RNG by definition.
   147	        rand::random::<f64>()
   148	    }
   149	}
   150	
   151	/// Deterministic seeded RNG for tests + Simulate / Evaluate.
   152	pub struct SeedableRng {
   153	    state: Mutex<u64>,
   154	}
   155	
   156	impl SeedableRng {
   157	    pub fn new(seed: u64) -> Self {
   158	        Self {
   159	            state: Mutex::new(seed.max(1)),
   160	        }
   161	    }
   162	}
   163	
   164	impl SeededRng for SeedableRng {
   165	    fn random_u64(&self) -> u64 {
   166	        // xorshift64* — fast, deterministic, sufficient for non-crypto needs.
   167	        let mut s = self.state.lock();
   168	        let mut x = *s;
   169	        x ^= x >> 12;
   170	        x ^= x << 25;
   171	        x ^= x >> 27;
   172	        *s = x;
   173	        x.wrapping_mul(0x2545_F491_4F6C_DD1D)
   174	    }
   175	
   176	    fn random_f64(&self) -> f64 {
   177	        let n = self.random_u64();
   178	        (n >> 11) as f64 / ((1u64 << 53) as f64)
   179	    }
   180	}

