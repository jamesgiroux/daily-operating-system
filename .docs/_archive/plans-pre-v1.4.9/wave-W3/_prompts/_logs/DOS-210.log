    36	    // Identity
    37	    pub invocation_id: InvocationId,          // ULID, one per top-level ability invocation
    38	    pub span_id: SpanId,                       // Nested span within the invocation
    39	    pub parent_span_id: Option<SpanId>,        // Composition parent
    40	    pub kind: InvocationKind,                  // Ability | Service | Worker | ProviderCall | SignalEmit
    41	
    42	    // Identity of the thing being invoked
    43	    pub name: String,                          // e.g., "prepare_meeting", "services::claims::commit_claim"
    44	    pub version: Option<String>,               // Ability version, service fn version, provider model, etc.
    45	
    46	    // Outcome
    47	    pub outcome: Outcome,                      // Success | Error | Warn | Skipped
