   193	/// Core provider trait. Send + Sync so `Arc<dyn IntelligenceProvider>`
   194	/// can move across tasks freely (per ADR-0091).
   195	#[async_trait]
   196	pub trait IntelligenceProvider: Send + Sync {
   197	    /// Run a completion at the given tier.
   198	    async fn complete(
   199	        &self,
   200	        prompt: PromptInput,
   201	        tier: ModelTier,
   202	    ) -> Result<Completion, ProviderError>;
   203	
   204	    /// Report which `ProviderKind` this implementation is.
   205	    fn provider_kind(&self) -> ProviderKind;
   206	
   207	    /// Report the model name that would be used for the given tier.
   208	    fn current_model(&self, tier: ModelTier) -> ModelName;
   209	}
   210	
   211	/// Stable hash of a prompt's text used for `ReplayProvider` lookups.
   212	///
   213	/// W2-B uses a SHA-256 of the rendered prompt text. DOS-213 lands a
   214	/// canonical-prompt hash that includes template id + parameter values
   215	/// for production fingerprinting; this is the W2-B-only hook.
   216	pub fn prompt_replay_hash(prompt: &PromptInput) -> String {
   217	    use sha2::{Digest, Sha256};
   218	    let mut hasher = Sha256::new();
   219	    hasher.update(prompt.text.as_bytes());
   220	    if let Some(ref id) = prompt.template_id {
   221	        hasher.update(b"\0template_id=");
   222	        hasher.update(id.as_bytes());
   223	    }
   224	    hex::encode(hasher.finalize())
   225	}
   226	
   227	/// In-memory replay provider for tests + `Evaluate` mode.
   228	///
   229	/// Stores `(hash, completion)` pairs supplied at construction. On
   230	/// `complete()`, hashes the incoming `PromptInput.text` and looks it up;
   231	/// returns `ProviderError::ReplayFixtureMissing` if absent — never falls
   232	/// through to a live path.
   233	pub struct ReplayProvider {
   234	    fixtures: std::collections::HashMap<String, Completion>,
   235	    provider_kind: ProviderKind,
   236	    model_for_tier: std::collections::HashMap<ModelTier, ModelName>,
   237	}
   238	
   239	impl ReplayProvider {
   240	    /// Build a replay provider from a `(hash → completion)` map.
   241	    pub fn new(fixtures: std::collections::HashMap<String, Completion>) -> Self {
   242	        Self {
   243	            fixtures,
   244	            provider_kind: ProviderKind::Other("replay"),
   245	            model_for_tier: std::collections::HashMap::new(),
   246	        }
   247	    }
   248	
   249	    /// Convenience: build a replay provider from `(prompt_text → text)` pairs,
   250	    /// hashing each prompt with `prompt_replay_hash`.
   251	    pub fn from_prompt_pairs<I, P, T>(pairs: I) -> Self
   252	    where
   253	        I: IntoIterator<Item = (P, T)>,
   254	        P: Into<String>,
   255	        T: Into<String>,
   256	    {
   257	        let mut fixtures = std::collections::HashMap::new();
   258	        for (prompt_text, completion_text) in pairs {
   259	            let p = PromptInput::new(prompt_text);
   260	            let key = prompt_replay_hash(&p);
   261	            fixtures.insert(
   262	                key,
   263	                Completion {
   264	                    text: completion_text.into(),
   265	                    fingerprint_metadata: FingerprintMetadata::default(),
   266	                },
   267	            );
   268	        }
   269	        Self::new(fixtures)
   270	    }
