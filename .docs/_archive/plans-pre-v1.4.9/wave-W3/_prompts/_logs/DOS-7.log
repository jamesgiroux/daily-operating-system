    61	    pi.projection_target,
    62	    tc.dismissed_at,
    63	    pi.sourced_at,
    64	    -- Indicate which match path fired so operators can spot data drift.
    65	    CASE
    66	        WHEN pi.dedup_key IS NOT NULL
