    64	    /// I645: Check if an intelligence item is suppressed by a tombstone.
    65	    ///
    66	    /// Returns `true` if a matching tombstone exists for the given entity/field/item
    67	    /// AND the item does NOT have newer evidence (sourced_at > dismissed_at).
    68	    /// If `sourced_at` is provided and is newer than the tombstone's `dismissed_at`,
    69	    /// the item is NOT suppressed (new evidence supersedes the dismissal).
    70	    pub fn is_suppressed(
    71	        &self,
    72	        entity_id: &str,
    73	        field_key: &str,
    74	        item_key: Option<&str>,
    75	        sourced_at: Option<&str>,
    76	    ) -> Result<bool, String> {
    77	        let conn = self.conn_ref();
    78	        // Find matching tombstone that hasn't expired
    79	        let result: Option<String> = conn
    80	            .query_row(
    81	                "SELECT dismissed_at FROM suppression_tombstones \
    82	                 WHERE entity_id = ?1 AND field_key = ?2 AND item_key = ?3 \
    83	                 AND (expires_at IS NULL OR expires_at > datetime('now'))",
    84	                rusqlite::params![entity_id, field_key, item_key],
    85	                |row| row.get(0),
    86	            )
    87	            .ok();
    88	
    89	        match result {
    90	            None => Ok(false), // No tombstone found
    91	            Some(dismissed_at) => {
    92	                // If the item has newer evidence, it should pass through
    93	                if let Some(src_at) = sourced_at {
    94	                    if src_at > dismissed_at.as_str() {
    95	                        return Ok(false);
    96	                    }
    97	                }
    98	                Ok(true)
    99	            }
   100	        }
   101	    }
