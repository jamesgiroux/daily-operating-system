   116	
   117	    /// Get feedback events for an entity, newest first.
   118	    pub fn get_feedback_events(
   119	        &self,
   120	        entity_id: &str,
   121	        limit: usize,
   122	    ) -> Result<Vec<FeedbackEvent>, DbError> {
   123	        let mut stmt = self.conn_ref().prepare(
   124	            "SELECT id, entity_id, entity_type, field_key, item_key, feedback_type, \
   125	             source_system, source_kind, previous_value, corrected_value, reason, created_at \
   126	             FROM entity_feedback_events \
   127	             WHERE entity_id = ?1 \
   128	             ORDER BY created_at DESC \
   129	             LIMIT ?2",
   130	        )?;
   131	
   132	        let rows = stmt.query_map(params![entity_id, limit as i64], |row| {
   133	            Ok(FeedbackEvent {
   134	                id: row.get(0)?,
   135	                entity_id: row.get(1)?,
   136	                entity_type: row.get(2)?,
   137	                field_key: row.get(3)?,
   138	                item_key: row.get(4)?,
   139	                feedback_type: row.get(5)?,
   140	                source_system: row.get(6)?,
   141	                source_kind: row.get(7)?,
   142	                previous_value: row.get(8)?,
   143	                corrected_value: row.get(9)?,
   144	                reason: row.get(10)?,
   145	                created_at: row.get(11)?,
   146	            })
   147	        })?;
   148	
   149	        let mut events = Vec::new();
   150	        for row in rows {
   151	            events.push(row?);
   152	        }
   153	        Ok(events)
   154	    }
