   140	pub fn bump_schema_epoch(db: &ActionDb) -> Result<i64, String> {
   141	    db.conn_ref()
   142	        .execute(
   143	            "UPDATE migration_state SET value = value + 1 WHERE key = 'schema_epoch'",
   144	            [],
   145	        )
   146	        .map_err(|e| format!("bump_schema_epoch UPDATE: {e}"))?;
   147	    let new_value: i64 = db
   148	        .conn_ref()
   149	        .query_row(
   150	            "SELECT value FROM migration_state WHERE key = 'schema_epoch'",
   151	            [],
   152	            |r| r.get(0),
   153	        )
   154	        .map_err(|e| format!("bump_schema_epoch read-back: {e}"))?;
   155	    Ok(new_value)
   156	}
   157	
   158	/// Errors from the write fence.
   159	#[derive(Debug)]
   160	pub enum FenceError {
   161	    /// `migration_state.schema_epoch` could not be read.
   162	    DbRead(String),
   163	    /// The epoch advanced between [`FenceCycle::capture`] and the write.
   164	    /// The write was NOT performed; caller logs + re-queues.
   165	    EpochAdvanced { captured: i64, current: i64 },
   166	    /// The underlying [`write_intelligence_json`] call failed (disk full,
   167	    /// permissions, etc.). Treat as best-effort cache write per the
   168	    /// post-W0 DB-first contract.
   169	    WriteFailed(String),
   170	}
   171	
   172	impl std::fmt::Display for FenceError {
   173	    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
   174	        match self {
   175	            Self::DbRead(e) => write!(f, "fence DB read failed: {e}"),
   176	            Self::EpochAdvanced { captured, current } => write!(
   177	                f,
   178	                "fence epoch advanced (captured={captured}, current={current}); \
   179	                 migration ran mid-cycle; caller should re-queue work"
   180	            ),
   181	            Self::WriteFailed(e) => write!(f, "fence-wrapped write_intelligence_json failed: {e}"),
   182	        }
   183	    }
   184	}
   185	
   186	impl std::error::Error for FenceError {}
   187	
   188	/// Convenience wrapper for post-commit cache writes (DOS-309 W0 pattern).
   189	/// Captures a fresh [`FenceCycle`], writes through the fence, and logs at
   190	/// `warn!` level on any failure — never returns an error to the caller.
   191	/// DB is canonical; the legacy `intelligence.json` cache is best-effort.
   192	///
   193	/// Use this from service-layer post-commit write paths
   194	/// (`services/intelligence.rs`). The intel-queue worker uses the explicit
   195	/// `FenceCycle::capture` + `fenced_write_intelligence_json` flow so it can
   196	/// surface `EpochAdvanced` as a re-queue signal.
   197	pub fn post_commit_fenced_write(
   198	    db: &ActionDb,
   199	    dir: &Path,
   200	    intel: &IntelligenceJson,
   201	    entity_context: &str,
   202	) {
   203	    let cycle = match FenceCycle::capture(db) {
   204	        Ok(c) => c,
   205	        Err(e) => {
   206	            log::warn!(
   207	                "post-commit fenced write skipped (capture failed); \
   208	                 repair_target=projection_writer (DOS-301) \
   209	                 {entity_context}: {e}"
   210	            );
   211	            return;
   212	        }
   213	    };
   214	    if let Err(e) = fenced_write_intelligence_json(&cycle, db, dir, intel) {
   215	        log::warn!(
   216	            "post-commit fenced write failed; \
   217	             repair_target=projection_writer (DOS-301) \
   218	             {entity_context}: {e}"
   219	        );
   220	    }
   221	}
   222	
   223	/// Write `intelligence.json` IF the schema_epoch is unchanged since
   224	/// `cycle.capture`. Otherwise return [`FenceError::EpochAdvanced`].
   225	///
   226	/// This is the universal write fence: every production caller of
   227	/// `write_intelligence_json` SHOULD route through this function. The bash
   228	/// CI lint `scripts/check_write_fence_usage.sh` enforces (post-W3 cleanup
   229	/// removes any transitional allowlist entries).
   230	#[must_use = "fence-wrapped write results must be propagated; silent discard regresses cutover safety"]
   231	pub fn fenced_write_intelligence_json(
   232	    cycle: &FenceCycle,
   233	    db: &ActionDb,
   234	    dir: &Path,
   235	    intel: &IntelligenceJson,
   236	) -> Result<(), FenceError> {
   237	    cycle.recheck(db)?;
   238	    write_intelligence_json(dir, intel).map_err(FenceError::WriteFailed)
   239	}
