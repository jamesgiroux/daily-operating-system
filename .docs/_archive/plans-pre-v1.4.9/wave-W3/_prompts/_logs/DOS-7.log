     7	/// DOS-41: Correction actions a user can take on an AI-surfaced intelligence field.
     8	///
     9	/// Persisted in `entity_feedback_events.feedback_type` as a snake_case string.
    10	/// Each action has distinct downstream semantics in `services::feedback`:
    11	///
    12	/// - `Confirmed` → positive signal, rewards the source via Bayesian alpha++
    13	/// - `Rejected` → negative feedback without suppressing the content; used by
    14	///   legacy thumbs-down surfaces that should penalize a source but leave the
    15	///   item visible.
    16	/// - `Annotated` → user note stored in `reason`, threaded into next intel prompt
    17	/// - `Corrected` → `previous_value` + `corrected_value` captured; penalizes source
    18	///   via Bayesian beta++; triggers health recalc when field is health-affecting.
    19	/// - `Dismissed` → negative feedback + suppression tombstone for a claim the
    20	///   user marked wrong; the current surface should hide it immediately.
    21	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    22	pub enum CorrectionAction {
    23	    Confirmed,
    24	    Rejected,
    25	    Annotated,
    26	    Corrected,
    27	    Dismissed,
    28	}
    29	
    30	impl CorrectionAction {
    31	    /// String form persisted in `entity_feedback_events.feedback_type`.
    32	    pub fn as_str(&self) -> &'static str {
    33	        match self {
    34	            CorrectionAction::Confirmed => "confirmed",
    35	            CorrectionAction::Rejected => "rejected",
    36	            CorrectionAction::Annotated => "annotated",
    37	            CorrectionAction::Corrected => "corrected",
    38	            CorrectionAction::Dismissed => "dismissed",
    39	        }
    40	    }
    41	
    42	    /// Parse the wire-format action string coming from the Tauri command.
    43	    pub fn parse(raw: &str) -> Result<Self, String> {
    44	        match raw {
