     1	//! DOS-311: schema-epoch fence for `intelligence.json` writes.
     2	//!
     3	//! The fence prevents stale writes during the W3 / DOS-7 cutover. The flow:
     4	//!
     5	//! 1. A worker captures the current `migration_state.schema_epoch` at
     6	//!    job pickup via [`FenceCycle::capture`].
     7	//! 2. The worker does its enrichment / mutation work (potentially seconds
     8	//!    to minutes for PTY/Glean paths).
     9	//! 3. Before writing `intelligence.json`, the worker passes its `FenceCycle`
    10	//!    to [`fenced_write_intelligence_json`]. The fence re-reads the epoch;
    11	//!    if it has advanced (because DOS-7's migration ran mid-flight), the
    12	//!    write is rejected with [`FenceError::EpochAdvanced`].
    13	//! 4. The caller treats `EpochAdvanced` as a soft skip: log, do not roll
    14	//!    back DB state (DB is canonical), and re-enqueue the work for the
    15	//!    next cycle.
    16	//!
    17	//! ## Cross-issue dependency note
    18	//!
    19	//! The live DOS-311 ticket also requires `--repair` mode that consumes
    20	//! `services/claims.rs::commit_claim` (DOS-7) and a reconcile pass over
    21	//! `intelligence_claims` (DOS-7 schema). Both ship in W3. This module
    22	//! ships the substrate primitive (epoch capture + recheck on write); the
    23	//! reconcile + repair binary land alongside DOS-7.
    24	
    25	use std::path::Path;
    26	use std::sync::atomic::{AtomicUsize, Ordering};
    27	use std::time::{Duration, Instant};
    28	
    29	use crate::db::ActionDb;
    30	use crate::intelligence::io::{write_intelligence_json, IntelligenceJson};
    31	
    32	/// Process-wide count of active [`FenceCycle`] handles. Incremented in
    33	/// `FenceCycle::capture`, decremented in `Drop`. Migration code blocks on
    34	/// [`drain_with_timeout`] until this returns to zero (or times out).
    35	///
    36	/// This is the in-flight writer registry that closes the TOCTOU window
    37	/// between `recheck()` and the actual file write: a worker that already
    38	/// captured an epoch has registered itself, so the migration's drain
    39	/// phase waits for it to complete before bumping.
    40	static IN_FLIGHT_CYCLES: AtomicUsize = AtomicUsize::new(0);
    41	
    42	/// Snapshot of the current in-flight cycle count. Used by tests +
    43	/// migration diagnostics.
    44	pub fn in_flight_cycle_count() -> usize {
    45	    IN_FLIGHT_CYCLES.load(Ordering::SeqCst)
    46	}
    47	
    48	/// Captured schema_epoch at start of a write cycle. Pass to
    49	/// [`fenced_write_intelligence_json`] to commit a write only if the epoch
    50	/// has not advanced.
    51	///
    52	/// `FenceCycle` is RAII: `capture` increments the in-flight cycle counter,
    53	/// `Drop` decrements it. Migration code blocks on [`drain_with_timeout`]
    54	/// until the counter returns to zero, ensuring no in-flight worker can
    55	/// write stale state after the epoch bump.
    56	#[derive(Debug)]
    57	pub struct FenceCycle {
    58	    captured_epoch: i64,
    59	}
    60	
    61	impl Drop for FenceCycle {
    62	    fn drop(&mut self) {
    63	        IN_FLIGHT_CYCLES.fetch_sub(1, Ordering::SeqCst);
    64	    }
    65	}
    66	
    67	impl FenceCycle {
    68	    /// Read the current `migration_state.schema_epoch` and bind it to a
    69	    /// `FenceCycle` handle. Workers call this at job pickup; the handle
    70	    /// flows through enrichment until write-back.
    71	    pub fn capture(db: &ActionDb) -> Result<Self, String> {
    72	        let captured_epoch: i64 = db
    73	            .conn_ref()
    74	            .query_row(
    75	                "SELECT value FROM migration_state WHERE key = 'schema_epoch'",
    76	                [],
    77	                |r| r.get(0),
    78	            )
    79	            .map_err(|e| format!("schema_epoch capture: {e}"))?;
    80	        // Register in-flight: migration drain waits for this to drop before bumping.
    81	        IN_FLIGHT_CYCLES.fetch_add(1, Ordering::SeqCst);
    82	        Ok(Self { captured_epoch })
    83	    }
    84	
    85	    /// The captured epoch value. Useful for diagnostics; callers normally
    86	    /// pass the whole [`FenceCycle`] to [`fenced_write_intelligence_json`].
    87	    pub fn captured_epoch(&self) -> i64 {
    88	        self.captured_epoch
    89	    }
    90	
    91	    /// Re-read the current epoch and compare against the captured value.
    92	    /// `Ok(())` if unchanged; `Err(FenceError::EpochAdvanced)` otherwise.
    93	    pub fn recheck(&self, db: &ActionDb) -> Result<(), FenceError> {
    94	        let current: i64 = db
    95	            .conn_ref()
    96	            .query_row(
    97	                "SELECT value FROM migration_state WHERE key = 'schema_epoch'",
    98	                [],
    99	                |r| r.get(0),
   100	            )
   101	            .map_err(|e| FenceError::DbRead(e.to_string()))?;
   102	        if current != self.captured_epoch {
   103	            return Err(FenceError::EpochAdvanced {
   104	                captured: self.captured_epoch,
   105	                current,
   106	            });
   107	        }
   108	        Ok(())
   109	    }
   110	}
