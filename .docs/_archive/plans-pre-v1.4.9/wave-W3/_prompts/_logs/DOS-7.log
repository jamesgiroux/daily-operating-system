   119	///
   120	/// Polls every 50ms; cheap because the in-flight count is an atomic load.
   121	pub fn drain_with_timeout(timeout: Duration) -> Result<usize, usize> {
   122	    let deadline = Instant::now() + timeout;
   123	    let poll_interval = Duration::from_millis(50);
