   174	                field_key: row.get(2)?,
   175	                item_key: row.get(3)?,
   176	                item_hash: row.get(4)?,
   177	                dismissed_at: row.get(5)?,
   178	                source_scope: row.get(6)?,
   179	                expires_at: row.get(7)?,
   180	                superseded_by_evidence_after: row.get(8)?,
   181	            })
   182	        })?;
   183	
   184	        let mut tombstones = Vec::new();
   185	        for row in rows {
   186	            tombstones.push(row?);
