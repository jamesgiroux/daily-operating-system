.docs/plans/wave-W3/_prompts/_logs/DOS-7.log:6030:    40	-- this out explicitly: "(dedup_key OR item_hash)".
.docs/plans/wave-W3/_prompts/_logs/DOS-7.log:6037:    47	        dedup_key,
.docs/plans/wave-W3/_prompts/_logs/DOS-7.log:6039:    49	        source_asof,
.docs/plans/wave-W3/_prompts/_logs/DOS-7.log:6041:    51	    FROM intelligence_claims
.docs/plans/wave-W3/_prompts/_logs/DOS-7.log:6042:    52	    WHERE claim_state = 'tombstoned'
.docs/plans/wave-W3/_prompts/_logs/DOS-7.log:6049:    59	    pi.dedup_key,
.docs/plans/wave-W3/_prompts/_logs/DOS-7.log:6056:    66	        WHEN pi.dedup_key IS NOT NULL
.docs/plans/wave-W3/_prompts/_logs/DOS-7.log:6057:    67	             AND tc.dedup_key IS NOT NULL
