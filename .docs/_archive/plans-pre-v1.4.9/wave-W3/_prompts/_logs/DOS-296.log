    39	use rusqlite::params;
    40	
    41	use crate::db::{ActionDb, DbError};
    42	
    43	/// Subject of a claim. DOS-7's `commit_claim` constructs this from the
    44	/// claim's `subject_ref` JSON column and passes to `bump_for_subject`.
    45	///
    46	/// Variants are listed in the entity-type lock-order precedence:
    47	/// `Account < Meeting < Person < Project`. The `Multi` variant carries a
    48	/// `Vec<SubjectRef>` that is sorted via `entity_type_order()` + `id` before
    49	/// bumping, providing deterministic update ordering across concurrent commits.
    50	///
    51	/// # Spine restriction
    52	///
    53	/// `Global` is structurally available, but v1.4.0 spine MUST NOT register any
    54	/// `claim_type` whose `canonical_subject_types` contains `SubjectType::Global`.
    55	/// This is enforced at the CLAIM_TYPE_REGISTRY layer (DOS-7 / ADR-0125), not
    56	/// here.
    57	#[derive(Debug, Clone, PartialEq, Eq, Hash)]
    58	pub enum SubjectRef {
    59	    Account { id: String },
    60	    Meeting { id: String },
    61	    Person { id: String },
    62	    Project { id: String },
    63	    /// Multiple entities affected by one claim. Sorted before bumping.
    64	    Multi(Vec<SubjectRef>),
    65	    /// v1.4.1+ only; bumps `migration_state.global_claim_epoch` instead of
    66	    /// per-entity counters.
    67	    ///
    68	    /// **Spine restriction (v1.4.0):** production code MUST NOT construct
    69	    /// this variant. Match arms for it (in `bump_for_subject`,
    70	    /// `entity_type_order`, `id_str`) are permitted because they only
    71	    /// route the variant to the correct epoch path; there is no
    72	    /// production caller that builds a `SubjectRef::Global` value to pass
    73	    /// in. Construction is enforced by the bash lint at
    74	    /// `scripts/check_no_global_subject_in_spine.sh` (CI-time) until
    75	    /// DOS-7 (ADR-0125) introduces the `CLAIM_TYPE_REGISTRY` and a
    76	    /// stronger compile-time guard via `canonical_subject_types`.
    77	    Global,
    78	}
    79	
    80	impl SubjectRef {
    81	    /// Lock-order precedence: `Account < Meeting < Person < Project`. Used
    82	    /// to sort `Multi` subjects before bumping so concurrent commits with
    83	    /// reversed orderings produce deterministic update sequences.
    84	    ///
    85	    /// `Multi` and `Global` panic if compared via this method — they are
    86	    /// resolved at a higher level (`bump_for_subject` dispatches).
    87	    fn entity_type_order(&self) -> u8 {
    88	        match self {
    89	            Self::Account { .. } => 0,
    90	            Self::Meeting { .. } => 1,
    91	            Self::Person { .. } => 2,
    92	            Self::Project { .. } => 3,
    93	            Self::Multi(_) | Self::Global => {
    94	                debug_assert!(
    95	                    false,
    96	                    "entity_type_order() called on Multi/Global; should be flattened first",
    97	                );
    98	                u8::MAX
    99	            }
   100	        }
   101	    }
   102	
   103	    fn id_str(&self) -> &str {
   104	        match self {
   105	            Self::Account { id }
   106	            | Self::Meeting { id }
   107	            | Self::Person { id }
   108	            | Self::Project { id } => id.as_str(),
   109	            Self::Multi(_) | Self::Global => "",
   110	        }
   111	    }
   112	}
   113	
   114	impl ActionDb {
   115	    /// Bump the `claim_version` for a single entity.
   116	    ///
   117	    /// Returns the number of rows affected (0 if the entity doesn't exist).
   118	    /// Unknown entity IDs are NOT a hard error — DOS-7's `commit_claim`
   119	    /// inserts the claim row even if the subject entity is being deleted
   120	    /// concurrently; the caller logs and proceeds. SQLite UPDATE on a
   121	    /// non-existent ID silently affects 0 rows.
   122	    ///
   123	    /// MUST be called inside an active transaction (`with_transaction`
   124	    /// closure). The bump runs as part of the same transactional unit as
   125	    /// the claim insert.
   126	    #[must_use = "claim invalidation results must be propagated"]
   127	    pub fn bump_entity_claim_version(
   128	        &self,
   129	        subject: &SubjectRef,
   130	    ) -> Result<usize, DbError> {
   131	        let (table, id) = match subject {
   132	            SubjectRef::Account { id } => ("accounts", id.as_str()),
   133	            SubjectRef::Project { id } => ("projects", id.as_str()),
   134	            SubjectRef::Person { id } => ("people", id.as_str()),
   135	            SubjectRef::Meeting { id } => ("meetings", id.as_str()),
   136	            SubjectRef::Multi(_) | SubjectRef::Global => {
   137	                return Err(DbError::InvalidArgument(
   138	                    "bump_entity_claim_version called with Multi/Global; \
   139	                     use bump_for_subject which dispatches"
   140	                        .to_string(),
   141	                ))
   142	            }
   143	        };
   144	        let sql = format!(
   145	            "UPDATE {} SET claim_version = claim_version + 1 WHERE id = ?1",
   146	            table
   147	        );
   148	        let affected = self.conn_ref().execute(&sql, params![id])?;
   149	        Ok(affected)
   150	    }
   151	
   152	    /// Bump `migration_state.global_claim_epoch`. Used for `SubjectRef::Global`
   153	    /// claims.
   154	    ///
   155	    /// **Spine restriction**: v1.4.0 spine does not register any `claim_type`
   156	    /// with `canonical_subject_types` containing `Global`. Calling this from
   157	    /// spine production code is a category error caught by the
   158	    /// `CLAIM_TYPE_REGISTRY` lint (DOS-7 / ADR-0125 era).
   159	    #[must_use = "claim invalidation results must be propagated"]
   160	    pub fn bump_global_claim_epoch(&self) -> Result<(), DbError> {
   161	        self.conn_ref().execute(
   162	            "UPDATE migration_state SET value = value + 1 WHERE key = 'global_claim_epoch'",
   163	            [],
   164	        )?;
   165	        Ok(())
   166	    }
   167	
   168	    /// Dispatches `SubjectRef` variants to the correct bump path.
   169	    ///
   170	    /// `Multi(refs)` sorts the inner subjects by `(entity_type_order, id)`
   171	    /// (precedence: `Account < Meeting < Person < Project`) before bumping.
   172	    /// Sorting provides deterministic update ordering: concurrent commits
   173	    /// with `Multi([A, B])` and `Multi([B, A])` produce the same UPDATE
   174	    /// sequence (`A`, `B`), so SQLite's serialized writer never sees
   175	    /// reversed-order conflicts.
   176	    ///
   177	    /// MUST be called inside an active transaction. The bump runs as part
   178	    /// of the same transactional unit as the claim insert.
   179	    #[must_use = "claim invalidation results must be propagated"]
   180	    pub fn bump_for_subject(&self, subject: &SubjectRef) -> Result<(), DbError> {
   181	        match subject {
   182	            SubjectRef::Account { .. }
   183	            | SubjectRef::Project { .. }
   184	            | SubjectRef::Person { .. }
   185	            | SubjectRef::Meeting { .. } => {
   186	                self.bump_entity_claim_version(subject)?;
   187	                Ok(())
   188	            }
   189	            SubjectRef::Multi(refs) => {
   190	                // Validate the Multi contents BEFORE sorting: nested Multi or
   191	                // Global within Multi are contract violations. Sorting first
   192	                // would call entity_type_order() on these illegal variants
   193	                // and panic in debug.
   194	                for r in refs {
   195	                    match r {
   196	                        SubjectRef::Multi(_) => {
   197	                            return Err(DbError::InvalidArgument(
   198	                                "nested Multi in SubjectRef not supported".to_string(),
   199	                            ))
   200	                        }
   201	                        SubjectRef::Global => {
   202	                            return Err(DbError::InvalidArgument(
   203	                                "Global within Multi not supported".to_string(),
   204	                            ))
   205	                        }
   206	                        _ => {}
   207	                    }
   208	                }
   209	                // Deterministic lock ordering: sort by (entity_type_order, id)
   210	                // before bumping. Dedup so a Multi with the same entity twice
   211	                // bumps that entity once.
   212	                let mut sorted: Vec<&SubjectRef> = refs.iter().collect();
   213	                sorted.sort_by(|a, b| {
   214	                    a.entity_type_order()
   215	                        .cmp(&b.entity_type_order())
   216	                        .then_with(|| a.id_str().cmp(b.id_str()))
   217	                });
   218	                sorted.dedup_by(|a, b| {
   219	                    a.entity_type_order() == b.entity_type_order()
   220	                        && a.id_str() == b.id_str()
   221	                });
   222	                for r in sorted {
   223	                    self.bump_entity_claim_version(r)?;
   224	                }
   225	                Ok(())
   226	            }
   227	            SubjectRef::Global => self.bump_global_claim_epoch(),
   228	        }
   229	    }
   230	}

