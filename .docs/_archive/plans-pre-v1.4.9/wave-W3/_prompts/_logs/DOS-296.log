   615	fn table_exists(conn: &Connection, table_name: &str) -> Result<bool, String> {
   616	    conn.query_row(
   617	        "SELECT EXISTS(
   618	            SELECT 1
   619	            FROM sqlite_master
   620	            WHERE type = 'table' AND name = ?1
   621	        )",
   622	        [table_name],
