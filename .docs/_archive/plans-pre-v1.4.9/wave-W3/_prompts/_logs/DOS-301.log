   232	/// The service itself. Hold as `Arc<DbService>` and share freely.
   233	pub struct DbService {
   234	    writer: PooledConnection,
   235	    readers: Vec<PooledConnection>,
   236	    read_idx: AtomicUsize,
   237	}
   238	
   239	impl DbService {
   240	    /// Open a DbService at the standard path.
   241	    pub async fn open() -> Result<Arc<Self>, DbError> {
   242	        let path = crate::db::ActionDb::db_path_public()?;
   243	        Self::open_at(path).await
   244	    }
   245	
   246	    /// Open a DbService at an explicit path. Encrypted via SQLCipher.
   247	    pub async fn open_at(path: PathBuf) -> Result<Arc<Self>, DbError> {
   248	        let path_for_writer = path.clone();
   249	        let path_for_readers = path.to_string_lossy().to_string();
   250	
   251	        // Build the writer on a blocking thread so filesystem checks,
   252	        // Keychain access, plaintext migration, open, and migrations do not
   253	        // stall the Tokio runtime.
   254	        let (writer, hex_key) = tokio::task::spawn_blocking(move || {
   255	            crate::db::ActionDb::open_encrypted_connection(path_for_writer)
   256	        })
   257	        .await
   258	        .map_err(|e| DbError::Migration(format!("writer spawn join: {e}")))??;
   259	
   260	        let key_for_readers = hex_key.clone();
   261	
   262	        // Readers: no migrations, just pragmas + query_only.
   263	        let mut readers = Vec::with_capacity(NUM_READERS);
   264	        for _ in 0..NUM_READERS {
   265	            let path_clone = path_for_readers.clone();
   266	            let key_clone = key_for_readers.clone();
   267	            let r = tokio::task::spawn_blocking(move || -> Result<Connection, DbError> {
   268	                let conn = Connection::open(&path_clone)?;
   269	                apply_pragmas(&conn, true, &key_clone)?;
   270	                Ok(conn)
   271	            })
   272	            .await
   273	            .map_err(|e| DbError::Migration(format!("reader spawn join: {e}")))??;
   274	            readers.push(PooledConnection::new(r)?);
   275	        }
   276	
   277	        Ok(Arc::new(Self {
   278	            writer: PooledConnection::new(writer)?,
   279	            readers,
   280	            read_idx: AtomicUsize::new(0),
   281	        }))
   282	    }
   283	
   284	    /// Unencrypted variant used only by tests.
   285	    #[cfg(test)]
   286	    pub async fn open_at_unencrypted(path: PathBuf) -> Result<Arc<Self>, DbError> {
