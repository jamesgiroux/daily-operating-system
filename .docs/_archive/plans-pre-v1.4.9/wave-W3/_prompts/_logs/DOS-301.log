     7	fn main() -> ExitCode {
     8	    env_logger::Builder::from_env(env_logger::Env::default().default_filter_or("info"))
     9	        .format_timestamp_millis()
    10	        .init();
    11	
    12	    let args: Vec<String> = std::env::args().skip(1).collect();
    13	    let apply = args.iter().any(|arg| arg == "--apply");
    14	    let opts = match parse_options(&args) {
    15	        Ok(opts) => opts,
    16	        Err(e) => {
    17	            eprintln!("{e}");
    18	            print_usage();
    19	            return ExitCode::from(2);
    20	        }
    21	    };
    22	
    23	    let db = match dailyos_lib::db::ActionDb::open() {
    24	        Ok(db) => db,
    25	        Err(e) => {
    26	            eprintln!("failed to open database: {e}");
    27	            return ExitCode::from(2);
    28	        }
    29	    };
    30	
    31	    let result = if apply {
    32	        apply_repair(&db, &opts)
    33	    } else {
    34	        build_report(&db, &opts)
    35	    };
    36	
    37	    let report = match result {
    38	        Ok(report) => report,
    39	        Err(e) => {
    40	            eprintln!("repair failed: {e}");
    41	            return ExitCode::from(2);
    42	        }
    43	    };
    44	
    45	    println!("{}", report.to_operator_summary());
    46	    if !apply && report.has_changes() {
    47	        println!("mode=dry-run");
    48	        println!("next=run with --apply to write the repair ledger and quarantine these rows");
    49	        return ExitCode::from(1);
    50	    }
    51	
    52	    ExitCode::from(0)
    53	}
    54	
    55	fn parse_options(args: &[String]) -> Result<RepairOptions, String> {
    56	    let mut opts = RepairOptions::default();
    57	    let mut i = 0;
    58	    while i < args.len() {
    59	        match args[i].as_str() {
    60	            "--apply" => {
    61	                i += 1;
    62	            }
    63	            "--dry-run" => {
    64	                i += 1;
    65	            }
    66	            "--min-batch" => {
    67	                i += 1;
    68	                let Some(value) = args.get(i) else {
    69	                    return Err("--min-batch requires a value".to_string());
    70	                };
    71	                opts.min_batch_size = value
    72	                    .parse()
    73	                    .map_err(|_| "--min-batch must be an integer".to_string())?;
    74	                i += 1;
    75	            }
    76	            "--min-coattendees" => {
    77	                i += 1;
    78	                let Some(value) = args.get(i) else {
    79	                    return Err("--min-coattendees requires a value".to_string());
    80	                };
    81	                opts.min_coattendees = value
    82	                    .parse()
    83	                    .map_err(|_| "--min-coattendees must be an integer".to_string())?;
    84	                i += 1;
    85	            }
    86	            "--help" | "-h" => {
    87	                print_usage();
    88	                std::process::exit(0);
    89	            }
    90	            other => return Err(format!("unknown argument: {other}")),
    91	        }
    92	    }
    93	    opts.validate()?;
    94	    Ok(opts)
    95	}
    96	
    97	fn print_usage() {
    98	    eprintln!(
    99	        "usage: repair_entity_linking [--dry-run] [--apply] [--min-batch N] [--min-coattendees N]"
   100	    );
   101	}

