     1	#!/usr/bin/env bash
     2	# DOS-311: enforce universal write fence — production callers of
     3	# `write_intelligence_json` should route through
     4	# `crate::intelligence::write_fence::fenced_write_intelligence_json`.
     5	#
     6	# This lint is intentionally narrow for W1 ship: it warns about NEW direct
     7	# `write_intelligence_json(` call sites added outside the allowlist, but
     8	# does NOT yet require migrating the W0 post-commit warn-log paths in
     9	# `services/intelligence.rs` to the fence (those are the natural fence
    10	# integration points; W3 cleanup migrates them alongside DOS-7's cutover).
    11	#
    12	# Allowlist:
    13	#   - intelligence/write_fence.rs   — the fence module's own internal use
    14	#   - intelligence/io.rs            — the canonical implementation
    15	#   - tests, fixtures, examples
    16	#   - services/intelligence.rs      — W0 post-commit cache writes (transitional;
    17	#                                     migrated in W3 alongside DOS-7)
    18	#   - intel_queue.rs                — the queue worker's final write
    19	#                                     (transitional; migrated in W3)
    20	#
    21	# After W3, the allowlist for `services/intelligence.rs` and `intel_queue.rs`
    22	# is removed.
    23	
    24	set -euo pipefail
    25	ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    26	
    27	PATTERN='\bwrite_intelligence_json[[:space:]]*\('
    28	
    29	violations=0
    30	check_line() {
    31	  local line="$1"
    32	  # Path-based allowlist
    33	  case "$line" in
    34	    "$ROOT_DIR/src-tauri/src/intelligence/write_fence.rs"*) return 0 ;;
    35	    "$ROOT_DIR/src-tauri/src/intelligence/io.rs"*) return 0 ;;
    36	    "$ROOT_DIR/src-tauri/tests/"*) return 0 ;;
    37	    "$ROOT_DIR/.docs/"*) return 0 ;;
    38	    "$ROOT_DIR/scripts/"*) return 0 ;;
    39	  esac
    40	
    41	  # Inline marker exemption: a `// fence-exempt: <reason>` comment within 3
    42	  # lines above the call deliberately bypasses the fence (test cleanup,
    43	  # imports, etc.).
    44	  local file_part="${line%%:*}"
    45	  local rest="${line#*:}"
    46	  local lineno="${rest%%:*}"
    47	  if [ -n "$lineno" ] && [ -f "$file_part" ]; then
    48	    local start=$((lineno - 3))
    49	    [ "$start" -lt 1 ] && start=1
    50	    if sed -n "${start},${lineno}p" "$file_part" 2>/dev/null \
    51	        | grep -q "fence-exempt:"; then
    52	      return 0
    53	    fi
    54	  fi
    55	
    56	  echo "$line"
    57	  violations=$((violations + 1))
    58	}
    59	
    60	# Direct write_intelligence_json calls (the function-level guard).
    61	while IFS= read -r line; do
    62	  check_line "$line"
    63	done < <(grep -rEn "$PATTERN" "$ROOT_DIR/src-tauri/src/" 2>/dev/null || true)
    64	
    65	# DOS-311 follow-up: also catch any atomic_write_str call whose path
    66	# argument references intelligence.json. The W1 audit found no such
    67	# bypass today; this guard prevents future regressions where a caller
    68	# constructs an intelligence.json path manually and writes it raw.
    69	ATOMIC_PATTERN='atomic_write_str[[:space:]]*\([^)]*intelligence(\.json|/io|_json|"[[:space:]]*[,)])'
    70	while IFS= read -r line; do
