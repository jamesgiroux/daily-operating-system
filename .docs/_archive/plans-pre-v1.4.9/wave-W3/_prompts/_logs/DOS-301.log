   535	        merge_user_confirmed_values(&mut intel, &existing);
   536	    }
   537	    db.with_transaction(|tx| {
   538	        tx.upsert_entity_intelligence(&intel)
   539	            .map_err(|e| e.to_string())?;
   540	        crate::services::signals::emit_and_propagate(
   541	            ctx,
   542	            tx,
   543	            engine,
   544	            entity_type,
   545	            entity_id,
   546	            "entity_intelligence_updated",
   547	            "ai_enrichment",
   548	            None,
   549	            0.8,
   550	        )
   551	        .map_err(|e| format!("signal emit failed: {e}"))?;
