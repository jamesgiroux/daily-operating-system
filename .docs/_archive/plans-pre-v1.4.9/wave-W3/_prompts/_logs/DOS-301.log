   288	            if !parent.exists() {
   289	                std::fs::create_dir_all(parent).map_err(DbError::CreateDir)?;
   290	            }
   291	        }
   292	        let path_str = path.to_string_lossy().to_string();
   293	        let path_for_readers = path_str.clone();
   294	
   295	        let writer = tokio::task::spawn_blocking(move || -> Result<Connection, DbError> {
   296	            let conn = Connection::open(&path_str)?;
   297	            conn.execute_batch("PRAGMA journal_mode = WAL;")?;
   298	            conn.execute_batch("PRAGMA busy_timeout = 5000;")?;
   299	            conn.execute_batch("PRAGMA synchronous = NORMAL;")?;
   300	            conn.execute_batch("PRAGMA foreign_keys = ON;")?;
   301	            crate::migrations::run_migrations(&conn).map_err(DbError::Migration)?;
   302	            Ok(conn)
   303	        })
   304	        .await
   305	        .map_err(|e| DbError::Migration(format!("writer spawn join: {e}")))??;
   306	
   307	        let mut readers = Vec::with_capacity(NUM_READERS);
   308	        for _ in 0..NUM_READERS {
   309	            let path_clone = path_for_readers.clone();
   310	            let r = tokio::task::spawn_blocking(move || -> Result<Connection, DbError> {
   311	                let conn = Connection::open(&path_clone)?;
   312	                conn.execute_batch("PRAGMA journal_mode = WAL;")?;
   313	                conn.execute_batch("PRAGMA busy_timeout = 5000;")?;
   314	                conn.execute_batch("PRAGMA synchronous = NORMAL;")?;
   315	                conn.execute_batch("PRAGMA foreign_keys = ON;")?;
   316	                conn.execute_batch("PRAGMA query_only = ON;")?;
   317	                Ok(conn)
   318	            })
   319	            .await
   320	            .map_err(|e| DbError::Migration(format!("reader spawn join: {e}")))??;
   321	            readers.push(PooledConnection::new(r)?);
   322	        }
   323	
   324	        Ok(Arc::new(Self {
   325	            writer: PooledConnection::new(writer)?,
   326	            readers,
   327	            read_idx: AtomicUsize::new(0),
   328	        }))
   329	    }
