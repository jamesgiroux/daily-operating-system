   331	    /// Open a fresh encrypted connection through the writer thread so SQLCipher
   332	    /// verification executes in series with WAL writes.
   333	    pub fn open_fresh_serialized(
   334	        &self,
   335	        path: PathBuf,
   336	        hex_key: String,
   337	    ) -> Result<Connection, DbError> {
   338	        let path = path.to_string_lossy().to_string();
   339	        let result = self.writer.call_sync(move |_| open_encrypted_fresh(&path, &hex_key, false));
   340	        match result {
   341	            Ok(conn) => Ok(conn),
   342	            Err(PooledCallError::Rusqlite(error)) => Err(DbError::Sqlite(error)),
   343	            Err(PooledCallError::Closed) => {
   344	                Err(DbError::Migration("pooled writer thread not available".to_string()))
   345	            }
   346	            Err(PooledCallError::Panic(message)) => {
   347	                Err(DbError::Migration(format!("open_fresh_serialized panic: {message}")))
   348	            }
   349	            Err(PooledCallError::TypeMismatch) => {
   350	                Err(DbError::Migration(
   351	                    "open_fresh_serialized result type mismatch".to_string(),
   352	                ))
   353	            }
   354	        }
   355	    }
   356	
   357	    /// Writer connection. Serialized: one write at a time.
   358	    pub fn writer(&self) -> &PooledConnection {
   359	        &self.writer
   360	    }
   361	
   362	    /// Reader connection, round-robin. Concurrent reads under WAL.
   363	    pub fn reader(&self) -> &PooledConnection {
   364	        let idx = self.read_idx.fetch_add(1, Ordering::Relaxed) % self.readers.len();
   365	        &self.readers[idx]
   366	    }
   367	}
