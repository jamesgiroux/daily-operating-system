    37	type CallResult = Result<Box<dyn Any + Send>, PooledCallError>;
    38	type WorkerTask =
    39	    Box<dyn FnOnce(&mut Connection) -> rusqlite::Result<Box<dyn Any + Send>> + Send + 'static>;
    40	
    41	enum CallMessage {
    42	    Async {
    43	        task: WorkerTask,
