   106	    fn new(conn: Connection) -> Result<Self, DbError> {
   107	        let (sender, receiver) = mpsc::channel();
   108	        let handle = thread::Builder::new()
   109	            .name("dailyos-db-connection".to_string())
   110	            .spawn(move || {
   111	                let mut conn = conn;
   112	                while let Ok(message) = receiver.recv() {
   113	                    match message {
   114	                        CallMessage::Async { task, respond_to } => {
   115	                            let _ = respond_to.send(run_task(task, &mut conn));
   116	                        }
   117	                        CallMessage::Sync { task, respond_to } => {
   118	                            let _ = respond_to.send(run_task(task, &mut conn));
   119	                        }
   120	                        CallMessage::Shutdown => {
   121	                            break;
   122	                        }
   123	                    }
   124	                }
   125	            })
   126	            .map_err(|e| DbError::Migration(format!("failed to start DB worker thread: {e}")))?;
   127	
   128	        Ok(Self {
   129	            inner: Arc::new(PooledConnectionInner {
   130	                sender,
   131	                handle: StdMutex::new(Some(handle)),
   132	            }),
   133	        })
   134	    }
   135	
   136	    fn split_payload<T: Send + 'static>(
   137	        payload: CallResult,
   138	    ) -> Result<T, PooledCallError> {
   139	        let payload = payload?;
   140	        payload
   141	            .downcast::<T>()
   142	            .map(|value| *value)
   143	            .map_err(|_| PooledCallError::TypeMismatch)
   144	    }
   145	
   146	    /// Async call — submits closure to the dedicated thread.
   147	    pub async fn call<F, T>(&self, f: F) -> Result<T, PooledCallError>
   148	    where
   149	        F: FnOnce(&mut Connection) -> rusqlite::Result<T> + Send + 'static,
   150	        T: Send + 'static,
   151	    {
   152	        let (tx, rx) = oneshot::channel();
   153	        let task: WorkerTask = Box::new(move |conn| f(conn).map(|value| Box::new(value) as Box<_>));
   154	        self.inner
   155	            .sender
   156	            .send(CallMessage::Async {
   157	                task,
   158	                respond_to: tx,
   159	            })
   160	            .map_err(|_| PooledCallError::Closed)?;
   161	        Self::split_payload(rx.await.map_err(|_| PooledCallError::Closed)?)
   162	    }
   163	
   164	    /// Sync call — submits closure to the dedicated thread and blocks on the
   165	    /// response channel. Intended for sync startup/background paths.
   166	    pub fn call_sync<F, T>(&self, f: F) -> Result<T, PooledCallError>
   167	    where
   168	        F: FnOnce(&mut Connection) -> rusqlite::Result<T> + Send + 'static,
   169	        T: Send + 'static,
   170	    {
   171	        let (tx, rx) = mpsc::channel();
   172	        let task: WorkerTask = Box::new(move |conn| f(conn).map(|value| Box::new(value) as Box<_>));
   173	        self.inner
   174	            .sender
   175	            .send(CallMessage::Sync {
   176	                task,
   177	                respond_to: tx,
   178	            })
   179	            .map_err(|_| PooledCallError::Closed)?;
   180	        Self::split_payload(rx.recv().map_err(|_| PooledCallError::Closed)?)
   181	    }
   182	
   183	    pub(crate) fn shutdown(&self) {
   184	        self.inner.shutdown();
   185	    }
   186	}
