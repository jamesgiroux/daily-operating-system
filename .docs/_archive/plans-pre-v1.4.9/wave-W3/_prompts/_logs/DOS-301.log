   554	
   555	    // DOS-14: After enrichment, reconcile AI objectives with user objectives
   556	    if entity_type == "account" {
   557	        if let Err(e) = crate::services::success_plans::reconcile_objectives(ctx, db, entity_id) {
   558	            log::warn!("Objective reconciliation failed for {entity_id}: {e}");
   559	        }
   560	    }
   561	
   562	    // DOS Work-tab: Best-effort bridge of AI-inferred commitments → Actions.
   563	    // Enrichment write is the source of truth; bridge errors must not fail it.
   564	    if entity_type == "account" {
   565	        if let Some(ref commitments) = intel.open_commitments {
   566	            match crate::services::commitment_bridge::sync_ai_commitments(
   567	            ctx,
   568	                db,
   569	                entity_type,
   570	                entity_id,
   571	                commitments,
   572	            ) {
   573	                Ok(summary) => log::info!(
   574	                    "commitment_bridge: {} created, {} updated, {} tombstoned-skip, {} missing-id ({}:{})",
   575	                    summary.created,
   576	                    summary.updated,
   577	                    summary.skipped_tombstoned,
   578	                    summary.skipped_missing_id,
   579	                    entity_type,
   580	                    entity_id
   581	                ),
   582	                Err(e) => log::warn!(
   583	                    "commitment_bridge sync failed for {entity_type}:{entity_id} (non-fatal): {e}"
   584	                ),
   585	            }
   586	        }
   587	    }
   588	
   589	    Ok(())
   590	}
