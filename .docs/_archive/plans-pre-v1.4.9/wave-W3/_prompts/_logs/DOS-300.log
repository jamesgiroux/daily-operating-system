   895	/// Read entity intelligence from DB (I513) and inject relevant
   896	/// fields into the meeting context for prep enrichment.
   897	fn inject_entity_intelligence(
   898	    db: Option<&crate::db::ActionDb>,
   899	    entity_id: Option<&str>,
   900	    ctx: &mut Value,
   901	) {
   902	    // I513: DB is the sole source for entity intelligence — no file fallback.
   903	    let intel = if let (Some(db), Some(eid)) = (db, entity_id) {
   904	        db.get_entity_intelligence(eid).ok().flatten()
   905	    } else {
   906	        None
   907	    };
   908	    let mut intel = match intel {
   909	        Some(intel) => intel,
   910	        None => return,
   911	    };
   912	
   913	    // I645: Filter stale items from meeting prep context using relevance windows.
   914	    intel.risks.retain(|risk| {
   915	        let sourced = risk.item_source.as_ref().map(|s| s.sourced_at.as_str());
   916	        match sourced {
   917	            Some(ts) => {
   918	                crate::intelligence::timeliness::is_within_relevance_window("active_blocker", ts)
   919	            }
   920	            None => true,
   921	        }
   922	    });
   923	
   924	    if let Some(ref assessment) = intel.executive_assessment {
   925	        ctx["executive_assessment"] = json!(assessment);
   926	    }
   927	
   928	    if !intel.risks.is_empty() {
   929	        ctx["entity_risks"] = json!(intel
   930	            .risks
   931	            .iter()
   932	            .map(|r| {
   933	                json!({
   934	                    "text": r.text,
   935	                    "urgency": r.urgency,
   936	                    "source": r.source,
   937	                })
   938	            })
   939	            .collect::<Vec<_>>());
   940	    }
   941	
   942	    if let Some(ref readiness) = intel.next_meeting_readiness {
   943	        if !readiness.prep_items.is_empty() {
   944	            ctx["entity_readiness"] = json!(&readiness.prep_items);
   945	        }
   946	    }
   947	
   948	    // I652: Read stakeholders from DB (person-first architecture) instead of intel JSON.
   949	    if let (Some(db), Some(eid)) = (db, entity_id) {
   950	        let stakeholders = db.get_account_stakeholders_full(eid).unwrap_or_default();
   951	        if !stakeholders.is_empty() {
   952	            ctx["stakeholder_insights"] = json!(stakeholders
   953	                .iter()
   954	                .map(|s| {
   955	                    json!({
   956	                        "name": s.person_name,
   957	                        "role": s.stakeholder_role,
   958	                        "assessment": s.assessment,
   959	                        "engagement": s.engagement,
   960	                    })
   961	                })
   962	                .collect::<Vec<_>>());
   963	        }
   964	    }
   965	
   966	    if let Some(status) = intel.consistency_status.as_ref() {
   967	        ctx["consistency_status"] = json!(status);
   968	    }
   969	    if !intel.consistency_findings.is_empty() {
   970	        ctx["consistency_findings"] = json!(intel.consistency_findings);
   971	    }
   972	
   973	    // I651: Product classification from Glean
   974	    if let Some(ref classification) = intel.product_classification {
   975	        if !classification.products.is_empty() {
   976	            ctx["products"] = json!(classification.products);
   977	        }
   978	    }
   979	
   980	    // DOS-12: Include persisted value delivered in meeting prep context
   981	    if !intel.value_delivered.is_empty() {
   982	        ctx["value_delivered"] = json!(intel
   983	            .value_delivered
   984	            .iter()
   985	            .map(|v| {
   986	                json!({
   987	                    "statement": v.statement,
   988	                    "date": v.date,
   989	                    "impact": v.impact,
   990	                    "confirmed": v.item_source.as_ref().is_some_and(|s| s.source == "user_correction"),
   991	                })
   992	            })
   993	            .collect::<Vec<_>>());
   994	    }
   995	}
