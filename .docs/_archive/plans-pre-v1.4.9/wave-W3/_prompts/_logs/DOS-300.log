   122	/// Update an existing entity context entry.
   123	pub async fn update_entry(
   124	    ctx: &crate::services::context::ServiceContext<'_>,
   125	    id: &str,
   126	    title: &str,
   127	    content: &str,
   128	    state: &AppState,
   129	) -> Result<(), String> {
   130	    ctx.check_mutation_allowed().map_err(|e| e.to_string())?;
   131	    // Regenerate embedding before acquiring DB lock
   132	    let embedding_blob =
   133	        super::user_entity::embed_context_text(&state.embedding_model, title, content);
   134	
   135	    let id = id.to_string();
   136	    let title = title.to_string();
   137	    let content = content.to_string();
   138	    let engine = std::sync::Arc::clone(&state.signals.engine);
   139	    state
   140	        .db_write(move |db| {
   141	            // Look up entity_type/entity_id for signal emission
   142	            let (entity_type, entity_id): (String, String) = db
   143	                .conn_ref()
   144	                .query_row(
   145	                    "SELECT entity_type, entity_id FROM entity_context_entries WHERE id = ?1",
   146	                    rusqlite::params![id],
   147	                    |row| Ok((row.get(0)?, row.get(1)?)),
   148	                )
   149	                .map_err(|e| format!("Entity context entry not found: {}", e))?;
   150	
   151	            let updated = db
   152	                .conn_ref()
   153	                .execute(
   154	                    "UPDATE entity_context_entries
   155	                 SET title = ?1, content = ?2, embedding = ?4, updated_at = CURRENT_TIMESTAMP
   156	                 WHERE id = ?3",
   157	                    rusqlite::params![title, content, id, embedding_blob],
   158	                )
   159	                .map_err(|e| format!("Failed to update entity context entry: {}", e))?;
   160	
   161	            if updated == 0 {
   162	                return Err(format!("Entity context entry not found: {}", id));
   163	            }
   164	
   165	            let clock = crate::services::context::SystemClock;
   166	            let rng = crate::services::context::SystemRng;
   167	            let ext = crate::services::context::ExternalClients::default();
   168	            let ctx = crate::services::context::ServiceContext::new_live(&clock, &rng, &ext);
   169	            let _ = crate::services::signals::emit_and_propagate(
   170	                &ctx,
   171	                db,
   172	                &engine,
   173	                &entity_type,
   174	                &entity_id,
   175	                "context_entry_updated",
   176	                "user_entry",
   177	                Some(&title),
   178	                0.85,
   179	            );
   180	
   181	            Ok(())
   182	        })
   183	        .await
   184	}
