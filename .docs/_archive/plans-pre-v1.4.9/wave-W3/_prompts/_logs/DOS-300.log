   222	            let ctx = crate::services::context::ServiceContext::new_live(&clock, &rng, &ext);
   223	            let _ = crate::services::signals::emit_and_propagate(
   224	                &ctx,
   225	                db,
   226	                &engine,
   227	                &entity_type,
   228	                &entity_id,
   229	                "context_entry_deleted",
   230	                "user_entry",
   231	                None,
   232	                0.85,
   233	            );
   234	
   235	            Ok(())
