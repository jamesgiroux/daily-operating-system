   997	/// I425: Inject active Linear issues linked to this entity via linear_entity_links.
   998	fn inject_linear_issues(db: &crate::db::ActionDb, entity_id: &str, ctx: &mut Value) {
   999	    let issues: Vec<Value> = (|| {
  1000	        let conn = db.conn_ref();
  1001	        let mut stmt = conn
  1002	            .prepare(
  1003	                "SELECT li.identifier, li.title, li.state_name, li.priority_label, li.due_date
  1004	             FROM linear_issues li
  1005	             JOIN linear_entity_links lel ON lel.linear_project_id = li.project_id
  1006	             WHERE lel.entity_id = ?1 AND li.state_type NOT IN ('completed', 'cancelled')
  1007	             ORDER BY li.priority ASC, li.due_date ASC
  1008	             LIMIT 10",
  1009	            )
  1010	            .ok()?;
  1011	        let rows = stmt
  1012	            .query_map([entity_id], |row| {
  1013	                Ok(json!({
  1014	                    "identifier": row.get::<_, Option<String>>(0)?,
  1015	                    "title": row.get::<_, Option<String>>(1)?,
  1016	                    "state": row.get::<_, Option<String>>(2)?,
  1017	                    "priority": row.get::<_, Option<String>>(3)?,
  1018	                    "due_date": row.get::<_, Option<String>>(4)?,
  1019	                }))
  1020	            })

