   112	pub(crate) fn parse_meeting_datetime(value: &str) -> Option<chrono::DateTime<chrono::Utc>> {
   113	    if value.trim().is_empty() {
   114	        return None;
   115	    }
   116	    if let Ok(dt) = chrono::DateTime::parse_from_rfc3339(value) {
   117	        return Some(dt.with_timezone(&chrono::Utc));
   118	    }
   119	    for fmt in ["%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%d %I:%M %p"] {
   120	        if let Ok(ndt) = chrono::NaiveDateTime::parse_from_str(value, fmt) {
   121	            if let Some(local_dt) = chrono::Local.from_local_datetime(&ndt).single() {
   122	                return Some(local_dt.with_timezone(&chrono::Utc));
   123	            }
   124	            return Some(chrono::Utc.from_utc_datetime(&ndt));
   125	        }
   126	    }
   127	    None
   128	}
