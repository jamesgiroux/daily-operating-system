     1	//! Entity context entries CRUD service.
     2	//!
     3	//! Structured knowledge entries for accounts, people, and projects.
     4	//! Mirrors user_context_entries but scoped to an entity_type + entity_id pair.
     5	
     6	use crate::state::AppState;
     7	use crate::types::EntityContextEntry;
     8	
     9	/// Get all context entries for an entity.
    10	pub async fn get_entries(
    11	    entity_type: &str,
    12	    entity_id: &str,
    13	    state: &AppState,
    14	) -> Result<Vec<EntityContextEntry>, String> {
    15	    let entity_type = entity_type.to_string();
    16	    let entity_id = entity_id.to_string();
    17	    state
    18	        .db_read(move |db| {
    19	            let conn = db.conn_ref();
    20	            let mut stmt = conn
    21	                .prepare(
    22	                    "SELECT id, entity_type, entity_id, title, content, created_at, updated_at
    23	                 FROM entity_context_entries
    24	                 WHERE entity_type = ?1 AND entity_id = ?2
    25	                 ORDER BY created_at DESC",
    26	                )
    27	                .map_err(|e| format!("Failed to prepare query: {}", e))?;
    28	
    29	            let entries = stmt
    30	                .query_map(rusqlite::params![entity_type, entity_id], |row| {
    31	                    Ok(EntityContextEntry {
    32	                        id: row.get("id")?,
    33	                        entity_type: row.get("entity_type")?,
    34	                        entity_id: row.get("entity_id")?,
    35	                        title: row.get("title")?,
    36	                        content: row.get("content")?,
    37	                        created_at: row.get("created_at")?,
    38	                        updated_at: row.get("updated_at")?,
    39	                    })
    40	                })
    41	                .map_err(|e| format!("Failed to query entity context entries: {}", e))?
    42	                .collect::<Result<Vec<_>, _>>()
    43	                .map_err(|e| format!("Failed to map entity context entries: {}", e))?;
    44	
    45	            Ok(entries)
    46	        })
    47	        .await
    48	}
