    50	/// Create a new entity context entry with embedding.
    51	pub async fn create_entry(
    52	    ctx: &crate::services::context::ServiceContext<'_>,
    53	    entity_type: &str,
    54	    entity_id: &str,
    55	    title: &str,
    56	    content: &str,
    57	    state: &AppState,
    58	) -> Result<EntityContextEntry, String> {
    59	    ctx.check_mutation_allowed().map_err(|e| e.to_string())?;
    60	    let id = uuid::Uuid::new_v4().to_string();
    61	
    62	    // Generate embedding before acquiring DB lock
    63	    let embedding_blob =
    64	        super::user_entity::embed_context_text(&state.embedding_model, title, content);
    65	
    66	    let entity_type = entity_type.to_string();
    67	    let entity_id = entity_id.to_string();
    68	    let title = title.to_string();
    69	    let content = content.to_string();
    70	    let engine = std::sync::Arc::clone(&state.signals.engine);
    71	    state
    72	        .db_write(move |db| {
    73	            db.conn_ref()
    74	                .execute(
    75	                    "INSERT INTO entity_context_entries (id, entity_type, entity_id, title, content, embedding)
    76	                 VALUES (?1, ?2, ?3, ?4, ?5, ?6)",
    77	                    rusqlite::params![id, entity_type, entity_id, title, content, embedding_blob],
    78	                )
    79	                .map_err(|e| format!("Failed to create entity context entry: {}", e))?;
    80	
    81	            let clock = crate::services::context::SystemClock;
    82	            let rng = crate::services::context::SystemRng;
    83	            let ext = crate::services::context::ExternalClients::default();
    84	            let ctx = crate::services::context::ServiceContext::new_live(&clock, &rng, &ext);
    85	            let _ = crate::services::signals::emit_and_propagate(
    86	                &ctx,
    87	                db,
    88	                &engine,
    89	                &entity_type,
    90	                &entity_id,
    91	                "context_entry_added",
    92	                "user_entry",
    93	                Some(&title),
    94	                0.85,
    95	            );
    96	
    97	            let entry = db
    98	                .conn_ref()
    99	                .query_row(
   100	                    "SELECT id, entity_type, entity_id, title, content, created_at, updated_at
   101	                 FROM entity_context_entries WHERE id = ?1",
   102	                    rusqlite::params![id],
   103	                    |row| {
   104	                        Ok(EntityContextEntry {
   105	                            id: row.get("id")?,
   106	                            entity_type: row.get("entity_type")?,
   107	                            entity_id: row.get("entity_id")?,
   108	                            title: row.get("title")?,
   109	                            content: row.get("content")?,
   110	                            created_at: row.get("created_at")?,
   111	                            updated_at: row.get("updated_at")?,
   112	                        })
   113	                    },
   114	                )
   115	                .map_err(|e| format!("Failed to read created entity context entry: {}", e))?;
   116	
   117	            Ok(entry)
   118	        })
   119	        .await
   120	}
